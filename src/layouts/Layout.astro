---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RECOVERY // TERMINAL RUNTIME — Live Algorithmic Audio Player',
  description = 'Terminal de compilación de audio algorítmico y reproducción en vivo para el álbum conceptual RECOVERY. Síntesis en tiempo real vía Strudel y Web Audio.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06090e" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
