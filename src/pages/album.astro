---
import Layout from '../layouts/Layout.astro';
import StrudelPlayer from '../components/StrudelPlayer.astro';
import { TRACKS } from '../data/tracks';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Secuencia del Álbum — RECOVERY"
  description="Secuencia curada y estado de los cortes del álbum RECOVERY. Selección deliberada, estados de aprobación y reproducción algorítmica."
>
  <div class="container">
    <header class="page-header">
      <span class="badge">DISCOGRAFÍA & SECUENCIA</span>
      <h1 class="page-title">Álbum — RECOVERY</h1>
      <p class="page-desc">
        Catálogo deliberado de composiciones aprobadas y candidatas. Cada corte representa un punto
        de corte en la investigación sonora entre lo orgánico, lo mediado y la bifurcación temporal.
      </p>
    </header>

    <div class="tracklist">
      {TRACKS.map((track) => (
        <article class="track-card panel" id={`track-${track.id}`}>
          <div class="track-meta-header">
            <div class="track-number-title">
              <span class="track-num">{String(track.number).padStart(2, '0')}.</span>
              <h2 class="track-title">{track.title}</h2>
            </div>
            <div class="track-badges">
              <span class="badge badge-warning">ESTADO: {track.status.toUpperCase()}</span>
              <span class="badge">MEDIO: {track.medium}</span>
              <span class="badge">DURACIÓN REF: {track.duration}</span>
              <span class="badge badge-success">APROBACIÓN: {track.humanApproval.signoff}</span>
            </div>
          </div>

          <p class="track-summary">{track.summary}</p>

          <div class="track-notes-box">
            <h4 class="notes-heading">NOTAS PÚBLICAS DE CONTEXTO:</h4>
            <ul>
              {track.publicNotes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>

          <div class="player-wrapper">
            <StrudelPlayer trackTitle={track.title} variations={track.variations} />
          </div>

          <div class="track-footer-meta">
            <span>Firma de aprobación: {track.humanApproval.signoff} ({track.humanApproval.date})</span>
            <a href={`${baseUrl}/lab`} class="lab-link">Comparar variaciones en el Laboratorio →</a>
          </div>
        </article>
      ))}

      <!-- Placeholder for future sequenced tracks without inventing lore -->
      <div class="placeholder-track panel">
        <div class="track-meta-header">
          <div class="track-number-title">
            <span class="track-num text-muted">02.</span>
            <h3 class="track-title text-muted">[Siguiente corte en fase de bocetación]</h3>
          </div>
          <span class="badge">ESTADO: PENDIENTE DE APROBACIÓN HUMANA</span>
        </div>
        <p class="text-muted">
          Los cortes adicionales se incorporan al árbol público únicamente tras la validación
          y el consentimiento explícito del creador humano a través del Publication Gate.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    font-family: var(--font-mono);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .page-desc {
    color: var(--text-muted);
    max-width: 700px;
  }

  .tracklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .track-card {
    padding: var(--space-xl);
  }

  .track-meta-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .track-number-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .track-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  .track-title {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .track-badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .track-summary {
    font-size: 1.05rem;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .track-notes-box {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: var(--space-md);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-lg);
  }

  .notes-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .track-notes-box ul {
    list-style: square inside;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .player-wrapper {
    margin-bottom: var(--space-md);
  }

  .track-footer-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: var(--space-md);
  }

  .placeholder-track {
    opacity: 0.65;
    border-style: dashed;
  }
</style>
