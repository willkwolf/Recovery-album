---
import Layout from '../layouts/Layout.astro';
import StrudelPlayer from '../components/StrudelPlayer.astro';
import { TRACKS } from '../data/tracks';

const backupTrack = TRACKS[0];
---

<Layout
  title="Laboratorio Experimental — RECOVERY"
  description="Laboratorio sonoro de variaciones algorítmicas en Strudel. Comparación técnica de variaciones estructurales sin exposición de prompts privados."
>
  <div class="container">
    <header class="page-header">
      <span class="badge badge-success">ESPACIO EXPERIMENTAL PÚBLICO</span>
      <h1 class="page-title">Laboratorio de Variaciones</h1>
      <p class="page-desc">
        En este entorno se exponen las variaciones sonoras aprobadas derivadas de cada semilla conceptual.
        El objetivo es comparar cómo una misma premisa artística se traduce en estructuras algorítmicas,
        tensiones rítmicas y elecciones tímbricas divergentes.
      </p>
    </header>

    <!-- Boundary statement -->
    <div class="boundary-callout panel">
      <div class="callout-header">
        <span class="mono">🔒 POLÍTICA DE EXPOSICIÓN TÉCNICA</span>
      </div>
      <p>
        Este laboratorio muestra <strong>exclusivamente código algorítmico, parámetros de síntesis y decisiones estructurales</strong>.
        Los prompts originales generadores, reflexiones personales del creador y cuadernos de iteración permanecen en el entorno privado (OpenWiki).
      </p>
    </div>

    <!-- Active Experiment -->
    <section class="experiment-section">
      <div class="experiment-meta">
        <span class="badge">EXPERIMENTO 01</span>
        <h2 class="experiment-title">{backupTrack.title} — 3 Estados de Memoria</h2>
        <p class="text-muted">
          Comparación de tres caminos sonoros generados a partir de la tensión entre recuperación y fuga.
        </p>
      </div>

      <!-- Comparative Table -->
      <div class="table-container panel">
        <h3 class="panel-title">Tabla Comparativa de Variaciones</h3>
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Variación</th>
              <th>Concepto</th>
              <th>Eje de Tensión</th>
              <th>BPM</th>
              <th>Enfoque Técnico</th>
            </tr>
          </thead>
          <tbody>
            {backupTrack.variations.map((v) => (
              <tr>
                <td class="mono font-bold">{v.name}</td>
                <td>{v.concept}</td>
                <td class="mono">{v.tension}</td>
                <td class="mono">{v.bpm}</td>
                <td>{v.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Live Interactive Comparison Player -->
      <div class="lab-player">
        <h3 class="panel-title">Audición e Inspección de Código en Vivo</h3>
        <StrudelPlayer trackTitle={backupTrack.title} variations={backupTrack.variations} />
      </div>

      <!-- Technical Rationale per Variation -->
      <div class="variations-breakdown-grid">
        {backupTrack.variations.map((v) => (
          <div class="panel var-card">
            <div class="panel-title">
              <span class="mono">{v.name}</span>
              <span class="badge">{v.bpm} BPM</span>
            </div>
            <div class="var-concept-tag">{v.concept}</div>
            <p class="var-card-desc">{v.description}</p>
            <div class="code-preview">
              <pre><code>{v.code}</code></pre>
            </div>
            <div class="var-card-footer">
              <a
                href={`https://strudel.cc/#${encodeURIComponent(v.code)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm"
              >
                Audicionar en Strudel REPL ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    font-family: var(--font-mono);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .page-desc {
    color: var(--text-muted);
    max-width: 750px;
  }

  .boundary-callout {
    border-left: 3px solid var(--accent);
    background: var(--bg-subtle);
    margin-bottom: var(--space-xl);
  }

  .callout-header {
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
    color: var(--accent);
  }

  .boundary-callout p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .experiment-section {
    margin-bottom: var(--space-2xl);
  }

  .experiment-meta {
    margin-bottom: var(--space-lg);
  }

  .experiment-title {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    margin-top: var(--space-xs);
  }

  .table-container {
    overflow-x: auto;
    margin-bottom: var(--space-xl);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .comparison-table th {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  .comparison-table td {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .lab-player {
    margin-bottom: var(--space-2xl);
  }

  .variations-breakdown-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .var-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .var-concept-tag {
    font-size: 0.85rem;
    color: var(--accent);
    font-family: var(--font-mono);
    margin-bottom: var(--space-sm);
  }

  .var-card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .code-preview {
    margin-bottom: var(--space-md);
    max-height: 200px;
    overflow-y: auto;
  }

  .code-preview pre {
    font-size: 0.78rem;
    padding: var(--space-sm);
    margin: 0;
  }

  .var-card-footer {
    border-top: 1px solid var(--border);
    padding-top: var(--space-sm);
  }
</style>
