---
import Layout from '../layouts/Layout.astro';
import { SONG_SECTIONS, TRACK_VARIATIONS } from '../data/tracks';

const sections = SONG_SECTIONS;
const variations = TRACK_VARIATIONS;
---

<Layout
  title="RECOVERY // Single 01: Backup — Audio Preview & HITL Lab"
  description="Mesa de audición minimalista y laboratorio de ciclo de vida HITL (:Experimentacion, :Mutacion, :Challenger, :Victory)."
>
  <div class="studio-container">
    <!-- Header -->
    <header class="studio-header">
      <div class="studio-title-group">
        <h1 class="studio-title">RECOVERY</h1>
        <span class="studio-tag">SINGLE 01 // BACKUP</span>
      </div>
      <a
        href="https://github.com/willkwolf/Recovery-album"
        target="_blank"
        rel="noopener noreferrer"
        class="studio-repo-link"
      >
        GitHub ↗
      </a>
    </header>

    <!-- Lifecycle State Bar (HITL Memory & Genealogía) -->
    <div class="lifecycle-bar">
      <span class="mono label-muted">LINEA DE TIEMPO / ESTADO:</span>
      <div class="lifecycle-nav">
        <button type="button" class="btn btn-sm btn-active" id="tab-mutacion" data-mode="mutacion">
          <span class="status-indicator ind-mutacion"></span>
          <span>:Mutacion (Base Fork C)</span>
        </button>
        <button type="button" class="btn btn-sm" id="tab-challenger" data-mode="challenger">
          <span class="status-indicator ind-challenger"></span>
          <span>:Challenger (Suite Trojan 05:15)</span>
        </button>
        <button type="button" class="btn btn-sm" id="tab-exp" data-mode="exp">
          <span class="status-indicator ind-exp"></span>
          <span>:Experimentacion (Bocetos A/B)</span>
        </button>
      </div>
    </div>

    <!-- Transport & Master Deck -->
    <section class="deck-card">
      <div class="deck-top">
        <div class="transport-controls">
          <button type="button" class="btn btn-primary" id="btn-play" aria-label="Reproducir o pausar">
            <span id="play-icon">▶</span>
            <span id="play-label">Play</span>
          </button>
          <button type="button" class="btn" id="btn-stop" disabled aria-label="Detener">
            <span>■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn" id="btn-loop-sec" aria-label="Alternar bucle de sección">
            <span>🔁</span>
            <span id="loop-label">Loop: Off</span>
          </button>
        </div>

        <div class="deck-meta">
          <div class="time-display mono" id="time-display">00:00 / 01:15</div>
          <div class="active-sec-badge mono" id="active-sec-badge">:Mutacion // Fork Base C</div>
        </div>

        <div class="volume-control">
          <span class="mono label-muted">VOL</span>
          <input type="range" id="vol-slider" min="0" max="1" step="0.05" value="0.8" aria-label="Volumen general" />
          <span id="vol-val" class="mono label-muted">80%</span>
        </div>
      </div>

      <!-- Scrubber & Waveform visualizer -->
      <div class="waveform-container" id="waveform-track" title="Haz clic en cualquier punto para mover el cabezal">
        <canvas id="waveform-canvas" height="60"></canvas>
        <div class="playhead" id="playhead"></div>
      </div>

      <!-- Section blocks (Arranger row for Challenger mode) -->
      <div class="sections-strip" id="challenger-strip" style="display: none;">
        {sections.map((sec, idx) => {
          const widthPct = ((sec.endSec - sec.startSec) / 315) * 100;
          return (
            <button
              type="button"
              class={`section-block ${idx === 0 ? 'selected' : ''}`}
              style={`width: ${widthPct}%;`}
              data-idx={idx}
              data-start={sec.startSec}
              data-end={sec.endSec}
              title={`${sec.name} (${sec.startTime} - ${sec.endTime})`}
            >
              <span class="sec-num mono">0{idx + 1}</span>
              <span class="sec-name">{sec.name.split('(')[0]}</span>
              <span class="sec-range mono">{sec.startTime}</span>
            </button>
          );
        })}
      </div>

      <!-- Single block strip for Mutacion mode -->
      <div class="mutation-strip" id="mutation-strip">
        <div class="mutation-info-bar">
          <span class="mono sec-num">:Mutacion Aprobada</span>
          <span class="sec-name font-medium">Variación C — Fork (ADN Inmutable: Polirritmia 1.75 + Disonancia F# + TR-909)</span>
          <span class="mono sec-range">00:00 ── 01:15 (Loop puro)</span>
        </div>
      </div>
    </section>

    <!-- Section / Variation Drawer (Feedback & Inspection Deck) -->
    <section class="drawer-card">
      <div class="drawer-header">
        <div class="drawer-title-group">
          <span class="mono drawer-tag" id="drawer-tag">:Mutacion // BASE</span>
          <h2 class="drawer-name" id="drawer-name">Variación C — Fork (Base Original)</h2>
          <span class="mono drawer-time" id="drawer-time">00:00 ── 01:15</span>
        </div>
        <button type="button" class="btn btn-sm btn-active" id="btn-copy-ref" title="Copiar referencia para pegar en Antigravity">
          <span>📋</span>
          <span id="copy-ref-text">Copiar ref para Antigravity</span>
        </button>
      </div>

      <div class="drawer-body">
        <div class="drawer-meta-row">
          <div>
            <span class="label-muted mono">ESTADO HITL:</span>
            <span class="mono font-bold" id="drawer-lifecycle">:Mutacion</span>
          </div>
          <div>
            <span class="label-muted mono">TEMPO / TONALIDAD:</span>
            <span class="mono" id="drawer-tempo">110 BPM // C menor (F# persistente)</span>
          </div>
          <div>
            <span class="label-muted mono">ELEMENTOS CLAVE:</span>
            <span id="drawer-inst">Sawtooth Chords LFO, Fast 1.75 Melody, Roland TR-909, Rimshot 5-tuplet, 3v7 Hats</span>
          </div>
        </div>

        <p class="drawer-desc" id="drawer-desc">
          LÍNEA BASE MUTANTE APROBADA. Acordes dyad Sawtooth con filtro LFO, melodía rápida en delay ping-pong, Roland TR-909 y polirritmia hi-hat 3 contra 7. Este es el ADN inmutable sobre el cual se construyen los experimentos.
        </p>

        <!-- Collapsible Strudel Code View -->
        <details class="code-details">
          <summary class="mono code-summary">
            <span>Ver código Strudel</span>
            <a
              id="drawer-repl-link"
              href={`https://strudel.cc/#${encodeURIComponent(variations[0].code)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mono repl-link"
            >
              Abrir en Strudel REPL ↗
            </a>
          </summary>
          <pre class="code-block mono"><code id="drawer-code">{variations[0].code}</code></pre>
        </details>
      </div>
    </section>

    <!-- Footer minimal -->
    <footer class="studio-footer mono">
      <span>RECOVERY // ARTISTIC SYSTEM</span>
      <span>Genealogía HITL: :Experimentacion → :Mutacion → :Challenger → :Victory</span>
    </footer>
  </div>
</Layout>

<script define:vars={{ sections, variations }}>
  // Minimalist Contiguous Audio Player Engine with HITL Lifecycle Navigation
  let currentMode = 'mutacion'; // 'mutacion' | 'challenger' | 'exp'
  let isPlaying = false;
  let isLoopingSection = false;
  let activeSectionIndex = 0;
  let trackSeconds = 0;
  let totalDuration = 75; // Default for Fork :Mutacion (01:15)

  let audioCtx = null;
  let analyser = null;
  let masterGain = null;
  let clockInterval = null;
  let soundTicker = null;
  let delayNode = null;
  let feedbackGain = null;

  // DOM Elements
  const tabMutacion = document.getElementById('tab-mutacion');
  const tabChallenger = document.getElementById('tab-challenger');
  const tabExp = document.getElementById('tab-exp');
  const challengerStrip = document.getElementById('challenger-strip');
  const mutationStrip = document.getElementById('mutation-strip');

  const playBtn = document.getElementById('btn-play');
  const stopBtn = document.getElementById('btn-stop');
  const playIcon = document.getElementById('play-icon');
  const playLabel = document.getElementById('play-label');
  const loopBtn = document.getElementById('btn-loop-sec');
  const loopLabel = document.getElementById('loop-label');
  const timeDisplay = document.getElementById('time-display');
  const activeSecBadge = document.getElementById('active-sec-badge');
  const volSlider = document.getElementById('vol-slider');
  const volVal = document.getElementById('vol-val');
  const waveformTrack = document.getElementById('waveform-track');
  const playhead = document.getElementById('playhead');
  const canvas = document.getElementById('waveform-canvas');
  const canvasCtx = canvas.getContext('2d');
  const sectionBtns = document.querySelectorAll('.section-block');

  // Drawer Elements
  const drawerTag = document.getElementById('drawer-tag');
  const drawerName = document.getElementById('drawer-name');
  const drawerTime = document.getElementById('drawer-time');
  const drawerLifecycle = document.getElementById('drawer-lifecycle');
  const drawerTempo = document.getElementById('drawer-tempo');
  const drawerInst = document.getElementById('drawer-inst');
  const drawerDesc = document.getElementById('drawer-desc');
  const drawerCode = document.getElementById('drawer-code');
  const drawerReplLink = document.getElementById('drawer-repl-link');
  const btnCopyRef = document.getElementById('btn-copy-ref');
  const copyRefText = document.getElementById('copy-ref-text');

  function formatTime(sec) {
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function getAudioContext() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window['webkitAudioContext'];
      audioCtx = new AudioContextClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      masterGain = audioCtx.createGain();
      masterGain.gain.setValueAtTime(parseFloat(volSlider.value), audioCtx.currentTime);
      masterGain.connect(analyser);
      analyser.connect(audioCtx.destination);

      delayNode = audioCtx.createDelay();
      delayNode.delayTime.setValueAtTime(0.333, audioCtx.currentTime);
      feedbackGain = audioCtx.createGain();
      feedbackGain.gain.setValueAtTime(0.55, audioCtx.currentTime);
      const delayFilter = audioCtx.createBiquadFilter();
      delayFilter.type = 'lowpass';
      delayFilter.frequency.setValueAtTime(2500, audioCtx.currentTime);

      delayNode.connect(feedbackGain);
      feedbackGain.connect(delayFilter);
      delayFilter.connect(delayNode);
      delayNode.connect(masterGain);
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function makeDistortionCurve(amount = 50) {
    const k = amount;
    const n_samples = 44100;
    const curve = new Float32Array(n_samples);
    const deg = Math.PI / 180;
    for (let i = 0; i < n_samples; ++i) {
      const x = (i * 2) / n_samples - 1;
      curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
    }
    return curve;
  }

  const distortionCurve = makeDistortionCurve(50);
  const santanaNotes = [587.33, 440.00, 349.23, 523.25, 392.00, 329.63, 466.16, 349.23, 293.66];
  const forkMelodyNotes = [261.63, 311.13, 392.00, 369.99, 466.16, 587.33, 523.25];
  const forkDyads = [
    [65.41, 98.00],   // [C2, G2]
    [77.78, 116.54],  // [Eb2, Bb2]
    [87.31, 130.81],  // [F2, C3]
    [92.50, 130.81]   // [F#2, C3]
  ];

  function triggerForkMelody(ctx, time, freq, vol = 0.38) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.22);
    osc.connect(g);
    g.connect(masterGain);
    if (delayNode) g.connect(delayNode);
    osc.start(time);
    osc.stop(time + 0.25);
  }

  function triggerForkChord(ctx, time, freq1, freq2, filterFreq, dur) {
    [freq1, freq2].forEach((freq) => {
      const osc = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const g = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(freq, time);
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(filterFreq, time);
      filter.Q.value = 5;
      g.gain.setValueAtTime(0.35, time);
      g.gain.exponentialRampToValueAtTime(0.001, time + dur);
      osc.connect(filter);
      filter.connect(g);
      g.connect(masterGain);
      osc.start(time);
      osc.stop(time + dur);
    });
  }

  function triggerKick(ctx, time, startF, endF, vol) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(startF, time);
    osc.frequency.exponentialRampToValueAtTime(endF, time + 0.15);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.18);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + 0.18);
  }

  function triggerNoise(ctx, time, vol, freq, dur) {
    const bufSize = ctx.sampleRate * dur;
    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const f = ctx.createBiquadFilter();
    f.type = 'highpass';
    f.frequency.value = freq;
    const g = ctx.createGain();
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    src.connect(f);
    f.connect(g);
    g.connect(masterGain);
    src.start(time);
    src.stop(time + dur);
  }

  function triggerTriangle(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerSaw(ctx, time, freq, vol, lpf, dur) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(lpf, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerSine(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerSquare(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerGuitar(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const shaper = ctx.createWaveShaper();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    shaper.curve = distortionCurve;
    f.type = 'lowpass';
    f.frequency.setValueAtTime(2600, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(shaper);
    shaper.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerAcid(ctx, time, freq, fFreq, vol, dur) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(fFreq, time);
    f.Q.value = 14;
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function setMode(mode) {
    stopPlayback();
    currentMode = mode;
    trackSeconds = 0;

    tabMutacion.classList.toggle('btn-active', mode === 'mutacion');
    tabChallenger.classList.toggle('btn-active', mode === 'challenger');
    tabExp.classList.toggle('btn-active', mode === 'exp');

    if (mode === 'mutacion') {
      totalDuration = 75; // 01:15
      challengerStrip.style.display = 'none';
      mutationStrip.style.display = 'block';
      activeSecBadge.textContent = ':Mutacion // Fork Base C';
      
      const forkVar = variations.find(v => v.id === 'fork');
      drawerTag.textContent = ':Mutacion // BASE';
      drawerName.textContent = forkVar.name;
      drawerTime.textContent = '00:00 ── 01:15';
      drawerLifecycle.textContent = ':Mutacion (Aprobada)';
      drawerTempo.textContent = `${forkVar.bpm} BPM // C menor (F# persistente)`;
      drawerInst.textContent = 'Sawtooth Chords LFO, Fast 1.75 Melody, Roland TR-909, Rimshot 5-tuplet, 3v7 Hats';
      drawerDesc.textContent = forkVar.description;
      drawerCode.textContent = forkVar.code;
      drawerReplLink.href = `https://strudel.cc/#${encodeURIComponent(forkVar.code)}`;
    } else if (mode === 'challenger') {
      totalDuration = 315; // 05:15
      challengerStrip.style.display = 'flex';
      mutationStrip.style.display = 'none';
      selectSection(0, false);
    } else if (mode === 'exp') {
      totalDuration = 90;
      challengerStrip.style.display = 'none';
      mutationStrip.style.display = 'block';
      activeSecBadge.textContent = ':Experimentacion // Bocetos A & B';
      
      const museoVar = variations.find(v => v.id === 'museo');
      drawerTag.textContent = ':Experimentacion // ARCHIVADA';
      drawerName.textContent = 'Variaciones A & B (Bocetos Iniciales)';
      drawerTime.textContent = '00:00 ── 01:30';
      drawerLifecycle.textContent = ':Experimentacion';
      drawerTempo.textContent = '72 BPM (Museo) / 124 BPM (Tránsito)';
      drawerInst.textContent = 'Sine pads, TR-808, Square leads';
      drawerDesc.textContent = 'Bocetos originales exploratorios archivados tras la selección de Fork como Mutante base.';
      drawerCode.textContent = museoVar.code;
      drawerReplLink.href = `https://strudel.cc/#${encodeURIComponent(museoVar.code)}`;
    }

    updateUI();
  }

  function selectSection(index, seek = false) {
    activeSectionIndex = index;
    const sec = sections[index];

    sectionBtns.forEach((b, i) => {
      b.classList.toggle('selected', i === index);
    });

    if (currentMode === 'challenger') {
      activeSecBadge.textContent = `SEC 0${index + 1}: ${sec.name.split('(')[0].trim()}`;
      drawerTag.textContent = ':Challenger // SUITE';
      drawerName.textContent = sec.name;
      drawerTime.textContent = `${sec.startTime} ── ${sec.endTime}`;
      drawerLifecycle.textContent = ':Challenger (En Disputa)';
      drawerTempo.textContent = `${sec.bpm} BPM // ${sec.keyCenter}`;
      drawerInst.textContent = sec.instruments.join(', ');
      drawerDesc.textContent = sec.description;
      drawerCode.textContent = sec.strudelCode;
      drawerReplLink.href = `https://strudel.cc/#${encodeURIComponent(sec.strudelCode)}`;
    }

    if (seek) {
      seekTo(sec.startSec);
    }
  }

  function seekTo(sec) {
    trackSeconds = Math.max(0, Math.min(sec, totalDuration));
    updateUI();
  }

  function updateUI() {
    timeDisplay.textContent = `${formatTime(trackSeconds)} / ${formatTime(totalDuration)}`;
    const pct = (trackSeconds / totalDuration) * 100;
    playhead.style.left = `${pct}%`;

    if (currentMode === 'challenger') {
      const curIdx = sections.findIndex((s) => trackSeconds >= s.startSec && trackSeconds < s.endSec);
      if (curIdx !== -1 && curIdx !== activeSectionIndex && !isLoopingSection) {
        selectSection(curIdx, false);
      }
    }
  }

  let tickerStep = 0;
  function startPlayback() {
    getAudioContext();
    isPlaying = true;
    playIcon.textContent = '⏸';
    playLabel.textContent = 'Pause';
    stopBtn.disabled = false;

    clockInterval = setInterval(() => {
      trackSeconds += 0.5;

      if (isLoopingSection && currentMode === 'challenger') {
        const curSec = sections[activeSectionIndex];
        if (trackSeconds >= curSec.endSec) {
          trackSeconds = curSec.startSec;
        }
      } else {
        if (trackSeconds >= totalDuration) {
          trackSeconds = 0;
        }
      }
      updateUI();
    }, 500);

    soundTicker = setInterval(() => {
      const ctx = audioCtx;
      if (!ctx) return;
      const time = ctx.currentTime;
      const s = trackSeconds;

      // MODE 1: :MUTACION (FORK C PURO)
      if (currentMode === 'mutacion') {
        const stepInBar = tickerStep % 16;
        const barIdx = Math.floor(tickerStep / 16) % 4;
        const lfoFilterFreq = 1350 + Math.sin(tickerStep * 0.15) * 850;

        if (stepInBar === 0) {
          const dyad = forkDyads[barIdx];
          triggerForkChord(ctx, time, dyad[0], dyad[1], lfoFilterFreq, 2.0);
        }

        if (tickerStep % 2 === 0 || tickerStep % 7 === 3) {
          const mIdx = Math.floor(tickerStep * 1.75) % forkMelodyNotes.length;
          triggerForkMelody(ctx, time, forkMelodyNotes[mIdx], 0.38);
        }

        if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12 || stepInBar === 14) {
          const kickVol = (stepInBar === 0 || stepInBar === 12) ? 0.85 : 0.65;
          triggerKick(ctx, time, 135, 36, kickVol);
        }

        if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 13) {
          triggerNoise(ctx, time, 0.28, 2200, 0.035);
        }

        if (stepInBar % 5 === 0 || stepInBar % 2 === 1) {
          const hatVol = (stepInBar % 4 === 2) ? 0.25 : 0.14;
          triggerNoise(ctx, time, hatVol, 3200, 0.025);
        }
      }

      // MODE 2: :CHALLENGER (TROJAN SANDBOX SUITE)
      else if (currentMode === 'challenger') {
        // Sec 01: Fork Suspense (0:00 - 1:15)
        if (s >= 0 && s < 75) {
          const stepInBar = tickerStep % 16;
          const barIdx = Math.floor(tickerStep / 16) % 4;
          const lfoFilterFreq = 1350 + Math.sin(tickerStep * 0.15) * 850;

          if (stepInBar === 0) {
            const dyad = forkDyads[barIdx];
            triggerForkChord(ctx, time, dyad[0], dyad[1], lfoFilterFreq, 2.0);
          }
          if (tickerStep % 2 === 0 || tickerStep % 7 === 3) {
            const mIdx = Math.floor(tickerStep * 1.75) % forkMelodyNotes.length;
            triggerForkMelody(ctx, time, forkMelodyNotes[mIdx], 0.38);
          }
          if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12 || stepInBar === 14) {
            const kickVol = (stepInBar === 0 || stepInBar === 12) ? 0.85 : 0.65;
            triggerKick(ctx, time, 135, 36, kickVol);
          }
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 13) {
            triggerNoise(ctx, time, 0.28, 2200, 0.035);
          }
          if (stepInBar % 5 === 0 || stepInBar % 2 === 1) {
            const hatVol = (stepInBar % 4 === 2) ? 0.25 : 0.14;
            triggerNoise(ctx, time, hatVol, 3200, 0.025);
          }
        }
        // Sec 02: Caballo de Troya (1:15 - 2:00)
        else if (s >= 75 && s < 120) {
          const stepInBar = tickerStep % 16;
          const barIdx = Math.floor(tickerStep / 16) % 4;
          const lfoFilterFreq = 1400 + Math.sin(tickerStep * 0.15) * 800;

          if (stepInBar === 0) {
            const dyad = forkDyads[barIdx];
            triggerForkChord(ctx, time, dyad[0], dyad[1], lfoFilterFreq, 2.0);
          }
          if (tickerStep % 3 === 0) {
            const mIdx = Math.floor(tickerStep * 1.75) % forkMelodyNotes.length;
            triggerForkMelody(ctx, time, forkMelodyNotes[mIdx], 0.26);
          }
          if (tickerStep % 2 === 0) {
            const brightFreqs = [523.25, 659.25, 783.99, 987.77, 1046.50, 1174.66];
            triggerTriangle(ctx, time, brightFreqs[(tickerStep / 2) % brightFreqs.length], 0.2, 0.2);
          }
          if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12) {
            triggerKick(ctx, time, 135, 36, 0.8);
          }
          if (stepInBar % 2 === 1) {
            triggerNoise(ctx, time, 0.16, 3200, 0.03);
          }
        }
        // Sec 03: Marcha Totalitaria (2:00 - 2:45)
        else if (s >= 120 && s < 165) {
          const snareVol = (tickerStep % 4 === 0) ? 0.65 : 0.35;
          triggerNoise(ctx, time, snareVol, 1400, 0.05);
          if (tickerStep % 4 === 0) {
            triggerSaw(ctx, time, 130.81, 0.35, 1600, 0.18);
          }
          if (tickerStep % 16 === 14) {
            triggerNoise(ctx, time, 0.4, 800, 0.08);
          }
        }
        // Sec 04: Flatline & Modem (2:45 - 3:25)
        else if (s >= 165 && s < 205) {
          if (tickerStep % 8 === 0) {
            triggerSine(ctx, time, 1046.50, 0.35, 0.07);
          }
          if (tickerStep % 4 === 2) {
            const chirpFreq = 1600 + Math.sin(tickerStep * 4) * 800;
            triggerSquare(ctx, time, chirpFreq, 0.09, 0.05);
          }
        }
        // Sec 05: Solo Rock Santana (3:25 - 4:05)
        else if (s >= 205 && s < 245) {
          if (tickerStep % 3 === 0 || tickerStep % 7 === 0) {
            const gFreq = santanaNotes[(tickerStep / 3) % santanaNotes.length];
            triggerGuitar(ctx, time, gFreq, 0.3, 0.4);
          }
        }
        // Sec 06: Rave Techno (4:05 - 5:15)
        else if (s >= 245 && s <= 315) {
          if (tickerStep % 4 === 0) {
            triggerKick(ctx, time, 160, 38, 0.95);
          }
          if (tickerStep % 4 === 2) {
            triggerNoise(ctx, time, 0.45, 6000, 0.08);
          }
          if (tickerStep % 2 === 0) {
            const acidNotes = [73.42, 87.31, 98.00, 116.54, 138.59, 146.83];
            const acidFreq = acidNotes[(tickerStep / 2) % acidNotes.length];
            const filterFreq = 800 + Math.sin(tickerStep * 0.4) * 1600;
            triggerAcid(ctx, time, acidFreq, filterFreq, 0.35, 0.14);
          }
          if (tickerStep % 8 === 4) {
            triggerGuitar(ctx, time, 587.33, 0.2, 0.3);
          }
        }
      }

      // MODE 3: :EXPERIMENTACION (MUSEO / TRANSITO BOCETOS)
      else if (currentMode === 'exp') {
        if (s < 45) {
          // Museo (Lo-fi 72 bpm)
          if (tickerStep % 8 === 0) triggerSine(ctx, time, 261.63, 0.3, 0.5);
          if (tickerStep % 4 === 0) triggerKick(ctx, time, 110, 32, 0.6);
        } else {
          // Tránsito (124 bpm)
          if (tickerStep % 4 === 0) triggerKick(ctx, time, 140, 35, 0.8);
          if (tickerStep % 2 === 1) triggerNoise(ctx, time, 0.2, 4000, 0.03);
        }
      }

      tickerStep++;
    }, 125);

    drawWaveform();
  }

  function stopPlayback() {
    if (clockInterval) { clearInterval(clockInterval); clockInterval = null; }
    if (soundTicker) { clearInterval(soundTicker); soundTicker = null; }
    isPlaying = false;
    playIcon.textContent = '▶';
    playLabel.textContent = 'Play';
    stopBtn.disabled = true;
    drawWaveform();
  }

  function drawWaveform() {
    if (!canvas) return;
    const width = canvas.width = canvas.clientWidth;
    const height = canvas.height = canvas.clientHeight;

    canvasCtx.fillStyle = '#101217';
    canvasCtx.fillRect(0, 0, width, height);

    if (!analyser || !isPlaying) {
      canvasCtx.strokeStyle = '#232731';
      canvasCtx.lineWidth = 1;
      canvasCtx.beginPath();
      canvasCtx.moveTo(0, height / 2);
      canvasCtx.lineTo(width, height / 2);
      canvasCtx.stroke();
      return;
    }

    const bufferLength = analyser.frequencyBinCount;
    const timeData = new Uint8Array(bufferLength);
    analyser.getByteTimeDomainData(timeData);

    canvasCtx.lineWidth = 1.5;
    canvasCtx.strokeStyle = currentMode === 'mutacion' ? '#34d399' : (currentMode === 'challenger' ? '#38bdf8' : '#fbbf24');
    canvasCtx.beginPath();

    const sliceWidth = width / bufferLength;
    let x = 0;
    for (let i = 0; i < bufferLength; i++) {
      const v = timeData[i] / 128.0;
      const y = (v * height) / 2;
      if (i === 0) canvasCtx.moveTo(x, y);
      else canvasCtx.lineTo(x, y);
      x += sliceWidth;
    }
    canvasCtx.stroke();

    requestAnimationFrame(drawWaveform);
  }

  // Event Handlers
  playBtn.addEventListener('click', () => {
    if (isPlaying) stopPlayback();
    else startPlayback();
  });

  stopBtn.addEventListener('click', () => {
    stopPlayback();
    seekTo(0);
  });

  loopBtn.addEventListener('click', () => {
    isLoopingSection = !isLoopingSection;
    loopLabel.textContent = isLoopingSection ? `Loop: Sec 0${activeSectionIndex + 1}` : 'Loop: Off';
    loopBtn.classList.toggle('btn-active', isLoopingSection);
  });

  volSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    volVal.textContent = `${Math.round(val * 100)}%`;
    if (masterGain && audioCtx) {
      masterGain.gain.setValueAtTime(val, audioCtx.currentTime);
    }
  });

  tabMutacion.addEventListener('click', () => setMode('mutacion'));
  tabChallenger.addEventListener('click', () => setMode('challenger'));
  tabExp.addEventListener('click', () => setMode('exp'));

  sectionBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      selectSection(idx, true);
    });
  });

  waveformTrack.addEventListener('click', (e) => {
    const rect = waveformTrack.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const pct = Math.max(0, Math.min(1, clickX / rect.width));
    seekTo(pct * totalDuration);
  });

  btnCopyRef.addEventListener('click', async () => {
    let textToCopy = '';
    if (currentMode === 'mutacion') {
      textToCopy = `[FEEDBACK :Mutacion] Variación C (Fork Base): `;
    } else if (currentMode === 'challenger') {
      const sec = sections[activeSectionIndex];
      textToCopy = `[FEEDBACK :Challenger] Sección 0${activeSectionIndex + 1} (${sec.startTime} - ${sec.endTime}) - ${sec.name.split('(')[0].trim()}: `;
    } else {
      textToCopy = `[FEEDBACK :Experimentacion] Bocetos: `;
    }

    try {
      await navigator.clipboard.writeText(textToCopy);
      const originalText = copyRefText.textContent;
      copyRefText.textContent = '¡Copiado al portapapeles!';
      setTimeout(() => { copyRefText.textContent = originalText; }, 2000);
    } catch (e) {
      console.warn(e);
    }
  });

  // Init
  setMode('mutacion');
  drawWaveform();
</script>

