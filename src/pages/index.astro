---
import Layout from '../layouts/Layout.astro';
import { TRACKS } from '../data/tracks';
import pkg from '../../package.json';

const appVersion = pkg.version;
const tracksData = TRACKS;
const baselineTrack = TRACKS[0];
const challengerTrack = TRACKS[1];
---

<Layout
  title={`RECOVERY // Vibe Coding Workstation v${appVersion}`}
  description="Estación de trabajo minimalista de Vibe Coding musical: audición dual A/B en pantalla dividida (Baseline vs Challenger), 7+ stems studio, modo claro/oscuro y generador de prompts para Antigravity."
>
  <main class="vibe-workstation" id="main-workstation">
    <!-- Header Minimalista y Barra de Herramientas -->
    <header class="workstation-header" role="banner">
      <div class="header-left">
        <h1 class="logo-title">RECOVERY</h1>
        <span class="badge-beta mono" aria-label={`Versión beta ${appVersion}`}>v{appVersion}</span>
        <span class="badge-mode mono" aria-label="Modo de trabajo">VIBE CODING LAB // DUAL DECK</span>
      </div>

      <div class="header-right">
        <!-- Theme Toggle Switch (Modo Claro / Modo Oscuro) -->
        <button
          type="button"
          class="btn-theme-toggle"
          id="btn-theme-toggle"
          aria-label="Alternar entre modo claro y modo oscuro"
          aria-pressed="false"
          title="Cambiar entre modo claro y oscuro"
        >
          <span class="theme-icon" id="theme-icon" aria-hidden="true">🌙</span>
          <span class="theme-label mono" id="theme-label">Oscuro</span>
        </button>

        <a
          href="https://github.com/willkwolf/Recovery-album"
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link mono"
          aria-label="Abrir repositorio de GitHub en pestaña nueva"
        >
          GitHub ↗
        </a>
      </div>
    </header>

    <!-- PANTALLA DIVIDIDA: DECK 1 (BASELINE) ARRIBA -->
    <section class="deck-split-card deck-baseline" id="deck-baseline-card" aria-labelledby="deck-1-title">
      <div class="deck-header">
        <div class="deck-identity">
          <span class="deck-badge deck-badge-baseline mono">🎛️ DECK 1: BASELINE // 100% DG GROUND TRUTH</span>
          <h2 class="deck-track-title" id="deck-1-title">{baselineTrack.title}</h2>
          <p class="deck-track-sub mono">
            01: Ticking Clock Spine (105 BPM) ──► 02: Hybrid Breakbeat (115 BPM) ──► 03: Brutalist Dropout (115 BPM) ──► 04: Surgical FM Neuro (140 BPM) ──► 05: Monumental Sub-Braam (105 BPM)
          </p>
        </div>
        <div class="deck-transport" role="toolbar" aria-label="Controles de reproducción Baseline">
          <button type="button" class="btn btn-baseline-play" id="btn-play-0" aria-label="Reproducir o pausar Baseline">
            <span id="play-icon-0" aria-hidden="true">▶</span>
            <span id="play-label-0">Play Baseline</span>
          </button>
          <button type="button" class="btn btn-stop" id="btn-stop-0" disabled aria-label="Detener reproducción Baseline">
            <span aria-hidden="true">■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn btn-loop" id="btn-loop-0" aria-label="Alternar repetición de sección en Baseline" aria-pressed="false">
            <span aria-hidden="true">🔁</span>
            <span id="loop-label-0">Loop: Off</span>
          </button>
          <div class="time-readout mono" id="time-display-0" aria-live="polite" aria-label="Tiempo actual y duración de Baseline">00:00 / 04:45</div>
        </div>
      </div>

      <!-- Scrubber & Waveform Canvas Baseline -->
      <div class="waveform-box" id="waveform-track-0" tabindex="0" role="slider" aria-label="Navegador de posición en Baseline" aria-valuemin="0" aria-valuemax="285" aria-valuenow="0" title="Haz clic o arrastra para mover el cabezal de la Baseline">
        <canvas id="waveform-canvas-0" height="52" aria-hidden="true"></canvas>
        <div class="selection-overlay overlay-baseline" id="selection-overlay-0" aria-hidden="true"></div>
        <div class="playhead playhead-baseline" id="playhead-0" aria-hidden="true"></div>
      </div>

      <!-- Baseline Sections Collapsible (Ahorro de Espacio para el Champion) -->
      <details class="baseline-sections-details mono" id="baseline-sections-details">
        <summary class="baseline-sections-summary" aria-label="Expandir o colapsar 5 secciones de la Baseline">
          <span>📂 Secciones Baseline (Ground Truth 04:45)</span>
          <span class="text-xs text-muted">(Clic para ver)</span>
        </summary>
        <div class="sections-row" id="sections-strip-0" role="group" aria-label="Secciones de la pista Baseline">
          {baselineTrack.sections?.map((sec, idx) => (
            <button
              type="button"
              class={`sec-btn sec-btn-baseline ${idx === 0 ? 'sec-btn-active-0' : ''}`}
              data-deck="0"
              data-sec-idx={idx}
              data-sec-id={sec.id}
              data-start={sec.startSec}
              data-end={sec.endSec}
              aria-label={`Sección 0${idx + 1}: ${sec.name.split('(')[0].trim()}, inicio ${sec.startTime}, fin ${sec.endTime}`}
              title={`[ID: ${sec.id}] ${sec.name} (${sec.startTime} - ${sec.endTime})`}
            >
              <div class="sec-btn-header">
                <span class="mono sec-num" aria-hidden="true">0{idx + 1}</span>
                <span class="sec-id-corner mono" title={`ID Inmutable: ${sec.id}`}>#{sec.id}</span>
              </div>
              <span class="sec-label">{sec.name.split('(')[0].trim()}</span>
              <span class="mono sec-time">{sec.startTime}</span>
            </button>
          ))}
        </div>
      </details>
    </section>

    <!-- PANTALLA DIVIDIDA: DECK 2 (CHALLENGER) ABAJO -->
    <section class="deck-split-card deck-challenger" id="deck-challenger-card" aria-labelledby="deck-2-title">
      <div class="deck-header">
        <div class="deck-identity">
          <span class="deck-badge deck-badge-challenger mono">⚡ DECK 2: CHALLENGER // 80% AI CREW SINGLE</span>
          <h2 class="deck-track-title" id="deck-2-title">{challengerTrack.title}</h2>
          <p class="deck-track-sub mono">
            01: Ambient Inmersivo (105 BPM) ──► 02: Puente Continuo Equal-Power & Morfología Afro-Neuro (118 BPM) ──► 03: Braam Monumental 35Hz & Catarsis (105 BPM)
          </p>
          <!-- Presentación del Single Challenger -->
          <div class="challenger-single-intro mono">
            <span class="intro-tag">⚡ QUÉ ES ESTE SINGLE // REWIRED [DECK 2]</span>
            <p class="intro-text">
              Una suite cinematográfica continua de <strong>07:15</strong> unificada alrededor del clímax aprobado por el Director General (04:46 - 05:32). Expone la tensión entre el reloj de cuenta regresiva implacable (2400Hz) y la catarsis emocional de un sub-braam monumental a 35Hz que despierta progresivamente, sufre una ruptura a los 2 minutos, y culmina en una gran fuga sideral transcultural.
            </p>
          </div>
        </div>
        <div class="deck-transport" role="toolbar" aria-label="Controles de reproducción Challenger">
          <button type="button" class="btn btn-challenger-play" id="btn-play-1" aria-label="Reproducir o pausar Challenger">
            <span id="play-icon-1" aria-hidden="true">▶</span>
            <span id="play-label-1">Play Challenger</span>
          </button>
          <button type="button" class="btn btn-stop" id="btn-stop-1" disabled aria-label="Detener reproducción Challenger">
            <span aria-hidden="true">■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn btn-loop" id="btn-loop-1" aria-label="Alternar repetición de sección en Challenger" aria-pressed="false">
            <span aria-hidden="true">🔁</span>
            <span id="loop-label-1">Loop: Off</span>
          </button>
          <div class="time-readout mono" id="time-display-1" aria-live="polite" aria-label="Tiempo actual y duración de Challenger">00:00 / 07:15</div>
        </div>
      </div>

      <!-- Suno Studio + Ableton Multitrack Toolbar & Channel Mute Bar -->
      <div class="daw-multitrack-toolbar mono" role="toolbar" aria-label="Controles del secuenciador multipista">
        <div class="daw-toolbar-left">
          <span class="multitrack-badge">🎚️ 9 CANALES</span>
          <span class="daw-meter-badge" id="daw-meter-display">BPM: 105/118 · Compás <strong id="daw-bar-counter">001.1.1</strong></span>
          <!-- Selector de Actos Integrado en Toolbar (Sustituye a la antigua tira #sections-strip-1) -->
          <div class="daw-acts-selector" id="daw-acts-selector" role="group" aria-label="Actos del single Challenger">
            {challengerTrack.sections?.map((sec, idx) => (
              <button
                type="button"
                class="btn-act-chip mono"
                data-deck="1"
                data-sec-idx={idx}
                data-sec-id={sec.id}
                data-start={sec.startSec}
                data-end={sec.endSec}
                aria-label={`Acto 0${idx + 1}: ${sec.name.split('(')[0].trim()}, inicio ${sec.startTime}, fin ${sec.endTime}`}
                title={`[ID: ${sec.id}] ${sec.name} (${sec.startTime} - ${sec.endTime})`}
              >
                <span class="act-chip-num">0{idx + 1}</span>
                <span class="act-chip-tag">{sec.id.replace('sec-ng-', '')}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="daw-toolbar-right">
          <!-- Zoom Controls -->
          <div class="daw-zoom-group" role="group" aria-label="Controles de zoom">
            <button type="button" class="btn-daw-tool" id="btn-zoom-out" aria-label="Reducir zoom timeline" title="Zoom Out (-)">🔍−</button>
            <span class="mono text-xs zoom-level-badge" id="zoom-level-badge" aria-live="polite">100%</span>
            <button type="button" class="btn-daw-tool" id="btn-zoom-in" aria-label="Aumentar zoom timeline" title="Zoom In (+)">🔍+</button>
            <button type="button" class="btn-daw-tool mono" id="btn-zoom-fit" aria-label="Ajustar zoom a pantalla completa" title="Zoom Fit (1:1)">1:1 Fit</button>
          </div>
          <!-- Reset All Mutes -->
          <button type="button" class="btn-daw-tool mono btn-unmute-all" id="btn-unmute-all" aria-label="Restaurar todos los canales activos" title="Activar todos los canales">
            🔊 Todos ON
          </button>
        </div>
      </div>

      <!-- Quick 9-Channel Interactive Mute / Solo Strip -->
      <div class="channels-strip-container mono" id="channels-strip-container" role="group" aria-label="Interruptores de activación ON/OFF por canal">
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="0" aria-pressed="true" title="Clic para mutear/activar Sub-Bass 35Hz"><span class="ch-led" style="background: #ef4444"></span><span class="ch-num">01</span><span class="ch-name">Sub-Bass</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="1" aria-pressed="true" title="Clic para mutear/activar Neuro FM Bass"><span class="ch-led" style="background: #f97316"></span><span class="ch-num">02</span><span class="ch-name">Neuro FM</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="2" aria-pressed="true" title="Clic para mutear/activar Lead Poly Synth"><span class="ch-led" style="background: #06b6d4"></span><span class="ch-num">03</span><span class="ch-name">Lead Poly</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="3" aria-pressed="true" title="Clic para mutear/activar Campanas OoT"><span class="ch-led" style="background: #3b82f6"></span><span class="ch-num">04</span><span class="ch-name">Campanas</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="4" aria-pressed="true" title="Clic para mutear/activar Coro Polifónico IA"><span class="ch-led" style="background: #a855f7"></span><span class="ch-num">05</span><span class="ch-name">Coro IA</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="5" aria-pressed="true" title="Clic para mutear/activar Capa Étnica 2026"><span class="ch-led" style="background: #10b981"></span><span class="ch-num">06</span><span class="ch-name">Étnica</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="6" aria-pressed="true" title="Clic para mutear/activar Reloj Continuo"><span class="ch-led" style="background: #f59e0b"></span><span class="ch-num">07</span><span class="ch-name">Reloj Vibe</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="7" aria-pressed="true" title="Clic para mutear/activar Batería Breakbeat"><span class="ch-led" style="background: #e11d48"></span><span class="ch-num">08</span><span class="ch-name">Batería</span><span class="ch-state">ON</span></button>
        <button type="button" class="btn-channel-toggle active-channel" data-track-idx="8" aria-pressed="true" title="Clic para mutear/activar Texturas Granulares & FX"><span class="ch-led" style="background: #ec4899"></span><span class="ch-num">09</span><span class="ch-name">FX & Sweeps</span><span class="ch-state">ON</span></button>
      </div>

      <!-- Scrubber & Waveform Canvas Challenger (Ableton Arrangement View 9 Tracks) -->
      <div class="waveform-box waveform-box-challenger" id="waveform-track-1" tabindex="0" role="slider" aria-label="Navegador de posición en Challenger" aria-valuemin="0" aria-valuemax="435" aria-valuenow="0" title="Arrastra sobre las pistas para seleccionar un rango y anotar, usa rueda para zoom o haz clic para mover el cabezal">
        <canvas id="waveform-canvas-1" height="440" aria-hidden="true"></canvas>
        <div class="selection-overlay overlay-challenger" id="selection-overlay-1" aria-hidden="true"></div>
        <div class="selection-draft-overlay" id="selection-draft-1" aria-hidden="true"></div>
        <div class="annotations-markers-layer" id="annotations-layer-1" aria-hidden="true"></div>
        <div class="playhead playhead-challenger" id="playhead-1" aria-hidden="true"></div>
      </div>

      <!-- FLOATING SELECTION & FAST PROMPT DOCK (INSPIRADO EN SUNO STUDIO) -->
      <div class="challenger-floating-dock" id="challenger-floating-dock" role="region" aria-label="Dock flotante de prompt y edición rápida">
        <div class="floating-dock-inner">
          <div class="dock-selection-chip" id="dock-selection-chip" title="Rango seleccionado en el Challenger">
            <span class="dock-chip-icon" aria-hidden="true">🌊</span>
            <span class="dock-chip-text mono" id="dock-chip-text">00:00 - 02:00 (120s) · Track 01 · c. 1.1</span>
            <button type="button" class="dock-chip-dismiss" id="btn-dock-clear-sel" aria-label="Limpiar rango seleccionado" title="Restaurar selección por defecto">✕</button>
          </div>

          <div class="dock-prompt-input-group">
            <input
              type="text"
              class="dock-prompt-input mono"
              id="dock-quick-prompt-input"
              placeholder="Dicta vibe para esta pista (ej: sweep de filtro, distorsión ChowTape, modulación FM)..."
              aria-label="Prompt rápido para la selección activa"
            />
          </div>

          <div class="dock-engine-badge mono" title="Motor activo de síntesis">
            <span class="engine-dot" aria-hidden="true"></span>
            <select class="dock-engine-select mono" id="dock-engine-select" aria-label="Seleccionar motor de síntesis">
              <option value="Surge XT (12 LFOs)">Surge XT (12 LFOs)</option>
              <option value="LMMS DAW Project">LMMS DAW Project</option>
              <option value="Cardinal Modular">Cardinal Modular</option>
              <option value="Airwindows DSP">Airwindows DSP</option>
              <option value="Strudel Compiled REPL">Strudel Compiled REPL</option>
            </select>
          </div>

          <button
            type="button"
            class="btn-dock-submit"
            id="btn-dock-quick-submit"
            aria-label="Inyectar en prompt maestro y copiar"
            title="Inyectar en prompt maestro y copiar al portapapeles"
          >
            <span aria-hidden="true">↑</span>
            <span>Despachar</span>
          </button>
        </div>
      </div>

      <!-- Menú Contextual Rápido de Timeline (Estilo DAW Suno Studio) -->
      <div class="timeline-context-menu" id="timeline-context-menu" style="display: none;" role="menu" aria-label="Opciones rápidas de selección">
        <button type="button" class="ctx-item" id="ctx-btn-copy" role="menuitem">
          <span class="ctx-icon" aria-hidden="true">📋</span>
          <span>Copiar Selección</span>
          <span class="ctx-shortcut mono">Ctrl+C</span>
        </button>
        <button type="button" class="ctx-item" id="ctx-btn-annotate" role="menuitem">
          <span class="ctx-icon" aria-hidden="true">📝</span>
          <span>Anotar para Agentes</span>
          <span class="ctx-shortcut mono">Ctrl+N</span>
        </button>
        <button type="button" class="ctx-item" id="ctx-btn-split" role="menuitem">
          <span class="ctx-icon" aria-hidden="true">✂️</span>
          <span>Aislar Rango / Split</span>
          <span class="ctx-shortcut mono">Ctrl+E</span>
        </button>
        <button type="button" class="ctx-item" id="ctx-btn-duplicate" role="menuitem">
          <span class="ctx-icon" aria-hidden="true">⚡</span>
          <span>Duplicar Clip / Mutar</span>
          <span class="ctx-shortcut mono">Ctrl+D</span>
        </button>
        <button type="button" class="ctx-item" id="ctx-btn-mute" role="menuitem">
          <span class="ctx-icon" aria-hidden="true">🔇</span>
          <span id="ctx-mute-label">Silenciar Pista (Mute)</span>
          <span class="ctx-shortcut mono">M</span>
        </button>
        <button type="button" class="ctx-item" id="ctx-btn-quick-play" role="menuitem">
          <span class="ctx-icon" aria-hidden="true">▶️</span>
          <span>Reproducir Rango</span>
          <span class="ctx-shortcut mono">Espacio</span>
        </button>
      </div>

      <!-- Popover de Anotación Flotante para el Director General -->
      <div class="annotation-popover" id="annotation-popover" style="display: none;" role="dialog" aria-modal="false" aria-labelledby="popover-title">
        <div class="popover-arrow"></div>
        <div class="popover-header">
          <span class="popover-range mono" id="popover-range-label">00:00 ── 00:00</span>
          <button type="button" class="btn-popover-close" id="btn-popover-close" aria-label="Cerrar globo">✕</button>
        </div>
        <textarea
          id="popover-note-input"
          class="popover-textarea mono"
          rows="2"
          placeholder="Escribe tu anotación táctica (ej: 'Falta crossfader suave y barrido de filtro')..."
        ></textarea>
        <div class="popover-actions">
          <button type="button" class="btn-popover-save" id="btn-popover-save">Guardar Anotación</button>
        </div>
      </div>

      <!-- Tira de Anotaciones Activas del Director (Timeline Chips) -->
      <div class="director-annotations-bar" id="director-annotations-bar" style="display: none;">
        <div class="annotations-bar-header">
          <span class="mono text-xs label-muted">ANOTACIONES DE TIMELINE DEL DIRECTOR (<span id="annotations-count">0</span>):</span>
          <button type="button" class="btn-clear-annotations mono" id="btn-clear-annotations" title="Eliminar todas las notas">Limpiar Todo</button>
        </div>
        <div class="annotations-chips-list" id="annotations-chips-list"></div>
      </div>
    </section>

    <!-- DOCKED CONSOLE: VIBE CODING & MULTI-AGENT PROMPT GENERATOR -->
    <section class="vibe-console-card" aria-labelledby="console-heading">
      <div class="console-header">
        <div class="console-title-group">
          <div class="console-tag-row">
            <span class="console-pill mono" id="console-heading">🎙️ VIBE PROMPT CONSOLE</span>
            <span class="mono text-xs text-muted" id="active-target-deck-label" aria-live="polite">Target: DECK 2 (Challenger Single)</span>
          </div>
          <p class="console-instruction">
            Construye el single con palabras. Selecciona la sección arriba, ajusta tu dirección en lenguaje natural y copia el prompt formateado con 1 clic para Antigravity.
          </p>
        </div>
        <div class="console-actions-top">
          <button
            type="button"
            class="btn btn-secondary btn-export-wav"
            id="btn-export-reference-wav"
            aria-label="Renderizar y descargar archivo WAV de referencia para ingeniería inversa"
            title="Renderizar buffer WAV de 16-bit estéreo de la sección activa"
          >
            <span aria-hidden="true">💾</span>
            <span id="btn-export-text">Renderizar WAV</span>
          </button>
          <button
            type="button"
            class="btn btn-primary btn-copy-prompt"
            id="btn-copy-vibe-prompt"
            aria-label="Copiar bloque de prompt estructurado para pegar en Antigravity"
            title="Copiar prompt al portapapeles"
          >
            <span aria-hidden="true">📋</span>
            <span id="btn-copy-text">Copiar Prompt</span>
          </button>
        </div>
      </div>

      <div class="console-body">
        <!-- Target Deck Toggle, Approved Vibe Anchor & Lyra Rescue Protocol -->
        <div class="console-row-meta">
          <div class="target-deck-selector">
            <span class="mono label-muted" id="label-deck-sel">DECK OBJETIVO:</span>
            <div class="deck-toggle-group" role="group" aria-labelledby="label-deck-sel">
              <button type="button" class="btn-deck-toggle" id="btn-select-deck-0" data-deck="0" aria-pressed="false">
                <span>🎛️ Deck 1: Baseline</span>
              </button>
              <button type="button" class="btn-deck-toggle active-deck-toggle" id="btn-select-deck-1" data-deck="1" aria-pressed="true">
                <span>⚡ Deck 2: Challenger</span>
              </button>
            </div>
          </div>


          <!-- Tags de Mutación: Formato Compacto con Botón + en la Esquina -->
          <div class="mutation-compact-bar" id="mutation-compact-bar">
            <div class="mutation-compact-header">
              <span class="mono label-muted" id="label-mut-tags">TAGS DE MUTACIÓN ACTIVOS:</span>
              <div class="mutation-active-pills" id="mutation-active-pills" role="group" aria-label="Tags de mutación activos">
                <span class="mono text-xs text-muted" id="empty-tags-hint">Sin tags activos (Limpio)</span>
              </div>
              <div class="mutation-add-corner">
                <button
                  type="button"
                  class="btn-add-tag-corner mono"
                  id="btn-add-mutation-tag"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-label="Añadir tag de mutación al agente activo"
                  title="Añadir tag de mutación (+)"
                >
                  <span class="plus-sign" aria-hidden="true">+</span>
                  <span>Añadir Tag</span>
                </button>
                <div class="mutation-dropdown-menu" id="mutation-dropdown-menu" style="display: none;" role="menu" aria-label="Catálogo de tags de mutación">
                  <button type="button" class="tag-menu-item mono" data-tag-id="CROSSFADE_TRANSITION" role="menuitem">
                    <span>🔀 Transición &amp; Crossfader</span>
                    <span class="tag-id-corner mono">#CROSSFADE</span>
                  </button>
                  <button type="button" class="tag-menu-item mono" data-tag-id="ORCHESTRAL_ETHNIC_LAYER" role="menuitem">
                    <span>🎻 Capa Transcultural 2026</span>
                    <span class="tag-id-corner mono">#ETHNIC_2026</span>
                  </button>
