      });
    }
  });

  // Event Listeners: Deck Controls
  [0, 1].forEach((idx) => {
    const dom = deckDOM[idx];
    const d = decks[idx];

    dom.playBtn.addEventListener('click', () => {
      if (playingDeck === idx) {
        stopDeckPlayback(idx);
      } else {
        startDeckPlayback(idx);
      }
    });

    dom.stopBtn.addEventListener('click', () => {
      stopDeckPlayback(idx);
      seekDeck(idx, 0);
    });

    dom.loopBtn.addEventListener('click', () => {
      if (loopingDeck === idx) {
        loopingDeck = null;
        dom.loopLabel.textContent = 'Loop: Off';
        dom.loopBtn.classList.remove('btn-loop-active');
        dom.loopBtn.setAttribute('aria-pressed', 'false');
