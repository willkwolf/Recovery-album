  // Vibe Prompt Generator (XML <vibe_dispatch> Format)
  function generateVibePrompt() {
    const d = decks[activeTargetDeck];
    const sec = d.sections[d.activeSecIdx] || d.sections[0];
    const userNote = vibeDirectorNote.value.trim() || 'Sin observaciones adicionales del DG. Proceder con el refinamiento técnico según las rúbricas.';
    const formattedStart = formatTime(selStart);
