  // Switch Track Tabs (Baseline vs Challenger)
  function setTrack(idx) {
    stopPlayback();
    currentTrackIdx = idx;
    const track = getActiveTrack();

    btnTabBaseline.classList.toggle('tab-main-active', idx === 0);
    btnTabChallenger.classList.toggle('tab-main-active', idx === 1);

    currentTrackTag.textContent = idx === 0 ? 'BASELINE // CHAMPION REBASE' : 'CHALLENGER // SPLINTERNET';
    activeTrackName.textContent = `${track.title} (${track.duration})`;
    toolActiveTrackLabel.textContent = `Target: ${track.title}`;

    if (!loadArrangementFromLocalStorage()) {
      workingSections = JSON.parse(JSON.stringify(track.sections || []));
      recalculateTimestamps();
    }

    if (idx === 0) {
      tabMutacionLabel.textContent = ':Victory (Champion Base)';
      tabChallengerLabel.textContent = ':Challenger (Suite Completa)';
      tabExpLabel.textContent = ':Experimentacion (Bocetos)';
      selectionStart = 0;
      selectionEnd = 75;
    } else {
      tabMutacionLabel.textContent = ':Mutacion (Base Reloj/Breakbeat)';
      tabChallengerLabel.textContent = ':Challenger (Suite 5 Actos)';
      tabExpLabel.textContent = ':Experimentacion (Skrillex Lab)';
      selectionStart = 0;
      selectionEnd = 65;
    }

    renderArrangerStrip();
    renderQuickSectionChips();
    updateToolScrubbers();
    setMode(idx === 0 ? 'challenger' : 'challenger');
  }

  function setMode(mode) {
    stopPlayback();
    currentMode = mode;
    trackSeconds = 0;

    tabMutacion.classList.toggle('btn-active', mode === 'mutacion');
    tabChallenger.classList.toggle('btn-active', mode === 'challenger');
    tabExp.classList.toggle('btn-active', mode === 'exp');

    const track = getActiveTrack();
    const vars = track.variations || [];

    if (mode === 'mutacion') {
      const baseVar = vars.find(v => v.lifecycle === ':Victory' || v.lifecycle === ':Mutacion') || vars[0];
      activeSecBadge.textContent = `:Victory // ${baseVar.name.split('(')[0]}`;
      drawerTag.textContent = ':Victory // CHAMPION BASELINE';
      drawerName.textContent = baseVar.name;
      drawerTime.textContent = '00:00 ── 05:15';
      drawerLifecycle.textContent = ':Victory (Aprobada)';
      drawerTempo.textContent = `${baseVar.bpm} BPM // D menor a C menor`;
      drawerInst.textContent = currentTrackIdx === 0
        ? 'TR-909 Kick 4/4, Acid TB-303, F# Tritone Capsule, Sawtooth Dyads, Fast Melody'
        : 'Zimmer Ticking Clock, Linkin Park Breakbeat, Drop-D Saw';
      drawerDesc.textContent = baseVar.description;
      drawerCode.textContent = baseVar.code;
      drawerReplLink.href = `https://strudel.cc/#${encodeURIComponent(baseVar.code)}`;
      setSelectionRange(0, Math.min(75, totalDuration));
    } else if (mode === 'challenger') {
      selectSection(0, false);
      if (workingSections[0]) {
        setSelectionRange(workingSections[0].startSec, workingSections[0].endSec);
      }
    } else if (mode === 'exp') {
      const expVar = vars.find(v => v.lifecycle === ':Experimentacion') || vars[vars.length - 1];
      activeSecBadge.textContent = ':Experimentacion // Boceto de Laboratorio';
      drawerTag.textContent = ':Experimentacion // LAB';
      drawerName.textContent = expVar.name;
      drawerTime.textContent = 'Boceto experimental';
      drawerLifecycle.textContent = ':Experimentacion';
      drawerTempo.textContent = `${expVar.bpm} BPM`;
      drawerInst.textContent = 'Exploración de síntesis FM y modulación formántica';
      drawerDesc.textContent = expVar.description;
      drawerCode.textContent = expVar.code;
      drawerReplLink.href = `https://strudel.cc/#${encodeURIComponent(expVar.code)}`;
