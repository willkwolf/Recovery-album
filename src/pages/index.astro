---
import Layout from '../layouts/Layout.astro';
import { TRACKS } from '../data/tracks';

const tracksData = TRACKS;
const baselineTrack = TRACKS[0];
const challengerTrack = TRACKS[1];
---

<Layout
  title="RECOVERY // Vibe Coding Workstation v0.2.0-beta"
  description="Estación de trabajo minimalista de Vibe Coding musical: audición dual A/B en pantalla dividida (Baseline vs Challenger), 7+ stems studio, modo claro/oscuro y generador de prompts para Antigravity."
>
  <main class="vibe-workstation" id="main-workstation">
    <!-- Header Minimalista y Barra de Herramientas -->
    <header class="workstation-header" role="banner">
      <div class="header-left">
        <h1 class="logo-title">RECOVERY</h1>
        <span class="badge-beta mono" aria-label="Versión beta 0.2.0">v0.2.0-beta</span>
        <span class="badge-mode mono" aria-label="Modo de trabajo">VIBE CODING LAB // DUAL DECK</span>
      </div>

      <div class="header-right">
        <!-- Theme Toggle Switch (Modo Claro / Modo Oscuro) -->
        <button
          type="button"
          class="btn-theme-toggle"
          id="btn-theme-toggle"
          aria-label="Alternar entre modo claro y modo oscuro"
          aria-pressed="false"
          title="Cambiar entre modo claro y oscuro"
        >
          <span class="theme-icon" id="theme-icon" aria-hidden="true">🌙</span>
          <span class="theme-label mono" id="theme-label">Oscuro</span>
        </button>

        <a
          href="https://github.com/willkwolf/Recovery-album"
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link mono"
          aria-label="Abrir repositorio de GitHub en pestaña nueva"
        >
          GitHub ↗
        </a>
      </div>
    </header>

    <!-- PANTALLA DIVIDIDA: DECK 1 (BASELINE) ARRIBA -->
    <section class="deck-split-card deck-baseline" id="deck-baseline-card" aria-labelledby="deck-1-title">
      <div class="deck-header">
        <div class="deck-identity">
          <span class="deck-badge deck-badge-baseline mono">🎛️ DECK 1: BASELINE // 100% DG GROUND TRUTH</span>
          <h2 class="deck-track-title" id="deck-1-title">{baselineTrack.title}</h2>
          <p class="deck-track-sub mono">
            Rave de Reciclaje (138 BPM) ──► Cápsula F# (124 BPM) ──► Fork C Mutante (110 BPM) ──► Trojan Sandbox ──► Solo Santana Invertido
          </p>
        </div>
        <div class="deck-transport" role="toolbar" aria-label="Controles de reproducción Baseline">
          <button type="button" class="btn btn-baseline-play" id="btn-play-0" aria-label="Reproducir o pausar Baseline">
            <span id="play-icon-0" aria-hidden="true">▶</span>
            <span id="play-label-0">Play Baseline</span>
          </button>
          <button type="button" class="btn btn-stop" id="btn-stop-0" disabled aria-label="Detener reproducción Baseline">
            <span aria-hidden="true">■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn btn-loop" id="btn-loop-0" aria-label="Alternar repetición de sección en Baseline" aria-pressed="false">
            <span aria-hidden="true">🔁</span>
            <span id="loop-label-0">Loop: Off</span>
          </button>
          <div class="time-readout mono" id="time-display-0" aria-live="polite" aria-label="Tiempo actual y duración de Baseline">00:00 / 05:15</div>
        </div>
      </div>

      <!-- Scrubber & Waveform Canvas Baseline -->
      <div class="waveform-box" id="waveform-track-0" tabindex="0" role="slider" aria-label="Navegador de posición en Baseline" aria-valuemin="0" aria-valuemax="315" aria-valuenow="0" title="Haz clic o arrastra para mover el cabezal de la Baseline">
        <canvas id="waveform-canvas-0" height="52" aria-hidden="true"></canvas>
        <div class="selection-overlay overlay-baseline" id="selection-overlay-0" aria-hidden="true"></div>
        <div class="playhead playhead-baseline" id="playhead-0" aria-hidden="true"></div>
      </div>

      <!-- Timeline Sections Strip Baseline -->
      <div class="sections-row" id="sections-strip-0" role="group" aria-label="Secciones de la pista Baseline">
        {baselineTrack.sections?.map((sec, idx) => (
          <button
            type="button"
            class={`sec-btn sec-btn-baseline ${idx === 0 ? 'sec-btn-active-0' : ''}`}
            data-deck="0"
            data-sec-idx={idx}
            data-start={sec.startSec}
            data-end={sec.endSec}
            aria-label={`Sección 0${idx + 1}: ${sec.name.split('(')[0].trim()}, inicio ${sec.startTime}, fin ${sec.endTime}`}
            title={`${sec.name} (${sec.startTime} - ${sec.endTime})`}
          >
            <span class="mono sec-num" aria-hidden="true">0{idx + 1}</span>
            <span class="sec-label">{sec.name.split('(')[0].trim()}</span>
            <span class="mono sec-time">{sec.startTime}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- PANTALLA DIVIDIDA: DECK 2 (CHALLENGER) ABAJO -->
    <section class="deck-split-card deck-challenger" id="deck-challenger-card" aria-labelledby="deck-2-title">
      <div class="deck-header">
        <div class="deck-identity">
          <span class="deck-badge deck-badge-challenger mono">⚡ DECK 2: CHALLENGER // 80% AI CREW SINGLE</span>
          <h2 class="deck-track-title" id="deck-2-title">{challengerTrack.title}</h2>
          <p class="deck-track-sub mono">
            01: Zimmer x Daft Punk (105 BPM) ──► 02: Linkin Park Breakbeat (115 BPM) ──► 03: Code Orange Dropout (115 BPM) ──► 04: Skrillex Neuro FM (140 BPM) ──► 05: Braam x Ocarina Fade (105 BPM)
          </p>
        </div>
        <div class="deck-transport" role="toolbar" aria-label="Controles de reproducción Challenger">
          <button type="button" class="btn btn-challenger-play" id="btn-play-1" aria-label="Reproducir o pausar Challenger">
            <span id="play-icon-1" aria-hidden="true">▶</span>
            <span id="play-label-1">Play Challenger</span>
          </button>
          <button type="button" class="btn btn-stop" id="btn-stop-1" disabled aria-label="Detener reproducción Challenger">
            <span aria-hidden="true">■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn btn-loop" id="btn-loop-1" aria-label="Alternar repetición de sección en Challenger" aria-pressed="false">
            <span aria-hidden="true">🔁</span>
            <span id="loop-label-1">Loop: Off</span>
          </button>
          <div class="time-readout mono" id="time-display-1" aria-live="polite" aria-label="Tiempo actual y duración de Challenger">00:00 / 04:45</div>
        </div>
      </div>

      <!-- Scrubber & Waveform Canvas Challenger -->
      <div class="waveform-box" id="waveform-track-1" tabindex="0" role="slider" aria-label="Navegador de posición en Challenger" aria-valuemin="0" aria-valuemax="285" aria-valuenow="0" title="Haz clic o arrastra para mover el cabezal del Challenger">
        <canvas id="waveform-canvas-1" height="52" aria-hidden="true"></canvas>
        <div class="selection-overlay overlay-challenger" id="selection-overlay-1" aria-hidden="true"></div>
        <div class="playhead playhead-challenger" id="playhead-1" aria-hidden="true"></div>
      </div>

      <!-- Timeline Sections Strip Challenger -->
      <div class="sections-row" id="sections-strip-1" role="group" aria-label="Actos del single Challenger">
        {challengerTrack.sections?.map((sec, idx) => (
          <button
            type="button"
            class={`sec-btn sec-btn-challenger ${idx === 0 ? 'sec-btn-active-1' : ''}`}
            data-deck="1"
            data-sec-idx={idx}
            data-start={sec.startSec}
            data-end={sec.endSec}
            aria-label={`Acto 0${idx + 1}: ${sec.name.split('(')[0].trim()}, inicio ${sec.startTime}, fin ${sec.endTime}`}
            title={`${sec.name} (${sec.startTime} - ${sec.endTime})`}
          >
            <span class="mono sec-num" aria-hidden="true">0{idx + 1}</span>
            <span class="sec-label">{sec.name.split('(')[0].trim()}</span>
            <span class="mono sec-time">{sec.startTime}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- DOCKED CONSOLE: VIBE CODING & MULTI-AGENT PROMPT GENERATOR -->
    <section class="vibe-console-card" aria-labelledby="console-heading">
      <div class="console-header">
        <div class="console-title-group">
          <div class="console-tag-row">
            <span class="console-pill mono" id="console-heading">🎙️ VIBE PROMPT CONSOLE</span>
            <span class="mono text-xs text-muted" id="active-target-deck-label" aria-live="polite">Target: DECK 2 (Challenger Single)</span>
          </div>
          <p class="console-instruction">
            Construye el single con palabras. Selecciona la sección arriba, ajusta tu dirección en lenguaje natural y copia el prompt formateado con 1 clic para Antigravity.
          </p>
        </div>
        <div class="console-actions-top">
          <button
            type="button"
            class="btn btn-primary btn-copy-prompt"
            id="btn-copy-vibe-prompt"
            aria-label="Copiar bloque de prompt estructurado para pegar en Antigravity"
            title="Copiar prompt al portapapeles"
          >
            <span aria-hidden="true">📋</span>
            <span id="btn-copy-text">Copiar Prompt</span>
          </button>
        </div>
      </div>

      <div class="console-body">
        <!-- Target Deck Toggle & Approved Vibe Anchor -->
        <div class="console-row-meta">
          <div class="target-deck-selector">
            <span class="mono label-muted" id="label-deck-sel">DECK OBJETIVO:</span>
            <div class="deck-toggle-group" role="group" aria-labelledby="label-deck-sel">
              <button type="button" class="btn-deck-toggle" id="btn-select-deck-0" data-deck="0" aria-pressed="false">
                <span>🎛️ Deck 1: Baseline</span>
              </button>
              <button type="button" class="btn-deck-toggle active-deck-toggle" id="btn-select-deck-1" data-deck="1" aria-pressed="true">
                <span>⚡ Deck 2: Challenger</span>
              </button>
            </div>
          </div>

          <div class="vibe-anchor-box">
            <span class="mono label-muted" id="label-anchor-sel">PATRÓN VIBE APROBADO:</span>
            <button
              type="button"
              class="anchor-pill anchor-pill-active"
              id="btn-toggle-anchor"
              aria-pressed="true"
              aria-labelledby="label-anchor-sel"
              title="Activar/desactivar inclusión del ancla rítmica en el prompt"
            >
              <span class="anchor-icon" aria-hidden="true">⏱️</span>
              <span class="anchor-text">Reloj de Cuenta Regresiva (Hans Zimmer 16th Pulse)</span>
            </button>
          </div>
        </div>

        <!-- Target Crew Routing Pills -->
        <div class="console-routing-row">
          <span class="mono label-muted" id="label-crew-sel">ENRUTAR CONVERSACIÓN CON AGENTES:</span>
          <div class="crew-chips" id="crew-chips" role="group" aria-labelledby="label-crew-sel">
            <button type="button" class="chip-crew chip-crew-active" data-role="DM" aria-pressed="true">L1 · DM (Dirección Musical)</button>
            <button type="button" class="chip-crew chip-crew-active" data-role="CP" aria-pressed="true">L2 · CP (Composición)</button>
            <button type="button" class="chip-crew chip-crew-active" data-role="SD" aria-pressed="true">L2 · SD (Diseño Sonoro)</button>
            <button type="button" class="chip-crew chip-crew-active" data-role="AE" aria-pressed="true">L2 · AE (Ingeniería de Audio)</button>
            <button type="button" class="chip-crew" data-role="QA" aria-pressed="false">L3 · QA (Auditoría & Gate)</button>
          </div>
        </div>

        <!-- Human Director General Natural Language Prompt Input -->
        <div class="console-input-row">
          <label for="vibe-director-note" class="mono label-muted">
            DIRECCIÓN DEL DIRECTOR GENERAL (VIBE PROMPT EN LENGUAJE NATURAL):
          </label>
          <textarea
            id="vibe-director-note"
            rows="2"
            class="director-textarea mono"
            placeholder="Escribe lo que sientes o deseas cambiar (ej: 'El paso de la sección 1 a la 2 necesita un build de caja acelerando y un sweep blanco de 4 compases antes de caer en el breakbeat')..."
          ></textarea>
        </div>

        <!-- Real-Time Markdown Formatted Prompt Preview -->
        <div class="console-preview-row">
          <div class="preview-header-bar">
            <span class="mono label-muted">PROMPT ESTRUCTURADO PARA ANTIGRAVITY (VISTA PREVIA):</span>
            <span class="mono text-xs text-muted" id="preview-range-badge" aria-live="polite">00:00 ── 01:05 (65s)</span>
          </div>
          <pre class="prompt-code-block mono" tabindex="0" aria-label="Texto formateado del prompt"><code id="prompt-preview-output">Generando prompt...</code></pre>
        </div>
      </div>
    </section>

    <!-- Footer Minimalista -->
    <footer class="workstation-footer mono" role="contentinfo">
      <span>RECOVERY // VIBE CODING WORKSTATION (v0.2.0-beta)</span>
      <span>Genealogía HITL: :Experimentacion → :Mutacion → :Challenger → :Victory</span>
    </footer>
  </main>
</Layout>

<script define:vars={{ tracksData }}>
  // Dual-Deck State
  let activeTargetDeck = 1; // 0: Baseline, 1: Challenger
  let playingDeck = null;   // null, 0, or 1
  let loopingDeck = null;   // null, 0, or 1

  const decks = [
    {
      id: 0,
      track: tracksData[0],
      duration: 315,
      currentSec: 0,
      activeSecIdx: 0,
      sections: tracksData[0].sections || []
    },
    {
      id: 1,
      track: tracksData[1],
      duration: 285,
      currentSec: 0,
      activeSecIdx: 0,
      sections: tracksData[1].sections || []
    }
  ];

  // Selection Range & Prompt Parameters
  let selStart = 0;
  let selEnd = 65;
  let includeCountdownAnchor = true;
  let activeCrewRoles = new Set(['DM', 'CP', 'SD', 'AE']);

  // Web Audio Context & Synthesizer State
  let audioCtx = null;
  let analyser = null;
  let masterGain = null;
  let clockInterval = null;
  let soundTicker = null;
  let tickerStep = 0;

  // Theme Management
  const btnThemeToggle = document.getElementById('btn-theme-toggle');
  const themeIcon = document.getElementById('theme-icon');
  const themeLabel = document.getElementById('theme-label');

  function getCurrentTheme() {
    return document.documentElement.getAttribute('data-theme') || 'dark';
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('recovery_theme', theme);
    const metaTheme = document.getElementById('meta-theme-color');
    if (metaTheme) {
      metaTheme.setAttribute('content', theme === 'light' ? '#f8fafc' : '#090c12');
    }
    if (theme === 'light') {
      themeIcon.textContent = '☀️';
      themeLabel.textContent = 'Claro';
      btnThemeToggle.setAttribute('aria-pressed', 'true');
    } else {
      themeIcon.textContent = '🌙';
      themeLabel.textContent = 'Oscuro';
      btnThemeToggle.setAttribute('aria-pressed', 'false');
    }
    drawWaveforms();
  }

  btnThemeToggle.addEventListener('click', () => {
    const current = getCurrentTheme();
    const nextTheme = current === 'dark' ? 'light' : 'dark';
    applyTheme(nextTheme);
  });

  // DOM Cache
  const btnSelectDeck0 = document.getElementById('btn-select-deck-0');
  const btnSelectDeck1 = document.getElementById('btn-select-deck-1');
  const activeTargetDeckLabel = document.getElementById('active-target-deck-label');
  const btnToggleAnchor = document.getElementById('btn-toggle-anchor');
  const crewChips = document.querySelectorAll('.chip-crew');
  const vibeDirectorNote = document.getElementById('vibe-director-note');
  const promptPreviewOutput = document.getElementById('prompt-preview-output');
  const previewRangeBadge = document.getElementById('preview-range-badge');
  const btnCopyVibePrompt = document.getElementById('btn-copy-vibe-prompt');
  const btnCopyText = document.getElementById('btn-copy-text');

  // Deck DOM references
  const deckDOM = [
    {
      playBtn: document.getElementById('btn-play-0'),
      stopBtn: document.getElementById('btn-stop-0'),
      playIcon: document.getElementById('play-icon-0'),
      playLabel: document.getElementById('play-label-0'),
      loopBtn: document.getElementById('btn-loop-0'),
      loopLabel: document.getElementById('loop-label-0'),
      timeDisplay: document.getElementById('time-display-0'),
      canvas: document.getElementById('waveform-canvas-0'),
      playhead: document.getElementById('playhead-0'),
      overlay: document.getElementById('selection-overlay-0'),
      waveformTrack: document.getElementById('waveform-track-0'),
      stripButtons: document.querySelectorAll('#sections-strip-0 .sec-btn')
    },
    {
      playBtn: document.getElementById('btn-play-1'),
      stopBtn: document.getElementById('btn-stop-1'),
      playIcon: document.getElementById('play-icon-1'),
      playLabel: document.getElementById('play-label-1'),
      loopBtn: document.getElementById('btn-loop-1'),
      loopLabel: document.getElementById('loop-label-1'),
      timeDisplay: document.getElementById('time-display-1'),
      canvas: document.getElementById('waveform-canvas-1'),
      playhead: document.getElementById('playhead-1'),
      overlay: document.getElementById('selection-overlay-1'),
      waveformTrack: document.getElementById('waveform-track-1'),
      stripButtons: document.querySelectorAll('#sections-strip-1 .sec-btn')
    }
  ];

  // Helper format seconds -> mm:ss
  function formatTime(s) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  }

  // Audio Context Initialization
  function getAudioContext() {
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || window['webkitAudioContext'];
      audioCtx = new AudioCtxClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      masterGain = audioCtx.createGain();
      masterGain.gain.setValueAtTime(0.85, audioCtx.currentTime);
      masterGain.connect(analyser);
      analyser.connect(audioCtx.destination);
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // Distortion Curve Maker
  function makeDistCurve(amount = 45) {
    const k = amount;
    const n = 44100;
    const curve = new Float32Array(n);
    const deg = Math.PI / 180;
    for (let i = 0; i < n; ++i) {
      const x = (i * 2) / n - 1;
      curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
    }
    return curve;
  }
  const distCurve = makeDistCurve(45);

  // Synthesis Primitives (7+ Stems Studio Quality)
  function playKick(ctx, time, startF = 160, endF = 38, vol = 0.95, dur = 0.18) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(startF, time);
    osc.frequency.exponentialRampToValueAtTime(endF, time + dur * 0.8);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playNoise(ctx, time, vol = 0.35, highpassF = 4000, dur = 0.08) {
    const bufSize = Math.max(1, Math.floor(ctx.sampleRate * dur));
    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const f = ctx.createBiquadFilter();
    f.type = 'highpass';
    f.frequency.setValueAtTime(highpassF, time);
    const g = ctx.createGain();
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    src.connect(f);
    f.connect(g);
    g.connect(masterGain);
    src.start(time);
    src.stop(time + dur);
  }

  function playSaw(ctx, time, freq, vol = 0.3, filterF = 1800, dur = 0.25) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(filterF, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playSquare(ctx, time, freq, vol = 0.35, dur = 0.15) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playSine(ctx, time, freq, vol = 0.35, dur = 0.25) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playTriangle(ctx, time, freq, vol = 0.3, dur = 0.2) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playAcid(ctx, time, freq, filterF = 1800, vol = 0.35, dur = 0.12) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(filterF, time);
    f.Q.value = 16;
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  // Hans Zimmer Ticking Rimshot with Stereo Micropan
  function playZimmerTick(ctx, time, panVal = 0) {
    const osc = ctx.createOscillator();
    const filter = ctx.createBiquadFilter();
    const panner = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(2400, time);
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(2400, time);
    filter.Q.value = 9;
    g.gain.setValueAtTime(0.24, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.022);
    osc.connect(filter);
    filter.connect(g);
    if (panner) {
      panner.pan.setValueAtTime(panVal, time);
      g.connect(panner);
      panner.connect(masterGain);
    } else {
      g.connect(masterGain);
    }
    osc.start(time);
    osc.stop(time + 0.025);
  }

  // Hans Zimmer Monumental Braam (35Hz)
  function playZimmerBraam(ctx, time, baseFreq = 35, vol = 0.9, dur = 2.2) {
    [baseFreq, baseFreq * 1.012, baseFreq * 2].forEach((f, i) => {
      const osc = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const g = ctx.createGain();
      osc.type = i === 2 ? 'sawtooth' : 'triangle';
      osc.frequency.setValueAtTime(f, time);
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(240, time);
      filter.Q.value = 7;
      g.gain.setValueAtTime(0.001, time);
      g.gain.linearRampToValueAtTime(vol * 0.45, time + 0.08);
      g.gain.exponentialRampToValueAtTime(0.001, time + dur);
      osc.connect(filter);
      filter.connect(g);
      g.connect(masterGain);
      osc.start(time);
      osc.stop(time + dur);
    });
  }

  // Skrillex Neuro FM Growl with Formant Sweeps
  function playNeuroFMGrowl(ctx, time, carrierF, modF, filterF, vol = 0.8, dur = 0.28) {
    const carrier = ctx.createOscillator();
    const modulator = ctx.createOscillator();
    const modGain = ctx.createGain();
    const filter = ctx.createBiquadFilter();
    const shaper = ctx.createWaveShaper();
    const g = ctx.createGain();

    carrier.type = 'sawtooth';
    carrier.frequency.setValueAtTime(carrierF, time);
    modulator.type = 'sine';
    modulator.frequency.setValueAtTime(modF, time);
    modGain.gain.setValueAtTime(carrierF * 2.8, time);
    modulator.connect(modGain);
    modGain.connect(carrier.frequency);

    shaper.curve = distCurve;
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(filterF, time);
    filter.Q.value = 18;

    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);

    carrier.connect(shaper);
    shaper.connect(filter);
    filter.connect(g);
    g.connect(masterGain);

    carrier.start(time);
    modulator.start(time);
    carrier.stop(time + dur);
    modulator.stop(time + dur);
  }

  // Playback Control Engine
  function startDeckPlayback(deckId) {
    getAudioContext();
    if (playingDeck !== null && playingDeck !== deckId) {
      stopDeckPlayback(playingDeck);
    }
    playingDeck = deckId;
    activeTargetDeck = deckId;
    updateTargetDeckUI();

    const d = decks[deckId];
    const dom = deckDOM[deckId];
    dom.playIcon.textContent = '⏸';
    dom.playLabel.textContent = `Pause Deck ${deckId + 1}`;
    dom.stopBtn.disabled = false;

    // Timer Interval
    clockInterval = setInterval(() => {
      d.currentSec += 0.5;

      // Section Looping logic
      if (loopingDeck === deckId) {
        const curSec = d.sections[d.activeSecIdx];
        if (curSec && d.currentSec >= curSec.endSec) {
          d.currentSec = curSec.startSec;
        }
      } else {
        if (d.currentSec >= d.duration) {
          d.currentSec = 0;
        }
      }
      updateDeckUI(deckId);
    }, 500);

    // Audio Step Sequencer (125ms = 16th notes @ 120 BPM base)
    soundTicker = setInterval(() => {
      const ctx = audioCtx;
      if (!ctx || playingDeck !== deckId) return;
      const time = ctx.currentTime;
      const s = d.currentSec;
      const stepInBar = tickerStep % 16;

      // --- DECK 0: BASELINE (100% CONTROL DG) ---
      if (deckId === 0) {
        // Section 1: Rave de Reciclaje (0:00 - 1:15 // 138 BPM)
        if (s < 75) {
          if (stepInBar % 4 === 0) playKick(ctx, time, 160, 38, 0.95);
          if (stepInBar % 4 === 2) playNoise(ctx, time, 0.45, 4500, 0.08);
          if (stepInBar % 2 === 1) playNoise(ctx, time, 0.2, 6000, 0.03);
          if (stepInBar % 2 === 0) {
            const acidNotes = [73.42, 87.31, 98.00, 116.54, 138.59, 146.83];
            const aF = acidNotes[(tickerStep / 2) % acidNotes.length];
            const filterF = 800 + Math.sin(tickerStep * 0.4) * 1800;
            playAcid(ctx, time, aF, filterF, 0.35, 0.14);
          }
          if (stepInBar === 4 || stepInBar === 12) {
            playSaw(ctx, time, 293.66, 0.3, 2400, 0.2); // D4 stab
          }
        }
        // Section 2: Transición Cápsula F# (1:15 - 1:50 // 138 -> 110 BPM)
        else if (s >= 75 && s < 110) {
          if (stepInBar === 0 || stepInBar === 6 || stepInBar === 12) {
            playKick(ctx, time, 120, 32, 0.65);
          }
          if (stepInBar % 4 === 1) playNoise(ctx, time, 0.18, 2200, 0.06);
          if (stepInBar === 0) playSaw(ctx, time, 92.50, 0.45, 950, 1.8); // F#2 drone
          if (tickerStep % 3 === 0) playNoise(ctx, time, 0.25, 3200, 0.025);
        }
        // Section 3: Fork C Mutante (1:50 - 3:05 // 110 BPM)
        else if (s >= 110 && s < 185) {
          const barIdx = Math.floor(tickerStep / 16) % 4;
          const lfoFilter = 1350 + Math.sin(tickerStep * 0.15) * 850;
          if (stepInBar === 0) {
            const dyads = [[65.41, 98.00], [77.78, 116.54], [87.31, 130.81], [92.50, 130.81]];
            dyads[barIdx].forEach(f => playSaw(ctx, time, f, 0.3, lfoFilter, 1.9));
          }
          if (tickerStep % 2 === 0 || tickerStep % 7 === 3) {
            const mNotes = [261.63, 311.13, 392.00, 369.99, 466.16, 587.33, 523.25];
            playSine(ctx, time, mNotes[(tickerStep * 2) % mNotes.length], 0.35, 0.2);
          }
          if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12) playKick(ctx, time, 135, 36, 0.8);
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 13) {
            playNoise(ctx, time, 0.26, 2400, 0.035);
          }
        }
        // Section 4: Trojan Sandbox (3:05 - 4:10)
        else if (s >= 185 && s < 250) {
          if (stepInBar % 4 === 0) {
            playTriangle(ctx, time, 523.25, 0.25, 0.4);
            playTriangle(ctx, time, 659.25, 0.2, 0.35);
          }
          if (tickerStep % 8 === 0) playSine(ctx, time, 1046.50, 0.35, 0.08); // EKG flatline
          if (tickerStep % 6 === 2) playSquare(ctx, time, 1800, 0.08, 0.04);   // 56k chirp
        }
        // Section 5: Solo Santana Invertido (4:10 - 5:15)
        else if (s >= 250 && s <= 315) {
          if (tickerStep % 3 === 0) {
            const santanaNotes = [587.33, 440.00, 349.23, 523.25, 392.00, 329.63, 466.16];
            playSaw(ctx, time, santanaNotes[(tickerStep / 3) % santanaNotes.length], 0.35, 2400, 0.4);
          }
        }
      }

      // --- DECK 1: CHALLENGER (80% CREW AUTONOMY // STUDIO SUITE 5 ACTOS) ---
      else if (deckId === 1) {
        // ACTO 1: Zimmer Clock x French Touch Daft Punk (00:00 - 01:05)
        if (s < 65) {
          if (stepInBar % 4 === 0) playKick(ctx, time, 155, 42, 0.95);
          if (stepInBar % 4 === 2) playNoise(ctx, time, 0.35, 5500, 0.08);
          const pan = Math.sin(tickerStep * 0.4) * 0.6;
          playZimmerTick(ctx, time, pan);
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 14) {
            const chords = [
              [130.81, 155.56, 196.00, 233.08],
              [103.83, 130.81, 155.56, 196.00],
              [87.31, 103.83, 130.81, 155.56],
              [98.00, 123.47, 146.83, 174.61]
            ];
            const chordIdx = Math.floor(tickerStep / 16) % chords.length;
            const filterSweep = 600 + Math.sin(tickerStep * 0.2) * 2200;
            chords[chordIdx].forEach(f => playSaw(ctx, time, f, 0.22, filterSweep, 0.18));
          }
          if (stepInBar % 2 === 0) {
            const bass = [65.41, 130.81, 77.78, 155.56, 87.31, 174.61, 98.00, 196.00];
            playAcid(ctx, time, bass[(tickerStep / 2) % bass.length], 1400, 0.38, 0.1);
          }
          if (s >= 55 && s < 65) {
            if (tickerStep % 2 === 0) playNoise(ctx, time, 0.3 + (s - 55) * 0.05, 3000, 0.05);
          }
        }

        // ACTO 2: Breakbeat Híbrido & Drop-D Industrial (Linkin Park) (01:05 - 02:00)
        else if (s >= 65 && s < 120) {
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10) {
            playKick(ctx, time, 165, 38, 1.0);
          }
          if (stepInBar === 4 || stepInBar === 12) {
            playNoise(ctx, time, 0.65, 3200, 0.12);
            playKick(ctx, time, 190, 75, 0.4);
          }
          if (stepInBar === 7 || stepInBar === 11 || stepInBar === 15) {
            playNoise(ctx, time, 0.22, 2800, 0.04);
          }
          if (stepInBar % 2 === 1) playNoise(ctx, time, 0.25, 6200, 0.025);
          if (stepInBar === 0 || stepInBar === 2 || stepInBar === 8 || stepInBar === 13) {
            const rNotes = [65.41, 77.78, 87.31, 92.50];
            playSaw(ctx, time, rNotes[Math.floor(stepInBar / 4) % rNotes.length], 0.48, 2600, 0.28);
          }
          if (stepInBar === 2 || stepInBar === 6 || stepInBar === 14) {
            playSaw(ctx, time, 261.63, 0.32, 3800, 0.14);
          }
          if (s >= 112 && s < 120) {
            playNoise(ctx, time, 0.1 + (s - 112) * 0.04, 2000 + (s - 112) * 500, 0.1);
          }
        }

        // ACTO 3: Brutalist Digital Dropout & Harsh Feedback (Code Orange) (02:00 - 02:50)
        else if (s >= 120 && s < 170) {
          const isDropout = (Math.floor(tickerStep / 16) % 2 === 1) && (stepInBar >= 8 && stepInBar <= 11);
          if (!isDropout) {
            if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 12) {
              playSquare(ctx, time, 92.50, 0.65, 0.14);
              playSquare(ctx, time, 65.41, 0.65, 0.14);
            }
            if (stepInBar === 4 || stepInBar === 14) {
              playNoise(ctx, time, 0.55, 1600, 0.09);
              playSquare(ctx, time, 466.16, 0.3, 0.06);
            }
            if (stepInBar === 0) playSaw(ctx, time, 60, 0.35, 140, 1.8);
          }
        }

        // ACTO 4: Surgical FM Neuro Growl Drop (Skrillex / Noisia) (02:50 - 03:40)
        else if (s >= 170 && s < 220) {
          if (stepInBar === 0 || stepInBar === 10) playKick(ctx, time, 170, 32, 1.1);
          if (stepInBar === 8) {
            playNoise(ctx, time, 0.75, 2400, 0.18);
            playKick(ctx, time, 200, 90, 0.6);
          }
          if (stepInBar % 2 === 0) {
            const growlNotes = [65.41, 77.78, 92.50, 98.00, 116.54, 130.81];
            const gF = growlNotes[(tickerStep / 2) % growlNotes.length];
            const modF = 120 + ((tickerStep * 23) % 280);
            const filtF = 800 + Math.sin(tickerStep * 0.7) * 3200;
            playNeuroFMGrowl(ctx, time, gF, modF, filtF, 0.75, 0.22);
          }
          if (stepInBar % 2 === 1) {
            const laserF = 523.25 + ((tickerStep * 67) % 800);
            playTriangle(ctx, time, laserF, 0.28, 0.04);
            playNoise(ctx, time, 0.18, 7000, 0.02);
          }
        }

        // ACTO 5: Zimmer Monumental Braam x Daft Punk Sidechain Fade (03:40 - 04:45)
        else if (s >= 220 && s <= 285) {
          if (stepInBar === 0) playZimmerBraam(ctx, time, 35, 0.9, 2.2);
          if (stepInBar === 2 || stepInBar === 6 || stepInBar === 10 || stepInBar === 14) {
            const pChords = [
              [130.81, 196.00, 261.63, 311.13],
              [116.54, 174.61, 233.08, 293.66],
              [103.83, 155.56, 207.65, 261.63],
              [98.00, 146.83, 196.00, 246.94]
            ];
            const padIdx = Math.floor(tickerStep / 16) % pChords.length;
            pChords[padIdx].forEach(f => playSaw(ctx, time, f, 0.18, 1400, 0.4));
          }
          if (tickerStep % 4 === 0) {
            const bells = [523.25, 622.25, 783.99, 739.99, 932.33, 1046.50];
            playSine(ctx, time, bells[(tickerStep / 4) % bells.length], 0.25, 0.6);
          }
          if (stepInBar % 4 === 0) playKick(ctx, time, 90, 30, 0.4);
        }
      }

      tickerStep++;
    }, 125);

    drawWaveforms();
  }

  function stopDeckPlayback(deckId) {
    if (clockInterval) { clearInterval(clockInterval); clockInterval = null; }
    if (soundTicker) { clearInterval(soundTicker); soundTicker = null; }
    if (playingDeck === deckId) {
      playingDeck = null;
    }
    const dom = deckDOM[deckId];
    dom.playIcon.textContent = '▶';
    dom.playLabel.textContent = `Play ${deckId === 0 ? 'Baseline' : 'Challenger'}`;
    dom.stopBtn.disabled = true;
    drawWaveforms();
  }

  function seekDeck(deckId, sec) {
    const d = decks[deckId];
    d.currentSec = Math.max(0, Math.min(sec, d.duration));
    updateDeckUI(deckId);
  }

  function selectDeckSection(deckId, secIdx) {
    const d = decks[deckId];
    d.activeSecIdx = secIdx;
    const sec = d.sections[secIdx];
    if (!sec) return;

    activeTargetDeck = deckId;
    selStart = sec.startSec;
    selEnd = sec.endSec;

    // Update section buttons highlight
    deckDOM[deckId].stripButtons.forEach((b, i) => {
      b.classList.toggle(`sec-btn-active-${deckId}`, i === secIdx);
      b.setAttribute('aria-pressed', i === secIdx ? 'true' : 'false');
    });

    seekDeck(deckId, sec.startSec);
    updateTargetDeckUI();
    updateSelectionOverlays();
    generateVibePrompt();
  }

  function updateDeckUI(deckId) {
    const d = decks[deckId];
    const dom = deckDOM[deckId];
    dom.timeDisplay.textContent = `${formatTime(d.currentSec)} / ${formatTime(d.duration)}`;
    const pct = (d.currentSec / d.duration) * 100;
    dom.playhead.style.left = `${pct}%`;
    dom.waveformTrack.setAttribute('aria-valuenow', Math.round(d.currentSec));

    // Detect section changes during playback
    const curIdx = d.sections.findIndex(s => d.currentSec >= s.startSec && d.currentSec < s.endSec);
    if (curIdx !== -1 && curIdx !== d.activeSecIdx && loopingDeck !== deckId) {
      d.activeSecIdx = curIdx;
      dom.stripButtons.forEach((b, i) => {
        b.classList.toggle(`sec-btn-active-${deckId}`, i === curIdx);
        b.setAttribute('aria-pressed', i === curIdx ? 'true' : 'false');
      });
      if (activeTargetDeck === deckId) {
        selStart = d.sections[curIdx].startSec;
        selEnd = d.sections[curIdx].endSec;
        updateSelectionOverlays();
        generateVibePrompt();
      }
    }
  }

  function updateSelectionOverlays() {
    decks.forEach((d, idx) => {
      const dom = deckDOM[idx];
      if (!dom.overlay) return;
      if (activeTargetDeck === idx) {
        const leftPct = (selStart / d.duration) * 100;
        const widthPct = Math.max(0.5, ((selEnd - selStart) / d.duration) * 100);
        dom.overlay.style.left = `${leftPct}%`;
        dom.overlay.style.width = `${widthPct}%`;
        dom.overlay.style.display = 'block';
      } else {
        dom.overlay.style.display = 'none';
      }
    });
    previewRangeBadge.textContent = `${formatTime(selStart)} ── ${formatTime(selEnd)} (${Math.round(selEnd - selStart)}s)`;
  }

  function updateTargetDeckUI() {
    btnSelectDeck0.classList.toggle('active-deck-toggle', activeTargetDeck === 0);
    btnSelectDeck0.setAttribute('aria-pressed', activeTargetDeck === 0 ? 'true' : 'false');
    btnSelectDeck1.classList.toggle('active-deck-toggle', activeTargetDeck === 1);
    btnSelectDeck1.setAttribute('aria-pressed', activeTargetDeck === 1 ? 'true' : 'false');
    activeTargetDeckLabel.textContent = activeTargetDeck === 0
      ? 'Target: DECK 1 (Baseline Ground Truth)'
      : 'Target: DECK 2 (Challenger Single)';
  }

  // Waveform Rendering that respects light/dark theme
  function drawWaveforms() {
    const isLight = getCurrentTheme() === 'light';
    const canvasBg = isLight ? '#f8fafc' : '#07090e';
    const gridLineColor = isLight ? '#e2e8f0' : '#1a2230';
    const baselineColor = isLight ? '#059669' : '#10b981';
    const challengerColor = isLight ? '#0284c7' : '#38bdf8';

    [0, 1].forEach((idx) => {
      const dom = deckDOM[idx];
      const canvas = dom.canvas;
      if (!canvas) return;
      const ctx2d = canvas.getContext('2d');
      const w = canvas.width = canvas.clientWidth;
      const h = canvas.height = canvas.clientHeight;

      ctx2d.fillStyle = canvasBg;
      ctx2d.fillRect(0, 0, w, h);

      if (playingDeck !== idx || !analyser) {
        ctx2d.strokeStyle = gridLineColor;
        ctx2d.lineWidth = 1;
        ctx2d.beginPath();
        ctx2d.moveTo(0, h / 2);
        ctx2d.lineTo(w, h / 2);
        ctx2d.stroke();
        return;
      }

      const bufferLen = analyser.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLen);
      analyser.getByteTimeDomainData(dataArray);

      ctx2d.lineWidth = 1.8;
      ctx2d.strokeStyle = idx === 0 ? baselineColor : challengerColor;
      ctx2d.beginPath();

      const sliceWidth = w / bufferLen;
      let x = 0;
      for (let i = 0; i < bufferLen; i++) {
        const v = dataArray[i] / 128.0;
        const y = (v * h) / 2;
        if (i === 0) ctx2d.moveTo(x, y);
        else ctx2d.lineTo(x, y);
        x += sliceWidth;
      }
      ctx2d.stroke();
    });

    if (playingDeck !== null) {
      requestAnimationFrame(drawWaveforms);
    }
  }

  // Window Resize Listener for Responsive Canvas Dimensions
  window.addEventListener('resize', () => {
    drawWaveforms();
  });

  // Vibe Prompt Generator
  function generateVibePrompt() {
    const d = decks[activeTargetDeck];
    const sec = d.sections[d.activeSecIdx] || d.sections[0];
    const userNote = vibeDirectorNote.value.trim() || 'Sin observaciones adicionales del DG. Proceder con el refinamiento técnico según las rúbricas.';
    const crewString = Array.from(activeCrewRoles).join(', ') || 'DM, CP, SD, AE';
    const formattedStart = formatTime(selStart);
    const formattedEnd = formatTime(selEnd);
    const durSec = Math.round(selEnd - selStart);

    const anchorNotice = includeCountdownAnchor
      ? `- **Patrón Vibe Aprobado (Spine):** Reloj de Cuenta Regresiva (Ticking Clock a semicorcheas de Hans Zimmer, micropaneo estéreo y subgrave 35Hz)`
      : `- **Patrón Vibe Aprobado:** Sin patrón ancla forzado`;

    const deckGovernance = activeTargetDeck === 0
      ? `BASELINE DG COCKPIT (100% Control Directo del DG // Ground Truth Feedback)`
      : `CHALLENGER CREW LAB (80% Autonomía Agéntica L1/L2 en timings, patrones y stems studio)`;

    const mandateNotice = activeTargetDeck === 1
      ? `DM, CP, SD, AE: Proceder con 80% de autonomía compositiva y técnica sobre el rango [${formattedStart} ── ${formattedEnd}]. Aplicar storyboard musical con transiciones fluidas (accelerandos, sweeps de filtro, brechas de 0ms sin cortes abruptos) y producción studio multicapa (7+ stems, -14.0 LUFS ± 0.5, True Peak < -1.0 dBTP). Consolidar informe en L3 QA.`
      : `DM, CP, SD, AE: Ajustar la sección de la Línea Base sobre el rango [${formattedStart} ── ${formattedEnd}] respetando los estándares de producción de estudio profesional (-14.0 LUFS, True Peak < -1.0 dBTP, dinámica y transiciones inteligentes). Consolidar informe en L3 QA.`;

    const promptText = `### VIBE CODING PROMPT // RECOVERY (v0.2.0-beta)
- **Deck Objetivo:** ${d.track.title} [DECK ${activeTargetDeck + 1}]
- **Rango Seleccionado:** ${formattedStart} ── ${formattedEnd} (${durSec} segundos)
- **Gobernanza:** ${deckGovernance}
- **Sección en Foco:** ${sec ? `${sec.tag} — ${sec.name}` : 'Rango Continuo Personalizado'}
- **Tempo / Tonalidad:** ${sec ? `${sec.bpm} BPM // ${sec.keyCenter}` : '105-140 BPM'}
${anchorNotice}
- **Destinatarios Agénticos:** ${crewString}

#### 1. Dirección del Director General (Vibe Prompt):
"${userNote}"

#### 2. Código Strudel Actual de la Sección:
\`\`\`javascript
${sec ? sec.strudelCode.trim() : '// Sin código disponible'}
\`\`\`

#### 3. Mandato para el Crew Multiagente:
${mandateNotice}`;

    promptPreviewOutput.textContent = promptText;
  }

  // Event Listeners: Deck Controls
  [0, 1].forEach((idx) => {
    const dom = deckDOM[idx];
    const d = decks[idx];

    dom.playBtn.addEventListener('click', () => {
      if (playingDeck === idx) {
        stopDeckPlayback(idx);
      } else {
        startDeckPlayback(idx);
      }
    });

    dom.stopBtn.addEventListener('click', () => {
      stopDeckPlayback(idx);
      seekDeck(idx, 0);
    });

    dom.loopBtn.addEventListener('click', () => {
      if (loopingDeck === idx) {
        loopingDeck = null;
        dom.loopLabel.textContent = 'Loop: Off';
        dom.loopBtn.classList.remove('btn-loop-active');
        dom.loopBtn.setAttribute('aria-pressed', 'false');
      } else {
        loopingDeck = idx;
        dom.loopLabel.textContent = `Loop: Sec 0${d.activeSecIdx + 1}`;
        dom.loopBtn.classList.add('btn-loop-active');
        dom.loopBtn.setAttribute('aria-pressed', 'true');
      }
    });

    dom.waveformTrack.addEventListener('click', (e) => {
      const rect = dom.waveformTrack.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const pct = Math.max(0, Math.min(1, clickX / rect.width));
      seekDeck(idx, pct * d.duration);
    });

    // Keyboard navigation on waveform slider
    dom.waveformTrack.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        seekDeck(idx, d.currentSec + 5);
      } else if (e.key === 'ArrowLeft') {
        seekDeck(idx, d.currentSec - 5);
      }
    });

    dom.stripButtons.forEach((btn, sIdx) => {
      btn.addEventListener('click', () => {
        selectDeckSection(idx, sIdx);
      });
    });
  });

  // Target Deck Selector buttons
  btnSelectDeck0.addEventListener('click', () => {
    activeTargetDeck = 0;
    const d = decks[0];
    const sec = d.sections[d.activeSecIdx];
    selStart = sec ? sec.startSec : 0;
    selEnd = sec ? sec.endSec : 75;
    updateTargetDeckUI();
    updateSelectionOverlays();
    generateVibePrompt();
  });

  btnSelectDeck1.addEventListener('click', () => {
    activeTargetDeck = 1;
    const d = decks[1];
    const sec = d.sections[d.activeSecIdx];
    selStart = sec ? sec.startSec : 0;
    selEnd = sec ? sec.endSec : 65;
    updateTargetDeckUI();
    updateSelectionOverlays();
    generateVibePrompt();
  });

  // Approved Vibe Anchor Toggle
  btnToggleAnchor.addEventListener('click', () => {
    includeCountdownAnchor = !includeCountdownAnchor;
    btnToggleAnchor.classList.toggle('anchor-pill-active', includeCountdownAnchor);
    btnToggleAnchor.setAttribute('aria-pressed', includeCountdownAnchor ? 'true' : 'false');
    generateVibePrompt();
  });

  // Crew Routing Pills
  crewChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const role = chip.getAttribute('data-role');
      if (activeCrewRoles.has(role)) {
        activeCrewRoles.delete(role);
        chip.classList.remove('chip-crew-active');
        chip.setAttribute('aria-pressed', 'false');
      } else {
        activeCrewRoles.add(role);
        chip.classList.add('chip-crew-active');
        chip.setAttribute('aria-pressed', 'true');
      }
      generateVibePrompt();
    });
  });

  // Director Note Textarea
  vibeDirectorNote.addEventListener('input', () => {
    generateVibePrompt();
  });

  // 1-Click Copy Prompt Button
  btnCopyVibePrompt.addEventListener('click', async () => {
    const textToCopy = promptPreviewOutput.textContent;
    try {
      await navigator.clipboard.writeText(textToCopy);
      const originalText = btnCopyText.textContent;
      btnCopyText.textContent = '✅ ¡PROMPT COPIADO!';
      btnCopyVibePrompt.classList.add('btn-success-glow');
      setTimeout(() => {
        btnCopyText.textContent = originalText;
        btnCopyVibePrompt.classList.remove('btn-success-glow');
      }, 2500);
    } catch (e) {
      console.warn('Clipboard write error:', e);
    }
  });

  // Init
  const initialTheme = getCurrentTheme();
  applyTheme(initialTheme);
  updateTargetDeckUI();
  updateSelectionOverlays();
  generateVibePrompt();
  drawWaveforms();
</script>

