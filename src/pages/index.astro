    const anchorText = includeCountdownAnchor
      ? 'Reloj de Cuenta Regresiva (Pulso a 16avos &amp; Sub-Bass 35Hz)'
      : 'Sin ancla forzada';

    const secTitle = sec ? `${sec.tag} — ${sec.name}` : 'Rango Continuo Personalizado';
    const bpmVal = sec ? sec.bpm : (activeTargetDeck === 0 ? 138 : 115);
    const keyVal = sec ? sec.keyCenter : 'C menor';
    const deckLabel = activeTargetDeck === 0 ? 'DECK 1' : 'DECK 2';
    const deckRole = activeTargetDeck === 0 ? 'baseline' : 'challenger';
    const governanceMode = activeTargetDeck === 0 ? 'BASELINE_GROUND_TRUTH' : 'CHALLENGER_AUTONOMY';
    const governancePct = activeTargetDeck === 0 ? 0 : 80;

    const roleMeta = {
      DM: { name: 'Music Director', policy: 'Continuous filter sweeps + 1-beat silence dropout' },
      CP: { name: 'Composer / Producer', daw: 'LMMS (.mmp project XML) / Ardour' },
      SD: { name: 'Sound Designer', synth: 'Surge XT Wavetable / FM (12 LFOs)' },
      AE: { name: 'Audio Engineer', dsp: 'ChowTapeModel + Airwindows Slew (-14 LUFS EBU R128)' },
      QA: { name: 'Quality Assurance Auditor', gate: 'Continuous clock audit & gate checklist' }
    };

    let directivesXml = '';
    const allAssignedTagsSet = new Set();

    ['DM', 'CP', 'SD', 'AE', 'QA'].forEach(role => {
      if (!activeCrewRoles.has(role)) return;
      const inputEl = roleInputs[role];
      const instr = (inputEl && inputEl.value.trim()) ? inputEl.value.trim() : 'Ejecutar según rúbrica y brief de dominio.';
      const meta = roleMeta[role] || { name: 'Agent' };
      const roleTags = agentMutationTags[role] || new Set();

      let tagsXml = '';
      if (roleTags.size > 0) {
        tagsXml = '      <assigned_mutation_tags>\n';
        roleTags.forEach(tId => {
          allAssignedTagsSet.add(tId);
          const tDef = tagDefinitions[tId] || { label: tId, desc: tId };
          tagsXml += `        <tag id="${tId}" label="${escapeXml(tDef.label)}">${escapeXml(tDef.desc)}</tag>\n`;
        });
        tagsXml += '      </assigned_mutation_tags>\n';
      }

      directivesXml += `    <role id="${role}" name="${meta.name}">\n`;
      if (tagsXml) directivesXml += tagsXml;
      directivesXml += `      <instruction>${escapeXml(instr)}</instruction>\n`;
      if (meta.policy) directivesXml += `      <transition_policy>${meta.policy}</transition_policy>\n`;
      if (meta.daw) directivesXml += `      <daw_target>${meta.daw}</daw_target>\n`;
      if (meta.synth) directivesXml += `      <synth_engine>${meta.synth}</synth_engine>\n`;
      if (meta.dsp) directivesXml += `      <dsp_chain>${meta.dsp}</dsp_chain>\n`;
      if (meta.gate) directivesXml += `      <gate_policy>${meta.gate}</gate_policy>\n`;
      directivesXml += `    </role>\n`;
    });

    const strudelCode = sec ? sec.strudelCode.trim() : '// Sin código disponible';


    let annotationsXml = '';
    if (directorAnnotations.length > 0) {
      annotationsXml = '\n  <director_timeline_annotations count="' + directorAnnotations.length + '">\n';
      directorAnnotations.forEach((ann, aIdx) => {
        const overlapFlag = ann.hasOverlap ? ' overlap_detected="true" transition_requirement="equal_power_crossfader"' : '';
        annotationsXml += `    <annotation id="ann-${aIdx + 1}" start="${ann.startStr}" end="${ann.endStr}" duration_sec="${ann.durSec}"${overlapFlag}>\n`;
        annotationsXml += `      <note>${escapeXml(ann.note)}</note>\n`;
        if (ann.hasOverlap) {
          annotationsXml += `      <crossfader_hint>Superposición de tiempos detectada con otra sección: aplicar curva de crossfade Equal-Power o S-Curve sin corte abrupto.</crossfader_hint>\n`;
        }
        annotationsXml += `    </annotation>\n`;
      });
      annotationsXml += '  </director_timeline_annotations>\n';
    }

    let tagsSummaryXml = '';
    allAssignedTagsSet.forEach(tId => {
      const tDef = tagDefinitions[tId] || { label: tId, desc: tId };
      tagsSummaryXml += `      <mutation_operator dimension="${tId}" label="${escapeXml(tDef.label)}">\n        ${escapeXml(tDef.desc)}\n      </mutation_operator>\n`;
    });

    const verdictDescriptions = {
      REQUEST_ITERATION: 'Continuar mutando el Challenger actual con las directivas especificadas sin promover aún.',
      PROMOTE_TO_CHAMPION: 'El Challenger ha superado al Champion actual. Promover a nuevo Baseline Ground Truth y fijar como referencia.',
      REJECT_CHALLENGER: 'El Challenger no cumplió los objetivos estéticos/técnicos. Descartar mutación y restaurar último Champion estable.'
    };

    const secIdVal = sec ? sec.id : 'custom';
    // SHA256 / FNV-1a deterministic hash for section content idempotency
    let hashVal = 0x811c9dc5;
    const hashPayload = `${secIdVal}:${bpmVal}:${formattedStart}-${formattedEnd}:${strudelCode.slice(0, 100)}`;
    for (let i = 0; i < hashPayload.length; i++) {
      hashVal ^= hashPayload.charCodeAt(i);
      hashVal = Math.imul(hashVal, 0x01000193);
    }
    const secContentHash = 'sha256-' + (hashVal >>> 0).toString(16).padStart(8, '0');
    const idempotencyKey = `dispatch-${nowIso.replace(/[:.]/g, '')}-${secIdVal}-${durSec}`;

    let singleCompiledArchXml = '';
    if (activeTargetDeck === 1 || d.track.masterCompiledStrudelCode) {
      singleCompiledArchXml = `\n  <single_compiled_architecture status="ACTIVE" engine="Strudel-REPL-Arranger">
    <compilation_mode>CONTINUOUS_CHAINED_SUITE</compilation_mode>
    <transition_model>DUAL_PLANE_EQUAL_POWER_CROSSFADER (gain_out^2 + gain_in^2 == 1.0)</transition_model>
    <preserved_sections count="2">
      <section id="sec-ng-01" role="seed_anchor">Construcción Progresiva: Tema Aprobado &amp; Campanas OoT (00:00 - 02:00 // 105 BPM)</section>
      <section id="sec-ng-07" role="seed_anchor">Catarsis Monumental Transmutada &amp; Gran Fuga Sideral (04:35 - 07:15 // 105 BPM)</section>
    </preserved_sections>
    <destroyed_sections count="5">
      <section id="sec-ng-02" status="DESTROYED">Breakbeat Progresivo &amp; Guzheng Granular (Destruido por corte abrupto // Reemplazado por Puente Morfogenético)</section>
      <section id="sec-ng-03" status="DESTROYED">Coro Polifónico IA 2026 &amp; Duduk Sintético (Destruido)</section>
      <section id="sec-ng-04" status="DESTROYED">Percusión Gamelan &amp; Furia Industrial (Destruido)</section>
      <section id="sec-ng-05" status="DESTROYED">Surgical FM Neuro Drop (Destruido)</section>
      <section id="sec-ng-06" status="DESTROYED">Convergencia Transcultural (Destruido)</section>
    </destroyed_sections>
    <synthesized_bridge id="sec-ng-bridge" status="ACTIVE">
      Mutación Radical: Apagón de Bajo, Surge XT FM Growl &amp; Breakbeat (02:00 - 04:35 // 118 BPM)
    </synthesized_bridge>
  </single_compiled_architecture>\n`;
    }

    const codeToDisplay = (previewCodeMode === 'master' && d.track.masterCompiledStrudelCode)
      ? d.track.masterCompiledStrudelCode.trim()
      : strudelCode;

    let codeBlocksXml = '';
    if (d.track.masterCompiledStrudelCode && previewCodeMode === 'master') {
      codeBlocksXml = `  <master_compiled_strudel_code engine="Strudel-REPL-Arranger" mode="CHAINED_SUITE">
<![CDATA[
${codeToDisplay}
]]>
  </master_compiled_strudel_code>`;
    } else {
      codeBlocksXml = `  <current_strudel_seed section_id="${secIdVal}" mode="${previewCodeMode}">
<![CDATA[
${codeToDisplay}
]]>
  </current_strudel_seed>`;
    }

    const xmlOutput = `<?xml version="1.0" encoding="UTF-8"?>
<vibe_dispatch version="1.0">
  <metadata>
    <timestamp>${nowIso}</timestamp>
    <idempotency_key>${idempotencyKey}</idempotency_key>
    <deck_target id="deck-${activeTargetDeck + 1}" role="${deckRole}">${escapeXml(d.track.title)} [${deckLabel}]</deck_target>
    <selected_range start="${formattedStart}" end="${formattedEnd}" duration_sec="${durSec}"/>
    <section_focus id="${secIdVal}" content_hash="${secContentHash}" bpm="${bpmVal}" key="${escapeXml(keyVal)}">${escapeXml(secTitle)}</section_focus>
    <governance mode="${governanceMode}" crew_autonomy_pct="${governancePct}">
      ${activeTargetDeck === 0 ? '100% DG Ground Truth Feedback' : '80% Autonomía Agéntica en timings, timbres y stems studio'}
    </governance>
    <vibe_anchor id="reloj_cuenta_regresiva" status="${anchorStatus}">
      ${anchorText}
    </vibe_anchor>
  </metadata>

  <evolution_gate>
    <medallion_tier target_sec_id="${secIdVal}">${activeVerdictDecision === 'PROMOTE_TO_CHAMPION' ? 'GOLD' : 'SILVER'}</medallion_tier>
    <idempotent_lifecycle_intent action="${activeVerdictDecision === 'PROMOTE_TO_CHAMPION' ? 'PROMOTE_GOLD' : (activeVerdictDecision === 'REJECT_CHALLENGER' ? 'DESTROY_MUTANT' : 'MUTATE_SILVER')}" target_sec_id="${secIdVal}" content_hash="${secContentHash}"/>
    <active_mutation_tags count="${allAssignedTagsSet.size}">
${tagsSummaryXml || '      <tag id="NONE">Sin tags asignados</tag>\n'}    </active_mutation_tags>
    <governance_verdict decision="${activeVerdictDecision}">
      ${escapeXml(verdictDescriptions[activeVerdictDecision] || activeVerdictDecision)}
    </governance_verdict>
  </evolution_gate>

  <director_intent>
    ${escapeXml(userNote)}
  </director_intent>${annotationsXml}
  <agent_directives>
    <!-- Mandato para el Crew Multiagente -->
${directivesXml}  </agent_directives>

  <open_source_stack>
    <daw>LMMS (.mmp XML) / Ardour</daw>
    <synths>Surge XT (12 LFOs, Wavetable/FM) / Cardinal Modular</synths>
    <dsp_fx>Chowdhury DSP (ChowTapeModel, Centaur) / Airwindows (Slew, Density)</dsp_fx>
    <transition_rules>
      <rule>Exponential parameter ramps (4-8 bars lookahead before transitions)</rule>
      <rule>Continuous ticking clock spine preservation across act boundaries</rule>
      <rule>Dual-Plane Equal-Power Crossfading: gain_out = cos(p*PI/2), gain_in = sin(p*PI/2)</rule>
      <rule>Reverb tail preservation (never mute outgoing audio abruptly)</rule>
      <rule>Tension breath: 1-beat zero-amplitude silence before primary drop</rule>
    </transition_rules>
  </open_source_stack>${singleCompiledArchXml}
${codeBlocksXml}
</vibe_dispatch>`;

    promptPreviewOutput.textContent = xmlOutput;
  }

  // Event Listeners: Preview Mode Toggles (Single Compilado Maestro vs Sección Foco)
  if (btnToggleMasterCode && btnToggleSectionCode) {
    btnToggleMasterCode.addEventListener('click', () => {
      previewCodeMode = 'master';
      btnToggleMasterCode.classList.add('active-preview-mode');
      btnToggleMasterCode.setAttribute('aria-pressed', 'true');
      btnToggleSectionCode.classList.remove('active-preview-mode');
      btnToggleSectionCode.setAttribute('aria-pressed', 'false');
      generateVibePrompt();
