    if (ctxMuteLabel) {
      ctxMuteLabel.textContent = tracksMuted[selectedTrackIdx] ? 'Desmutear Pista' : 'Silenciar Pista (Mute)';
    }
  }

  channelToggleButtons.forEach((btn) => {
