---
import Layout from '../layouts/Layout.astro';
import { TRACKS, SONG_SECTIONS, TRACK_VARIATIONS, SPLINTERNET_SECTIONS, SPLINTERNET_VARIATIONS } from '../data/tracks';
import { METACATEGORIES } from '../data/categories';

const tracksData = TRACKS;
const categoriesData = METACATEGORIES;
---

<Layout
  title="RECOVERY // Studio Deck v0.2.0-beta — Champion Rebase & Arranger Lab"
  description="Mesa de producción musical en vivo (v0.2.0-beta), timeline interactivo drag-and-drop, banco de mutaciones local y generador de prompts inteligentes."
>
  <div class="studio-container">
    <!-- Header -->
    <header class="studio-header">
      <div class="studio-title-group">
        <h1 class="studio-title">RECOVERY</h1>
        <span class="beta-badge mono">v0.2.0-beta</span>
        <span class="studio-tag" id="current-track-tag">BASELINE // CHAMPION REBASE</span>
      </div>

      <div class="header-right-group">
        <a
          href="https://github.com/willkwolf/Recovery-album"
          target="_blank"
          rel="noopener noreferrer"
          class="studio-repo-link mono"
        >
          GitHub Repo ↗
        </a>
      </div>
    </header>

    <!-- High-Level Dual Navigation Tabs (Baseline vs Challenger) -->
    <nav class="primary-tabs-nav" aria-label="Navegación principal de pistas">
      <button type="button" class="tab-main-btn tab-main-active" id="btn-tab-baseline" data-track-index="0">
        <span class="mono tab-icon">🏆</span>
        <div class="tab-text-group">
          <span class="tab-title">TAB 1: BASELINE // CHAMPION REBASE</span>
          <span class="tab-sub mono">Rave de Reciclaje (138 BPM) ──► Fork C Mutante (110 BPM)</span>
        </div>
      </button>

      <button type="button" class="tab-main-btn" id="btn-tab-challenger" data-track-index="1">
        <span class="mono tab-icon">⚡</span>
        <div class="tab-text-group">
          <span class="tab-title">TAB 2: CHALLENGER // SPLINTERNET</span>
          <span class="tab-sub mono">Suite Multi-Género en 5 Actos (04:45 min)</span>
        </div>
      </button>
    </nav>

    <!-- Lifecycle Status Bar -->
    <div class="lifecycle-bar">
      <div class="lifecycle-label-group">
        <span class="mono label-muted">ESTADO DE CICLO DE VIDA:</span>
        <span class="mono active-track-badge" id="active-track-name">Track 01: Backup // Champion Rebase (:Victory)</span>
      </div>
      <div class="lifecycle-nav" id="lifecycle-nav-container">
        <button type="button" class="btn btn-sm btn-active" id="tab-mutacion" data-mode="mutacion">
          <span class="status-indicator ind-mutacion"></span>
          <span id="tab-mutacion-label">:Victory (Champion Base)</span>
        </button>
        <button type="button" class="btn btn-sm" id="tab-challenger" data-mode="challenger">
          <span class="status-indicator ind-challenger"></span>
          <span id="tab-challenger-label">:Challenger (Suite Completa)</span>
        </button>
        <button type="button" class="btn btn-sm" id="tab-exp" data-mode="exp">
          <span class="status-indicator ind-exp"></span>
          <span id="tab-exp-label">:Experimentacion (Bocetos)</span>
        </button>
      </div>
    </div>

    <!-- Transport & Master Deck -->
    <section class="deck-card">
      <div class="deck-top">
        <div class="transport-controls">
          <button type="button" class="btn btn-primary" id="btn-play" aria-label="Reproducir o pausar">
            <span id="play-icon">▶</span>
            <span id="play-label">Play</span>
          </button>
          <button type="button" class="btn" id="btn-stop" disabled aria-label="Detener">
            <span>■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn" id="btn-loop-sec" aria-label="Alternar bucle de sección">
            <span>🔁</span>
            <span id="loop-label">Loop: Off</span>
          </button>
        </div>

        <div class="deck-meta">
          <div class="time-display mono" id="time-display">00:00 / 05:15</div>
          <div class="active-sec-badge mono" id="active-sec-badge">SEC 01: Rave de Reciclaje (138 BPM)</div>
        </div>

        <div class="volume-control">
          <span class="mono label-muted">VOL</span>
          <input type="range" id="vol-slider" min="0" max="1" step="0.05" value="0.8" aria-label="Volumen general" />
          <span id="vol-val" class="mono label-muted">80%</span>
        </div>
      </div>

      <!-- Scrubber & Waveform Visualizer with Selection Overlay -->
      <div class="waveform-container" id="waveform-track" title="Haz clic en cualquier punto para mover el cabezal o ajustar selección">
        <canvas id="waveform-canvas" height="64"></canvas>
        <div class="selection-overlay" id="selection-overlay"></div>
        <div class="playhead" id="playhead"></div>
      </div>

      <!-- Arranger Toolbar (Drag & Drop Actions & Storage) -->
      <div class="arranger-toolbar">
        <div class="arranger-info">
          <span class="mono label-muted">TIMELINE INTERACTIVO:</span>
          <span class="mono text-xs text-muted">Arrastra los bloques para reordenar la secuencia en vivo</span>
        </div>
        <div class="arranger-actions">
          <button type="button" class="btn btn-xs" id="btn-reset-timeline" title="Restaurar orden original">
            <span>↺</span>
            <span>Resetear Orden</span>
          </button>
          <button type="button" class="btn btn-xs" id="btn-save-mutation-bank" title="Guardar orden actual en el banco local de mutaciones">
            <span>💾</span>
            <span id="btn-save-bank-text">Guardar en Banco</span>
          </button>
          <button type="button" class="btn btn-xs" id="btn-export-session" title="Exportar configuración de timeline a archivo JSON">
            <span>📥</span>
            <span>Exportar JSON</span>
          </button>
          <label class="btn btn-xs btn-file-label" title="Cargar configuración de timeline desde archivo JSON">
            <span>📤</span>
            <span>Importar JSON</span>
            <input type="file" id="file-import-session" accept=".json" style="display: none;" />
          </label>
        </div>
      </div>

      <!-- Interactive Arranger Strip with Native HTML5 Drag & Drop -->
      <div class="sections-strip" id="challenger-strip">
        <!-- Rendered dynamically with draggable blocks -->
      </div>
    </section>

    <!-- BANCO DE MUTACIONES APROBADAS (CLIPS & REUTILIZACIÓN) -->
    <section class="mutation-bank-card" id="mutation-bank-section">
      <div class="bank-header">
        <div class="bank-title-group">
          <span class="mono bank-tag">LOCAL STORAGE // MUTATION BANK</span>
          <h2 class="bank-heading">Banco de Mutaciones Aprobadas & Repositorio de Clips</h2>
          <p class="bank-subheading">
            Tus mutaciones aprobadas quedan guardadas en el navegador (sin necesidad de servidor). Arrastra un clip hacia el timeline o haz clic para insertarlo.
          </p>
        </div>
        <div class="bank-stats mono text-xs text-muted" id="bank-count-label">
          Clips disponibles: 8
        </div>
      </div>

      <div class="bank-grid" id="bank-clips-container">
        <!-- Rendered dynamically via JS -->
      </div>
    </section>

    <!-- SMART SELECTION & FEEDBACK PROMPT TOOL -->
    <section class="smart-tool-card" id="smart-selection-tool">
      <div class="tool-header">
        <div class="tool-title-group">
          <div class="tool-badge-row">
            <span class="tool-badge mono">PRODUCER SELECTION TOOL</span>
            <span class="mono text-xs text-muted" id="tool-active-track-label">Target: Backup // Champion Rebase</span>
          </div>
          <h2 class="tool-heading">Selector de Secciones & Generador de Prompt Inteligente</h2>
          <p class="tool-subheading">
            Selecciona el corte temporal, activa metacategorías y exponentes, y copia el prompt formateado para traerlo directamente a Antigravity.
          </p>
        </div>
        <div class="tool-header-actions">
          <button type="button" class="btn btn-sm" id="btn-preview-range" title="Reproducir sólo el rango temporal seleccionado">
            <span>▶</span>
            <span>Preescuchar Rango</span>
          </button>
          <button type="button" class="btn btn-primary btn-copy-prompt" id="btn-copy-smart-prompt" title="Copiar bloque de prompt estructurado para pegar en Antigravity">
            <span>📋</span>
            <span id="copy-prompt-btn-text">Copiar Prompt Inteligente</span>
          </button>
        </div>
      </div>

      <div class="tool-body">
        <!-- Range Scrubber Grid -->
        <div class="tool-range-grid">
          <div class="range-field">
            <div class="range-field-top">
              <label for="range-start-slider" class="mono label-muted">PUNTO DE ENTRADA (INICIO):</label>
              <span id="label-start-time" class="mono time-badge">00:00</span>
            </div>
            <input type="range" id="range-start-slider" min="0" max="315" value="0" step="1" class="time-range-slider" />
          </div>

          <div class="range-divider-box mono">
            <span class="label-muted">DURACIÓN</span>
            <span id="label-range-dur" class="font-bold text-accent">75s</span>
          </div>

          <div class="range-field">
            <div class="range-field-top">
              <label for="range-end-slider" class="mono label-muted">PUNTO DE SALIDA (FIN):</label>
              <span id="label-end-time" class="mono time-badge">01:15</span>
            </div>
            <input type="range" id="range-end-slider" min="0" max="315" value="75" step="1" class="time-range-slider" />
          </div>
        </div>

        <!-- Quick Section Chips -->
        <div class="tool-section-chips-row">
          <span class="mono label-muted">SALTO RÁPIDO A SECCIÓN:</span>
          <div class="section-quick-chips" id="section-quick-chips">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- METACATEGORÍAS & EXPONENTES SELECTOR -->
        <div class="metacategories-wrapper">
          <div class="meta-tabs-header">
            <span class="mono label-muted">METACATEGORÍAS DE REFERENCIA:</span>
            <span class="mono text-xs text-muted">Selecciona una categoría para explorar sus mejores exponentes</span>
          </div>

          <div class="metacategories-tabs" id="metacategories-tabs">
            {categoriesData.map((cat, idx) => (
              <button
                type="button"
                class={`meta-cat-btn ${idx === 0 ? 'meta-cat-active' : ''}`}
                data-cat-id={cat.id}
              >
                <span>{cat.icon}</span>
                <span>{cat.name}</span>
              </button>
            ))}
          </div>

          <!-- Exponents Chips Container -->
          <div class="exponents-deck" id="exponents-deck">
            <!-- Populated dynamically based on active category -->
          </div>

          <!-- Tactical Sound Modifiers -->
          <div class="tactical-modifiers-row">
            <span class="mono label-muted">MODIFICADORES TÁCTICOS:</span>
            <div class="modifier-pills" id="modifier-pills">
              <button type="button" class="pill-btn" data-tag="[+ Sub-Bass 35Hz]">🔊 Sub-Bass 35Hz</button>
              <button type="button" class="pill-btn" data-tag="[+ Silencio Puro 0ms]">🔇 Silencio Puro 0ms</button>
              <button type="button" class="pill-btn" data-tag="[+ Más Disonancia F#]">⚠️ Tritono Disonante F#</button>
              <button type="button" class="pill-btn" data-tag="[+ Rampa Desaceleración]">📉 Rampa Desaceleración Métrica</button>
              <button type="button" class="pill-btn" data-tag="[+ Acelerar BPM]">⏩ Subir Tempo / BPM</button>
              <button type="button" class="pill-btn" data-tag="[+ Reducir BPM]">⏪ Bajar Tempo / BPM</button>
              <button type="button" class="pill-btn" data-tag="[+ Mutar a Challenger]">🧬 Mutar a :Challenger</button>
            </div>
          </div>
        </div>

        <!-- Target Crew Agent Routing -->
        <div class="tool-routing-row">
          <span class="mono label-muted">DESTINATARIOS AGÉNTICOS (CREW):</span>
          <div class="crew-pills" id="crew-pills">
            <button type="button" class="pill-crew pill-crew-active" data-role="DM">L1 · DM (Dirección Musical)</button>
            <button type="button" class="pill-crew pill-crew-active" data-role="CP">L2 · CP (Composición)</button>
            <button type="button" class="pill-crew pill-crew-active" data-role="SD">L2 · SD (Diseño Sonoro)</button>
            <button type="button" class="pill-crew" data-role="AE">L2 · AE (Ingeniería Audio)</button>
            <button type="button" class="pill-crew" data-role="QA">L3 · QA (Auditoría Gate)</button>
          </div>
        </div>

        <!-- Producer Note Textarea -->
        <div class="tool-note-row">
          <label for="tool-producer-note" class="mono label-muted">DIRECCIÓN TÁCTICA DEL DIRECTOR GENERAL (DG):</label>
          <textarea
            id="tool-producer-note"
            rows="2"
            class="producer-textarea mono"
            placeholder="Escribe tus observaciones para esta sección (ej: 'Comenzamos con el Rave de Reciclaje, pero quiero que la desaceleración métrica a Fork C tenga más dither')..."
          ></textarea>
        </div>

        <!-- Live Formatted Prompt Preview -->
        <div class="tool-prompt-preview">
          <div class="preview-header">
            <span class="mono label-muted">PROMPT ESTRUCTURADO PARA ANTIGRAVITY (VISTA PREVIA):</span>
            <span class="mono text-xs text-muted">Se sincroniza automáticamente</span>
          </div>
          <pre class="prompt-preview-block mono"><code id="prompt-preview-code">Generando prompt...</code></pre>
        </div>
      </div>
    </section>

    <!-- Section / Variation Detail Drawer (Inspection Deck) -->
    <section class="drawer-card">
      <div class="drawer-header">
        <div class="drawer-title-group">
          <span class="mono drawer-tag" id="drawer-tag">:Victory // CHAMPION BASELINE</span>
          <h2 class="drawer-name" id="drawer-name">Champion Baseline Rebase (Rave -> Transición -> Fork C)</h2>
          <span class="mono drawer-time" id="drawer-time">00:00 ── 05:15</span>
        </div>
        <button type="button" class="btn btn-sm btn-active" id="btn-copy-ref" title="Copiar referencia al portapapeles">
          <span>📋</span>
          <span id="copy-ref-text">Copiar ref al portapapeles</span>
        </button>
      </div>

      <div class="drawer-body">
        <div class="drawer-meta-row">
          <div>
            <span class="label-muted mono">ESTADO HITL:</span>
            <span class="mono font-bold" id="drawer-lifecycle">:Victory (Aprobada)</span>
          </div>
          <div>
            <span class="label-muted mono">TEMPO / TONALIDAD:</span>
            <span class="mono" id="drawer-tempo">138 BPM -> 110 BPM // D menor Acid a C menor Fork</span>
          </div>
          <div>
            <span class="label-muted mono">ELEMENTOS CLAVE:</span>
            <span id="drawer-inst">Roland TR-909 Kick, TB-303 Acid Resonant, F# Tritone Capsule, Sawtooth Dyads, Rimshot 5-tuplet</span>
          </div>
        </div>

        <p class="drawer-desc" id="drawer-desc">
          NUEVO CHAMPION DEFINITIVO. Invierte la estructura narrativa: arranca en la catarsis combativa del Rave de 138 BPM, modula métricamente a través de la cápsula de transporte (F# pivote) y aterriza en la pureza polirrítmica del Fork C.
        </p>

        <!-- Collapsible Strudel Code View -->
        <details class="code-details">
          <summary class="mono code-summary">
            <span>Ver código Strudel</span>
            <a
              id="drawer-repl-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="mono repl-link"
            >
              Abrir en Strudel REPL ↗
            </a>
          </summary>
          <pre class="code-block mono"><code id="drawer-code"></code></pre>
        </details>
      </div>
    </section>

    <!-- Footer minimal -->
    <footer class="studio-footer mono">
      <span>RECOVERY // ARTISTIC MULTI-AGENT SYSTEM (v0.2.0-beta)</span>
      <span>Genealogía HITL: :Experimentacion → :Mutacion → :Challenger → :Victory</span>
    </footer>
  </div>
</Layout>

<script define:vars={{ tracksData, categoriesData }}>
  // State variables
  let currentTrackIdx = 0; // 0: Baseline Champion, 1: Challenger Splinternet
  let currentMode = 'mutacion'; // 'mutacion' | 'challenger' | 'exp'
  let isPlaying = false;
  let isLoopingSection = false;
  let isPreviewingRange = false;
  let activeSectionIndex = 0;
  let trackSeconds = 0;
  let totalDuration = 315;

  // Working arrangement copy for Drag & Drop reordering
  let workingSections = JSON.parse(JSON.stringify(tracksData[currentTrackIdx].sections || []));

  // Smart Selection Tool State
  let selectionStart = 0;
  let selectionEnd = 75;
  let activeCategoryIdx = 0;
  let activeDirectives = new Set();
  let activeCrewRoles = new Set(['DM', 'CP', 'SD']);

  // Web Audio Context & Nodes
  let audioCtx = null;
  let analyser = null;
  let masterGain = null;
  let clockInterval = null;
  let soundTicker = null;
  let delayNode = null;
  let feedbackGain = null;

  // DOM Elements
  const btnTabBaseline = document.getElementById('btn-tab-baseline');
  const btnTabChallenger = document.getElementById('btn-tab-challenger');
  const currentTrackTag = document.getElementById('current-track-tag');
  const activeTrackName = document.getElementById('active-track-name');
  const toolActiveTrackLabel = document.getElementById('tool-active-track-label');

  const tabMutacion = document.getElementById('tab-mutacion');
  const tabChallenger = document.getElementById('tab-challenger');
  const tabExp = document.getElementById('tab-exp');
  const tabMutacionLabel = document.getElementById('tab-mutacion-label');
  const tabChallengerLabel = document.getElementById('tab-challenger-label');
  const tabExpLabel = document.getElementById('tab-exp-label');

  const challengerStrip = document.getElementById('challenger-strip');
  const btnResetTimeline = document.getElementById('btn-reset-timeline');
  const btnSaveMutationBank = document.getElementById('btn-save-mutation-bank');
  const btnSaveBankText = document.getElementById('btn-save-bank-text');
  const btnExportSession = document.getElementById('btn-export-session');
  const fileImportSession = document.getElementById('file-import-session');
  const bankClipsContainer = document.getElementById('bank-clips-container');
  const bankCountLabel = document.getElementById('bank-count-label');

  const playBtn = document.getElementById('btn-play');
  const stopBtn = document.getElementById('btn-stop');
  const playIcon = document.getElementById('play-icon');
  const playLabel = document.getElementById('play-label');
  const loopBtn = document.getElementById('btn-loop-sec');
  const loopLabel = document.getElementById('loop-label');
  const timeDisplay = document.getElementById('time-display');
  const activeSecBadge = document.getElementById('active-sec-badge');
  const volSlider = document.getElementById('vol-slider');
  const volVal = document.getElementById('vol-val');
  const waveformTrack = document.getElementById('waveform-track');
  const playhead = document.getElementById('playhead');
  const selectionOverlay = document.getElementById('selection-overlay');
  const canvas = document.getElementById('waveform-canvas');
  const canvasCtx = canvas.getContext('2d');

  // Tool Elements
  const rangeStartSlider = document.getElementById('range-start-slider');
  const rangeEndSlider = document.getElementById('range-end-slider');
  const labelStartTime = document.getElementById('label-start-time');
  const labelEndTime = document.getElementById('label-end-time');
  const labelRangeDur = document.getElementById('label-range-dur');
  const sectionQuickChips = document.getElementById('section-quick-chips');
  const metacategoriesTabs = document.getElementById('metacategories-tabs');
  const exponentsDeck = document.getElementById('exponents-deck');
  const modifierPills = document.querySelectorAll('.modifier-pills .pill-btn');
  const crewPills = document.querySelectorAll('.pill-crew');
  const producerNoteTextarea = document.getElementById('tool-producer-note');
  const promptPreviewCode = document.getElementById('prompt-preview-code');
  const btnCopySmartPrompt = document.getElementById('btn-copy-smart-prompt');
  const copyPromptBtnText = document.getElementById('copy-prompt-btn-text');
  const btnPreviewRange = document.getElementById('btn-preview-range');

  // Drawer Elements
  const drawerTag = document.getElementById('drawer-tag');
  const drawerName = document.getElementById('drawer-name');
  const drawerTime = document.getElementById('drawer-time');
  const drawerLifecycle = document.getElementById('drawer-lifecycle');
  const drawerTempo = document.getElementById('drawer-tempo');
  const drawerInst = document.getElementById('drawer-inst');
  const drawerDesc = document.getElementById('drawer-desc');
  const drawerCode = document.getElementById('drawer-code');
  const drawerReplLink = document.getElementById('drawer-repl-link');
  const btnCopyRef = document.getElementById('btn-copy-ref');
  const copyRefText = document.getElementById('copy-ref-text');

  function getActiveTrack() {
    return tracksData[currentTrackIdx];
  }

  function formatTime(sec) {
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  // Local Storage Mutation Bank
  const DEFAULT_MUTATION_BANK = [
    {
      id: 'clip-rave-reciclaje',
      name: 'Rave de Reciclaje (138 BPM)',
      category: 'Techno / Acid Rave',
      tag: '[SECCIÓN RAVE 138 BPM]',
      duration: 75,
      instruments: 'TR-909 Kick, TB-303 Acid, Distorted Stabs',
      code: `stack(s("bd*4").bank("RolandTR909"), note("d2 [d2 f2] g2").s("sawtooth").lpf(1800).resonance(16))`
    },
    {
      id: 'clip-transporte-fsharp',
      name: 'Cápsula de Transporte (138->110 BPM)',
      category: 'Transición Inteligente',
      tag: '[TRANSICIÓN F# 138->110]',
      duration: 35,
      instruments: 'Filtered 909 Kick, Dither Sweep, F# Tritone Drone',
      code: `stack(s("bd [~ bd]").lpf(300), note("<[fs2,c3]>").s("sawtooth").lpf(950), s("rim*5").gain(0.6))`
    },
    {
      id: 'clip-fork-c-alfa',
      name: 'Fork C Mutante Alfa (110 BPM)',
      category: 'Baseline Mutante',
      tag: '[FORK C MUTANTE ALFA]',
      duration: 75,
      instruments: 'Sawtooth Chords LFO, Melody 1.75, TR-909, 3v7 Hats',
      code: `stack(note("<[c2,g2] [eb2,bb2] [f2,c3] [fs2,c3]>").s("sawtooth"), note("c4 eb4 g4 fs4 bb4 d5 c5").fast(1.75))`
    },
    {
      id: 'clip-mutation-neuro-acid',
      name: 'Mutación: Neuro-Acid Infusion',
      category: 'Bass Music x Techno',
      tag: '[MUTACIÓN 01: NEURO-ACID]',
      duration: 45,
      instruments: 'Roland 909 + Skrillex Modulated FM Bass',
      code: `stack(s("bd*4").gain(1.0), note("d2 [d2 f2] g2").s("sawtooth").lpf(perlin.range(500, 4200)).resonance(22))`
    },
    {
      id: 'clip-mutation-tritone-pedal',
      name: 'Mutación: Tritone F# Lockdown',
      category: 'Armonía / Disonancia',
      tag: '[MUTACIÓN 02: TRITONE LOCKDOWN]',
      duration: 50,
      instruments: 'Persistent F# Sub-Drone + Disonancia C-F#',
      code: `stack(note("fs1").s("sine").gain(0.8), note("<[c2,g2] [fs2,c3]>").s("sawtooth"))`
    },
    {
      id: 'clip-mutation-brutalist-drop',
      name: 'Mutación: Brutalist 0ms Drop-Cut',
      category: 'Rock / Hardcore',
      tag: '[MUTACIÓN 03: BRUTALIST DROP]',
      duration: 30,
      instruments: 'Corte a Silencio Puro 0ms (Code Orange) + Server Hum',
      code: `cat(s("bd*4").gain(1.0).fast(2), s("~").gain(0), note("c2").s("sawtooth"))`
    },
    {
      id: 'clip-skrillex-growl',
