  function selectSection(index, seek = false) {
    activeSectionIndex = index;
    const sec = workingSections[index];
    if (!sec) return;

    const allBlocks = challengerStrip.querySelectorAll('.section-block');
    allBlocks.forEach((b, i) => b.classList.toggle('selected', i === index));

    const allChips = sectionQuickChips.querySelectorAll('.quick-chip-btn');
    allChips.forEach((c, i) => c.classList.toggle('quick-chip-active', i === index));

    activeSecBadge.textContent = `SEC 0${index + 1}: ${sec.name.split('(')[0].trim()}`;
    drawerTag.textContent = ':Arranger // SECCIÓN ACTIVA';
    drawerName.textContent = sec.name;
    drawerTime.textContent = `${sec.startTime} ── ${sec.endTime}`;
    drawerLifecycle.textContent = ':Arranger Timeline';
    drawerTempo.textContent = `${sec.bpm} BPM // ${sec.keyCenter}`;
    drawerInst.textContent = Array.isArray(sec.instruments) ? sec.instruments.join(', ') : sec.instruments;
    drawerDesc.textContent = sec.description;
    drawerCode.textContent = sec.strudelCode;
    drawerReplLink.href = `https://strudel.cc/#${encodeURIComponent(sec.strudelCode)}`;

    if (seek) {
      seekTo(sec.startSec);
    }
    generateSmartPrompt();
  }

  function setSelectionRange(start, end) {
    selectionStart = Math.max(0, Math.min(start, totalDuration));
    selectionEnd = Math.max(selectionStart + 1, Math.min(end, totalDuration));
    updateToolScrubbers();
    updateSelectionOverlay();
    generateSmartPrompt();
  }

  function updateToolScrubbers() {
    rangeStartSlider.max = totalDuration;
    rangeEndSlider.max = totalDuration;
    rangeStartSlider.value = selectionStart;
    rangeEndSlider.value = selectionEnd;
    labelStartTime.textContent = formatTime(selectionStart);
    labelEndTime.textContent = formatTime(selectionEnd);
    labelRangeDur.textContent = `${Math.round(selectionEnd - selectionStart)}s`;
  }

  function updateSelectionOverlay() {
    if (!selectionOverlay) return;
    const leftPct = (selectionStart / totalDuration) * 100;
    const widthPct = Math.max(0.5, ((selectionEnd - selectionStart) / totalDuration) * 100);
    selectionOverlay.style.left = `${leftPct}%`;
    selectionOverlay.style.width = `${widthPct}%`;
    selectionOverlay.style.display = 'block';
  }

  function seekTo(sec) {
    trackSeconds = Math.max(0, Math.min(sec, totalDuration));
    updateUI();
  }

  function updateUI() {
    timeDisplay.textContent = `${formatTime(trackSeconds)} / ${formatTime(totalDuration)}`;
    const pct = (trackSeconds / totalDuration) * 100;
    playhead.style.left = `${pct}%`;

    const curIdx = workingSections.findIndex((s) => trackSeconds >= s.startSec && trackSeconds < s.endSec);
    if (curIdx !== -1 && curIdx !== activeSectionIndex && !isLoopingSection && !isPreviewingRange) {
      selectSection(curIdx, false);
    }
    updateSelectionOverlay();
  }

  // Intelligent Prompt Generator
  function generateSmartPrompt() {
    const track = getActiveTrack();
    const activeSec = workingSections[activeSectionIndex] || workingSections[0];

    const formattedStart = formatTime(selectionStart);
    const formattedEnd = formatTime(selectionEnd);
    const durSec = Math.round(selectionEnd - selectionStart);

    const tagsArray = Array.from(activeDirectives);
    const tagsString = tagsArray.length > 0 ? tagsArray.join(' ') : '[Sin directivas adicionales seleccionadas]';
    const crewString = Array.from(activeCrewRoles).join(', ');
    const userNote = producerNoteTextarea.value.trim() || 'Sin observaciones adicionales del DG. Proceder con el refinamiento técnico según las rúbricas.';

    const currentCode = activeSec ? activeSec.strudelCode : (track.variations?.[0]?.code || '// Sin código');

    const promptText = `### FEEDBACK TÁCTICO // SELECCIÓN DE TIMELINE (v0.2.0-beta)
- **Track Objetivo:** ${track.title} (${track.id})
- **Rango Seleccionado:** ${formattedStart} ── ${formattedEnd} (${durSec} segundos)
- **Modo:** ${currentMode.toUpperCase()}
- **Sección en Foco:** ${activeSec ? `${activeSec.tag} — ${activeSec.name}` : 'Rango Continuo Personalizado'}
- **Tempo / Tonalidad:** ${activeSec ? `${activeSec.bpm} BPM // ${activeSec.keyCenter}` : '138 -> 110 BPM'}
- **Directivas / Exponentes Seleccionados:** ${tagsString}
- **Destinatarios Agénticos:** ${crewString}

#### 1. Dirección del Director General (DG):
"${userNote}"

#### 2. Código Strudel Actual de la Sección:
\`\`\`javascript
${currentCode.trim()}
\`\`\`

#### 3. Mandato para el Crew Multiagente:
DM, CP, SD, AE: Aplicar las directivas anteriores sobre el rango temporal [${formattedStart} ── ${formattedEnd}] respetando los límites de mezcla (-14.0 LUFS ± 0.5, True Peak < -1.0 dBTP) y los invariantes del manifiesto de Seed.md (Restauración ↔ Fuga, nada de nostalgia pasiva). Consolidar informe en L3 QA.`;

    promptPreviewCode.textContent = promptText;
  }

  // Sound Engine with Champion Rebase Synthesis
  let tickerStep = 0;
  function startPlayback(isRangePreview = false) {
    getAudioContext();
    isPlaying = true;
    isPreviewingRange = isRangePreview;
    playIcon.textContent = '⏸';
    playLabel.textContent = 'Pause';
    stopBtn.disabled = false;

    if (isRangePreview) {
      trackSeconds = selectionStart;
    }

    clockInterval = setInterval(() => {
      trackSeconds += 0.5;

      if (isPreviewingRange) {
        if (trackSeconds >= selectionEnd) {
          trackSeconds = selectionStart;
        }
      } else if (isLoopingSection) {
        const curSec = workingSections[activeSectionIndex];
        if (curSec && trackSeconds >= curSec.endSec) {
          trackSeconds = curSec.startSec;
        }
      } else {
        if (trackSeconds >= totalDuration) {
          trackSeconds = 0;
        }
      }
      updateUI();
    }, 500);

    soundTicker = setInterval(() => {
      const ctx = audioCtx;
      if (!ctx) return;
      const time = ctx.currentTime;
      const s = trackSeconds;

      // TRACK 01: BACKUP // CHAMPION REBASE (RAVE -> TRANSITION -> FORK C)
      if (currentTrackIdx === 0) {
        const stepInBar = tickerStep % 16;

        // Act 1: Rave de Reciclaje (0:00 - 1:15 // 138 BPM)
        if (s < 75) {
          // Hard 4/4 909 Kick
          if (stepInBar % 4 === 0) {
            triggerKick(ctx, time, 160, 38, 0.95);
          }
          // Syncopated Clap / Snare
          if (stepInBar % 4 === 2) {
            triggerNoise(ctx, time, 0.45, 4500, 0.08);
          }
          // 16th Hi-hats
          if (stepInBar % 2 === 1) {
            triggerNoise(ctx, time, 0.2, 6000, 0.03);
          }
          // Acid 303 Resonant Saw Bassline
          if (stepInBar % 2 === 0) {
            const acidNotes = [73.42, 87.31, 98.00, 116.54, 138.59, 146.83];
            const acidFreq = acidNotes[(tickerStep / 2) % acidNotes.length];
            const filterFreq = 800 + Math.sin(tickerStep * 0.4) * 1800;
            triggerAcid(ctx, time, acidFreq, filterFreq, 0.35, 0.14);
          }
          // Rock Stabs
          if (stepInBar === 4 || stepInBar === 12) {
            triggerSaw(ctx, time, 293.66, 0.3, 2400, 0.2); // D4 stab
          }
        }

        // Act 2: Transición Inteligente de Transporte (1:15 - 1:50 // 138 -> 110 BPM)
        else if (s >= 75 && s < 110) {
          // Filtered & Decelerating Kick
          if (stepInBar === 0 || stepInBar === 6 || stepInBar === 12) {
            triggerKick(ctx, time, 120, 32, 0.65);
          }
          // Noise sweep / Dither artifacts
          if (stepInBar % 4 === 1) {
            triggerNoise(ctx, time, 0.18, 2200, 0.06);
          }
          // F# Tritone Capsule Pivot Drone (92.50 Hz)
          if (stepInBar === 0) {
            triggerSaw(ctx, time, 92.50, 0.45, 950, 1.8); // F#2 drone
          }
          // 5-tuplet Rimshot Entry
          if (tickerStep % 3 === 0) {
            triggerNoise(ctx, time, 0.25, 3200, 0.025);
          }
        }

        // Act 3: Fork Mutante Alfa Aprobado (1:50 - 3:05 // 110 BPM)
        else if (s >= 110 && s < 185) {
          const barIdx = Math.floor(tickerStep / 16) % 4;
          const lfoFilterFreq = 1350 + Math.sin(tickerStep * 0.15) * 850;

          // Fork Dyads Sawtooth
          if (stepInBar === 0) {
            const forkDyads = [
              [65.41, 98.00],   // [C2, G2]
              [77.78, 116.54],  // [Eb2, Bb2]
              [87.31, 130.81],  // [F2, C3]
              [92.50, 130.81]   // [F#2, C3]
            ];
            const dyad = forkDyads[barIdx];
            dyad.forEach(f => triggerSaw(ctx, time, f, 0.3, lfoFilterFreq, 1.9));
          }
          // Fast 1.75 Sine Melody
          if (tickerStep % 2 === 0 || tickerStep % 7 === 3) {
            const melodyNotes = [261.63, 311.13, 392.00, 369.99, 466.16, 587.33, 523.25];
            const mFreq = melodyNotes[(tickerStep * 2) % melodyNotes.length];
            triggerSine(ctx, time, mFreq, 0.35, 0.2);
          }
          // TR-909 Groove
          if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12) {
            triggerKick(ctx, time, 135, 36, 0.8);
          }
          // Rimshot 5-tuplet
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 13) {
            triggerNoise(ctx, time, 0.26, 2400, 0.035);
          }
        }

        // Act 4: Trojan Sandbox: Chimes & Flatline 56k (3:05 - 4:10)
        else if (s >= 185 && s < 250) {
          // Triangle Chimes (Trojan)
          if (stepInBar % 4 === 0) {
            triggerTriangle(ctx, time, 523.25, 0.25, 0.4);
            triggerTriangle(ctx, time, 659.25, 0.2, 0.35);
          }
          // Flatline EKG Beep
          if (tickerStep % 8 === 0) {
            triggerSine(ctx, time, 1046.50, 0.35, 0.08);
          }
          // 56k modem chirp
          if (tickerStep % 6 === 2) {
            triggerSquare(ctx, time, 1800, 0.08, 0.04);
          }
        }

        // Act 5: Solo Santana Invertido (4:10 - 5:15)
        else if (s >= 250 && s <= 315) {
          if (tickerStep % 3 === 0) {
            const santanaNotes = [587.33, 440.00, 349.23, 523.25, 392.00, 329.63, 466.16];
            const gFreq = santanaNotes[(tickerStep / 3) % santanaNotes.length];
            triggerSaw(ctx, time, gFreq, 0.35, 2400, 0.4);
          }
        }
      }

      // TRACK 02: SPLINTERNET // REWIRED
      else if (currentTrackIdx === 1) {
        const stepInBar = tickerStep % 16;

        if (s < 65) {
          triggerZimmerTick(ctx, time, Math.sin(tickerStep * 0.3) * 0.5);
          if (stepInBar === 0) triggerSaw(ctx, time, 130.81, 0.22, 1800, 1.8);
        } else if (s >= 65 && s < 120) {
          if (stepInBar === 0 || stepInBar === 8) triggerKick(ctx, time, 150, 40, 0.9);
          if (stepInBar === 4 || stepInBar === 12) triggerNoise(ctx, time, 0.5, 1200, 0.07);
          if (stepInBar === 0 || stepInBar === 2) triggerSaw(ctx, time, 65.41, 0.55, 2600, 0.22);
        } else if (s >= 120 && s < 170) {
          if (stepInBar === 0) triggerSquare(ctx, time, 92.50, 0.7, 0.12);
        } else if (s >= 170 && s < 220) {
          if (stepInBar % 8 === 0) triggerKick(ctx, time, 160, 38, 1.0);
          if (stepInBar % 8 === 4) triggerNoise(ctx, time, 0.6, 1800, 0.08);
          if (stepInBar % 2 === 0) {
            triggerSkrillexFMGrowl(ctx, time, 77.78, 140, 1600, 0.8, 0.2);
          }
        } else if (s >= 220 && s <= 285) {
          if (stepInBar === 0) triggerZimmerBraam(ctx, time, 35, 0.85, 2.0);
        }
      }

      tickerStep++;
    }, 125);

    drawWaveform();
  }

  function stopPlayback() {
    if (clockInterval) { clearInterval(clockInterval); clockInterval = null; }
    if (soundTicker) { clearInterval(soundTicker); soundTicker = null; }
    isPlaying = false;
    isPreviewingRange = false;
    playIcon.textContent = '▶';
    playLabel.textContent = 'Play';
    stopBtn.disabled = true;
    drawWaveform();
  }

  function drawWaveform() {
    if (!canvas) return;
    const width = canvas.width = canvas.clientWidth;
    const height = canvas.height = canvas.clientHeight;

    canvasCtx.fillStyle = '#101217';
    canvasCtx.fillRect(0, 0, width, height);

    if (!analyser || !isPlaying) {
      canvasCtx.strokeStyle = '#232731';
      canvasCtx.lineWidth = 1;
      canvasCtx.beginPath();
      canvasCtx.moveTo(0, height / 2);
      canvasCtx.lineTo(width, height / 2);
      canvasCtx.stroke();
      return;
    }

    const bufferLength = analyser.frequencyBinCount;
    const timeData = new Uint8Array(bufferLength);
    analyser.getByteTimeDomainData(timeData);

    canvasCtx.lineWidth = 1.6;
    canvasCtx.strokeStyle = currentTrackIdx === 0 ? '#10b981' : '#38bdf8';
    canvasCtx.beginPath();

    const sliceWidth = width / bufferLength;
    let x = 0;
    for (let i = 0; i < bufferLength; i++) {
      const v = timeData[i] / 128.0;
      const y = (v * height) / 2;
      if (i === 0) canvasCtx.moveTo(x, y);
      else canvasCtx.lineTo(x, y);
      x += sliceWidth;
    }
    canvasCtx.stroke();

    requestAnimationFrame(drawWaveform);
  }

  // Event Listeners
  btnTabBaseline.addEventListener('click', () => setTrack(0));
  btnTabChallenger.addEventListener('click', () => setTrack(1));

  playBtn.addEventListener('click', () => {
    if (isPlaying) stopPlayback();
    else startPlayback(false);
  });

  stopBtn.addEventListener('click', () => {
    stopPlayback();
    seekTo(0);
  });

  loopBtn.addEventListener('click', () => {
    isLoopingSection = !isLoopingSection;
    loopLabel.textContent = isLoopingSection ? `Loop: Sec 0${activeSectionIndex + 1}` : 'Loop: Off';
    loopBtn.classList.toggle('btn-active', isLoopingSection);
  });

  volSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    volVal.textContent = `${Math.round(val * 100)}%`;
    if (masterGain && audioCtx) {
      masterGain.gain.setValueAtTime(val, audioCtx.currentTime);
    }
  });

  tabMutacion.addEventListener('click', () => setMode('mutacion'));
  tabChallenger.addEventListener('click', () => setMode('challenger'));
  tabExp.addEventListener('click', () => setMode('exp'));

  waveformTrack.addEventListener('click', (e) => {
    const rect = waveformTrack.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const pct = Math.max(0, Math.min(1, clickX / rect.width));
    seekTo(pct * totalDuration);
  });

  // Range Slider Listeners
  rangeStartSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (val >= selectionEnd) {
      selectionStart = Math.max(0, selectionEnd - 1);
      rangeStartSlider.value = selectionStart;
    } else {
      selectionStart = val;
    }
    updateToolScrubbers();
    updateSelectionOverlay();
    generateSmartPrompt();
  });

  rangeEndSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (val <= selectionStart) {
      selectionEnd = Math.min(totalDuration, selectionStart + 1);
      rangeEndSlider.value = selectionEnd;
    } else {
      selectionEnd = val;
    }
    updateToolScrubbers();
    updateSelectionOverlay();
    generateSmartPrompt();
  });

  btnPreviewRange.addEventListener('click', () => {
    if (isPlaying && isPreviewingRange) {
      stopPlayback();
    } else {
      stopPlayback();
      startPlayback(true);
    }
  });

  // Metacategory tabs click
  const metaCatButtons = metacategoriesTabs.querySelectorAll('.meta-cat-btn');
  metaCatButtons.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      metaCatButtons.forEach(b => b.classList.remove('meta-cat-active'));
      btn.classList.add('meta-cat-active');
      activeCategoryIdx = idx;
      renderExponents();
    });
  });

  modifierPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const tag = pill.getAttribute('data-tag');
      if (activeDirectives.has(tag)) {
        activeDirectives.delete(tag);
        pill.classList.remove('pill-btn-active');
      } else {
        activeDirectives.add(tag);
        pill.classList.add('pill-btn-active');
      }
      generateSmartPrompt();
    });
  });

  crewPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const role = pill.getAttribute('data-role');
      if (activeCrewRoles.has(role)) {
        activeCrewRoles.delete(role);
        pill.classList.remove('pill-crew-active');
      } else {
        activeCrewRoles.add(role);
        pill.classList.add('pill-crew-active');
      }
      generateSmartPrompt();
    });
  });

  producerNoteTextarea.addEventListener('input', () => {
    generateSmartPrompt();
  });

  btnCopySmartPrompt.addEventListener('click', async () => {
    const promptText = promptPreviewCode.textContent;
    try {
      await navigator.clipboard.writeText(promptText);
      const originalText = copyPromptBtnText.textContent;
      copyPromptBtnText.textContent = '✅ ¡PROMPT COPIADO AL PORTAPAPELES!';
      btnCopySmartPrompt.classList.add('btn-success-glow');
      setTimeout(() => {
        copyPromptBtnText.textContent = originalText;
        btnCopySmartPrompt.classList.remove('btn-success-glow');
      }, 2500);
    } catch (e) {
      console.warn('Clipboard write error:', e);
    }
  });

  btnCopyRef.addEventListener('click', async () => {
    const promptText = promptPreviewCode.textContent;
    try {
      await navigator.clipboard.writeText(promptText);
      const originalText = copyRefText.textContent;
      copyRefText.textContent = '¡Copiado!';
      setTimeout(() => { copyRefText.textContent = originalText; }, 2000);
    } catch (e) {
      console.warn(e);
    }
  });

  // Arranger Toolbar Actions
  btnResetTimeline.addEventListener('click', () => {
    try {
      localStorage.removeItem(`recovery_arranger_track_${currentTrackIdx}`);
    } catch (e) {}
    workingSections = JSON.parse(JSON.stringify(getActiveTrack().sections || []));
    recalculateTimestamps();
    renderArrangerStrip();
    renderQuickSectionChips();
    updateToolScrubbers();
    updateSelectionOverlay();
    generateSmartPrompt();
  });

  btnSaveMutationBank.addEventListener('click', () => {
    const activeSec = workingSections[activeSectionIndex] || workingSections[0];
    const bank = getLocalMutationBank();
    const newClip = {
      id: `clip-custom-${Date.now()}`,
      name: `${activeSec.name.split('(')[0].trim()} (Mutación Aprobada)`,
      category: 'Mutación Guardada',
      tag: `[MUTACIÓN: ${activeSec.tag}]`,
      duration: activeSec.endSec - activeSec.startSec,
      instruments: Array.isArray(activeSec.instruments) ? activeSec.instruments.join(', ') : activeSec.instruments,
      code: activeSec.strudelCode
    };
    bank.unshift(newClip);
    saveLocalMutationBank(bank);
    const orig = btnSaveBankText.textContent;
    btnSaveBankText.textContent = '✅ Guardado!';
    setTimeout(() => { btnSaveBankText.textContent = orig; }, 2000);
  });

  btnExportSession.addEventListener('click', () => {
    const sessionData = {
      version: '0.2.0-beta',
      track: getActiveTrack().title,
      trackId: getActiveTrack().id,
      exportedAt: new Date().toISOString(),
      sections: workingSections
    };
    const blob = new Blob([JSON.stringify(sessionData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `recovery_session_${getActiveTrack().id}_v0.2.0-beta.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  fileImportSession.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const parsed = JSON.parse(event.target.result);
        if (parsed.sections && Array.isArray(parsed.sections)) {
          workingSections = parsed.sections;
          recalculateTimestamps();
          saveArrangementToLocalStorage();
          renderArrangerStrip();
          renderQuickSectionChips();
          updateToolScrubbers();
          generateSmartPrompt();
          alert('✅ Sesión cargada exitosamente.');
        }
      } catch (err) {
        alert('Error al parsear el archivo JSON de sesión.');
      }
    };
    reader.readAsText(file);
  });

  // Init
  renderExponents();
  renderMutationBank();
  setTrack(0);
  drawWaveform();
</script>

