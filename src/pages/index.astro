      scrollOffsetSec = Math.min(scrollOffsetSec, maxScroll);
      drawWaveforms();
      updateSelectionOverlays();
      updateDeckUI(1);
      renderAnnotationMarkers();
    });
  }

  if (btnZoomOut) {
    btnZoomOut.addEventListener('click', () => {
      zoomLevel = Math.max(1.0, +(zoomLevel - 0.5).toFixed(1));
      if (zoomLevelBadge) zoomLevelBadge.textContent = `${Math.round(zoomLevel * 100)}%`;
      const maxScroll = Math.max(0, decks[1].duration - decks[1].duration / zoomLevel);
      scrollOffsetSec = Math.min(scrollOffsetSec, maxScroll);
      drawWaveforms();
      updateSelectionOverlays();
      updateDeckUI(1);
      renderAnnotationMarkers();
    });
  }

  if (btnZoomFit) {
    btnZoomFit.addEventListener('click', () => {
      zoomLevel = 1.0;
      scrollOffsetSec = 0;
      if (zoomLevelBadge) zoomLevelBadge.textContent = '100%';
      drawWaveforms();
      updateSelectionOverlays();
      updateDeckUI(1);
      renderAnnotationMarkers();
    });
  }

  // HITL Governance Verdict Buttons
  const verdictButtons = [
    { btn: btnVerdictIterate, val: 'REQUEST_ITERATION' },
    { btn: btnVerdictPromote, val: 'PROMOTE_TO_CHAMPION' },
    { btn: btnVerdictReject, val: 'REJECT_CHALLENGER' }
  ];

  verdictButtons.forEach(({ btn, val }) => {
    if (btn) {
      btn.addEventListener('click', () => {
        activeVerdictDecision = val;
        verdictButtons.forEach(item => {
          if (item.btn) {
            const isActive = item.val === val;
            item.btn.classList.toggle('active-verdict', isActive);
            item.btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          }
        });
        generateVibePrompt();
      });
    }
  });

  // Render & Download Reference WAV
  if (btnExportReferenceWav) {
    btnExportReferenceWav.addEventListener('click', () => {
      const d = decks[activeTargetDeck];
      const sec = d.sections[d.activeSecIdx] || d.sections[0];
      const bpm = sec ? sec.bpm : 118;
      const sampleRate = 44100;
      const durationSec = 4.0;
      const numSamples = Math.floor(sampleRate * durationSec);
      const numChannels = 2;
      const bitsPerSample = 16;
      const byteRate = sampleRate * numChannels * (bitsPerSample / 8);
      const blockAlign = numChannels * (bitsPerSample / 8);
      const dataSize = numSamples * blockAlign;
      const buffer = new ArrayBuffer(44 + dataSize);
      const view = new DataView(buffer);

      function writeString(offset, str) {
        for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
      }

      writeString(0, 'RIFF');
      view.setUint32(4, 36 + dataSize, true);
      writeString(8, 'WAVE');
      writeString(12, 'fmt ');
      view.setUint32(16, 16, true);
      view.setUint16(20, 1, true); // PCM
      view.setUint16(22, numChannels, true);
      view.setUint32(24, sampleRate, true);
      view.setUint32(28, byteRate, true);
      view.setUint16(32, blockAlign, true);
      view.setUint16(34, bitsPerSample, true);
      writeString(36, 'data');
      view.setUint32(40, dataSize, true);

      let offset = 44;
      const secondsPerBeat = 60.0 / bpm;
      const sixteenthStep = secondsPerBeat / 4.0;

      for (let i = 0; i < numSamples; i++) {
        const t = i / sampleRate;
        const fracInStep = (t % sixteenthStep) / sixteenthStep;
        let tick = 0.0;
        if (fracInStep < 0.18) {
          tick = Math.sin(2.0 * Math.PI * 2400.0 * t) * Math.exp(-fracInStep * 25.0) * 0.28;
        }
        const sub = Math.sin(2.0 * Math.PI * 35.0 * t) * 0.45;
        const bassF = 65.41;
        const reese = Math.sin(2.0 * Math.PI * bassF * t) * 0.35;
        const sampleVal = Math.max(-1, Math.min(1, tick + sub * 0.8 + reese * 0.6));
        const int16 = sampleVal < 0 ? sampleVal * 0x8000 : sampleVal * 0x7FFF;
        view.setInt16(offset, int16, true);
        view.setInt16(offset + 2, int16, true);
        offset += 4;
      }

      const blob = new Blob([buffer], { type: 'audio/wav' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `recovery_reference_deck_${activeTargetDeck + 1}_${sec ? sec.id : 'sec'}.wav`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (btnExportText) {
        const orig = btnExportText.textContent;
        btnExportText.textContent = '✅ WAV Descargado';
        setTimeout(() => { btnExportText.textContent = orig; }, 2000);
      }
    });
  }

  // Crew Routing Pills
  crewChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const role = chip.getAttribute('data-role');
      if (activeCrewRoles.has(role)) {
        activeCrewRoles.delete(role);
        chip.classList.remove('chip-crew-active');
        chip.setAttribute('aria-pressed', 'false');
      } else {
        activeCrewRoles.add(role);
        chip.classList.add('chip-crew-active');
        chip.setAttribute('aria-pressed', 'true');
      }
      updateRoleCardsVisibility();
      generateVibePrompt();
    });
  });

  // Director Note Textarea
  vibeDirectorNote.addEventListener('input', () => {
    generateVibePrompt();
  });

  // Protocolo de Caché Limpio al Publicar / Copiar (Cero Contaminación de Prompt)
  function resetVibeStudioClean() {
    vibeDirectorNote.value = '';
    if (dockQuickPromptInput) dockQuickPromptInput.value = '';
    directorAnnotations = [];
    pendingAnnotationRange = null;
    renderAnnotationMarkers();
    Object.keys(agentMutationTags).forEach(r => agentMutationTags[r].clear());
    renderAgentMutationTags();
    selStart = 0;
    selEnd = 0;
    updateSelectionOverlays();
    document.querySelectorAll('.btn-act-chip').forEach(b => {
      b.classList.remove('active-act');
      b.setAttribute('aria-pressed', 'false');
    });
    generateVibePrompt();
    drawWaveforms();
  }

  // 1-Click Copy Prompt Button
  btnCopyVibePrompt.addEventListener('click', async () => {
    const textToCopy = promptPreviewOutput.textContent;
    try {
      await navigator.clipboard.writeText(textToCopy);
      const originalText = btnCopyText.textContent;
      btnCopyText.textContent = '✅ ¡COPIADO & CACHÉ LIMPIO!';
      btnCopyVibePrompt.classList.add('btn-success-glow');
      setTimeout(() => {
        resetVibeStudioClean();
      }, 500);
      setTimeout(() => {
        btnCopyText.textContent = originalText;
        btnCopyVibePrompt.classList.remove('btn-success-glow');
      }, 2500);
    } catch (e) {
      console.warn('Clipboard write error:', e);
    }
  });

  // Init
  const initialTheme = getCurrentTheme();
  applyTheme(initialTheme);
  syncChannelStripUI();
  updateTargetDeckUI();
  updateSelectionOverlays();
  updateRoleCardsVisibility();
  renderAgentMutationTags();
  generateVibePrompt();
  drawWaveforms();
</script>

