  // Helper format seconds -> mm:ss
  function formatTime(s) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  }

  // Audio Context Initialization
  function getAudioContext() {
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || window['webkitAudioContext'];
      audioCtx = new AudioCtxClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      masterGain = audioCtx.createGain();
      masterGain.gain.setValueAtTime(0.85, audioCtx.currentTime);
      masterGain.connect(analyser);
      analyser.connect(audioCtx.destination);
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // Distortion Curve Maker
  function makeDistCurve(amount = 45) {
    const k = amount;
    const n = 44100;
    const curve = new Float32Array(n);
    const deg = Math.PI / 180;
    for (let i = 0; i < n; ++i) {
      const x = (i * 2) / n - 1;
      curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
    }
    return curve;
  }
  const distCurve = makeDistCurve(45);

  // Synthesis Primitives (7+ Stems Studio Quality)
  function playKick(ctx, time, startF = 160, endF = 38, vol = 0.95, dur = 0.18) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(startF, time);
    osc.frequency.exponentialRampToValueAtTime(endF, time + dur * 0.8);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playNoise(ctx, time, vol = 0.35, highpassF = 4000, dur = 0.08) {
    const bufSize = Math.max(1, Math.floor(ctx.sampleRate * dur));
    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const f = ctx.createBiquadFilter();
    f.type = 'highpass';
    f.frequency.setValueAtTime(highpassF, time);
    const g = ctx.createGain();
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    src.connect(f);
    f.connect(g);
    g.connect(masterGain);
    src.start(time);
    src.stop(time + dur);
  }

  function playSaw(ctx, time, freq, vol = 0.3, filterF = 1800, dur = 0.25) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(filterF, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playSquare(ctx, time, freq, vol = 0.35, dur = 0.15) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playSine(ctx, time, freq, vol = 0.35, dur = 0.25) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playTriangle(ctx, time, freq, vol = 0.3, dur = 0.2) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function playAcid(ctx, time, freq, filterF = 1800, vol = 0.35, dur = 0.12) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(filterF, time);
    f.Q.value = 16;
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  // Reloj de Cuenta Regresiva Rhythmic Spine with Stereo Micropan
  function playCountdownTick(ctx, time, panVal = 0) {
    const osc = ctx.createOscillator();
    const filter = ctx.createBiquadFilter();
    const panner = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(2400, time);
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(2400, time);
    filter.Q.value = 9;
    g.gain.setValueAtTime(0.24, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.022);
    osc.connect(filter);
    filter.connect(g);
    if (panner) {
      panner.pan.setValueAtTime(panVal, time);
      g.connect(panner);
      panner.connect(masterGain);
    } else {
      g.connect(masterGain);
    }
    osc.start(time);
    osc.stop(time + 0.025);
  }

  // Monumental Sub-Braam (35Hz)
  function playMonumentalBraam(ctx, time, baseFreq = 35, vol = 0.9, dur = 2.2) {
    [baseFreq, baseFreq * 1.012, baseFreq * 2].forEach((f, i) => {
      const osc = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const g = ctx.createGain();
      osc.type = i === 2 ? 'sawtooth' : 'triangle';
      osc.frequency.setValueAtTime(f, time);
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(240, time);
      filter.Q.value = 7;
      g.gain.setValueAtTime(0.001, time);
      g.gain.linearRampToValueAtTime(vol * 0.45, time + 0.08);
      g.gain.exponentialRampToValueAtTime(0.001, time + dur);
      osc.connect(filter);
      filter.connect(g);
      g.connect(masterGain);
      osc.start(time);
      osc.stop(time + dur);
    });
  }

  // Skrillex Neuro FM Growl with Formant Sweeps
  function playNeuroFMGrowl(ctx, time, carrierF, modF, filterF, vol = 0.8, dur = 0.28) {
    const carrier = ctx.createOscillator();
    const modulator = ctx.createOscillator();
    const modGain = ctx.createGain();
    const filter = ctx.createBiquadFilter();
    const shaper = ctx.createWaveShaper();
    const g = ctx.createGain();

    carrier.type = 'sawtooth';
    carrier.frequency.setValueAtTime(carrierF, time);
    modulator.type = 'sine';
    modulator.frequency.setValueAtTime(modF, time);
    modGain.gain.setValueAtTime(carrierF * 2.8, time);
    modulator.connect(modGain);
    modGain.connect(carrier.frequency);

    shaper.curve = distCurve;
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(filterF, time);
    filter.Q.value = 18;

    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);

    carrier.connect(shaper);
    shaper.connect(filter);
    filter.connect(g);
    g.connect(masterGain);

    carrier.start(time);
    modulator.start(time);
    carrier.stop(time + dur);
    modulator.stop(time + dur);
  }

  // Playback Control Engine
  function startDeckPlayback(deckId) {
    getAudioContext();
    if (playingDeck !== null && playingDeck !== deckId) {
      stopDeckPlayback(playingDeck);
    }
    playingDeck = deckId;
    activeTargetDeck = deckId;
    updateTargetDeckUI();

    const d = decks[deckId];
    const dom = deckDOM[deckId];
    dom.playIcon.textContent = '⏸';
    dom.playLabel.textContent = `Pause Deck ${deckId + 1}`;
    dom.stopBtn.disabled = false;

    // Timer Interval
    clockInterval = setInterval(() => {
      d.currentSec += 0.5;

      // Section Looping logic
      if (loopingDeck === deckId) {
        const curSec = d.sections[d.activeSecIdx];
        if (curSec && d.currentSec >= curSec.endSec) {
          d.currentSec = curSec.startSec;
        }
      } else {
        if (d.currentSec >= d.duration) {
          d.currentSec = 0;
        }
      }
      updateDeckUI(deckId);
    }, 500);

    // Audio Step Sequencer (125ms = 16th notes @ 120 BPM base)
    soundTicker = setInterval(() => {
      const ctx = audioCtx;
      if (!ctx || playingDeck !== deckId) return;
      const time = ctx.currentTime;
      const s = d.currentSec;
      const stepInBar = tickerStep % 16;

      // --- DECK 0: BASELINE (100% CONTROL DG // SPLINTERNET REWIRED CHAMPION) ---
      if (deckId === 0) {
        // Reloj de cuenta regresiva continuo
        const pan = Math.sin(tickerStep * 0.35) * 0.55;
        if (s < 120 || s >= 170) {
          playCountdownTick(ctx, time, pan);
        }

        // ACTO 1: Ticking Clock Spine & French Sweep (00:00 - 01:05)
        if (s < 65) {
          if (stepInBar % 4 === 0) playKick(ctx, time, 155, 42, 0.95);
          if (stepInBar % 4 === 2) playNoise(ctx, time, 0.35, 5500, 0.08);
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 14) {
            const chords = [
              [130.81, 155.56, 196.00, 233.08],
              [103.83, 130.81, 155.56, 196.00],
              [87.31, 103.83, 130.81, 155.56],
              [98.00, 123.47, 146.83, 174.61]
            ];
            const chordIdx = Math.floor(tickerStep / 16) % chords.length;
            const filterSweep = 600 + Math.sin(tickerStep * 0.2) * 2200;
            chords[chordIdx].forEach(f => playSaw(ctx, time, f, 0.22, filterSweep, 0.18));
          }
          if (stepInBar % 2 === 0) {
            const bass = [65.41, 130.81, 77.78, 155.56, 87.31, 174.61, 98.00, 196.00];
            playAcid(ctx, time, bass[(tickerStep / 2) % bass.length], 1400, 0.38, 0.1);
          }
        }
        // ACTO 2: Hybrid Breakbeat (01:05 - 02:00)
        else if (s >= 65 && s < 120) {
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10) playKick(ctx, time, 165, 38, 1.0);
          if (stepInBar === 4 || stepInBar === 12) {
            playNoise(ctx, time, 0.65, 3200, 0.12);
            playKick(ctx, time, 190, 75, 0.4);
          }
          if (stepInBar % 2 === 1) playNoise(ctx, time, 0.25, 6200, 0.025);
          if (stepInBar === 0 || stepInBar === 2 || stepInBar === 8 || stepInBar === 13) {
            const rNotes = [65.41, 77.78, 87.31, 92.50];
            playSaw(ctx, time, rNotes[Math.floor(stepInBar / 4) % rNotes.length], 0.48, 2600, 0.28);
          }
        }
        // ACTO 3: Brutalist Digital Dropout (02:00 - 02:50)
        else if (s >= 120 && s < 170) {
          const isDropout = (Math.floor(tickerStep / 16) % 2 === 1) && (stepInBar >= 8 && stepInBar <= 11);
          if (!isDropout) {
            if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 12) {
              playSquare(ctx, time, 92.50, 0.65, 0.14);
              playSquare(ctx, time, 65.41, 0.65, 0.14);
            }
            if (stepInBar === 4 || stepInBar === 14) playNoise(ctx, time, 0.55, 1600, 0.09);
            if (stepInBar === 0) playSaw(ctx, time, 60, 0.35, 140, 1.8);
          }
        }
        // ACTO 4: Surgical FM Neuro Growl Drop (02:50 - 03:40)
        else if (s >= 170 && s < 220) {
          if (stepInBar === 0 || stepInBar === 10) playKick(ctx, time, 170, 32, 1.1);
          if (stepInBar === 8) {
            playNoise(ctx, time, 0.75, 2400, 0.18);
            playKick(ctx, time, 200, 90, 0.6);
          }
          if (stepInBar % 2 === 0) {
            const growlNotes = [65.41, 77.78, 92.50, 98.00, 116.54, 130.81];
            const gF = growlNotes[(tickerStep / 2) % growlNotes.length];
            const modF = 120 + ((tickerStep * 23) % 280);
            const filtF = 800 + Math.sin(tickerStep * 0.7) * 3200;
            playNeuroFMGrowl(ctx, time, gF, modF, filtF, 0.75, 0.22);
          }
        }
        // ACTO 5: Monumental 35Hz Sub-Braam (03:40 - 04:45)
        else if (s >= 220 && s <= 285) {
          if (stepInBar === 0) playMonumentalBraam(ctx, time, 35, 0.9, 2.2);
          if (stepInBar === 2 || stepInBar === 6 || stepInBar === 10 || stepInBar === 14) {
            const pChords = [
              [130.81, 196.00, 261.63, 311.13],
              [116.54, 174.61, 233.08, 293.66],
              [103.83, 155.56, 207.65, 261.63],
              [98.00, 146.83, 196.00, 246.94]
            ];
            const padIdx = Math.floor(tickerStep / 16) % pChords.length;
            pChords[padIdx].forEach(f => playSaw(ctx, time, f, 0.18, 1400, 0.4));
          }
          if (tickerStep % 4 === 0) {
            const bells = [523.25, 622.25, 783.99, 739.99, 932.33, 1046.50];
            playSine(ctx, time, bells[(tickerStep / 4) % bells.length], 0.25, 0.6);
          }
          if (stepInBar % 4 === 0) playKick(ctx, time, 90, 30, 0.4);
        }
      }

      // --- DECK 1: CHALLENGER (SINGLE MAESTRO COMPILADO // DUAL-PLANE EQUAL-POWER CROSSFADER) ---
      else if (deckId === 1) {
        // Actualizar contador métrico en tiempo real (c. bar.beat.subbeat)
        const curBpm = s < 120 ? 105 : (s < 275 ? 118 : 105);
        const bar = Math.floor(s / (60 / curBpm * 4)) + 1;
        const beat = Math.floor((s % (60 / curBpm * 4)) / (60 / curBpm)) + 1;
        const subBeat = Math.floor(((s % (60 / curBpm)) / (60 / curBpm)) * 4) + 1;
        if (dawBarCounter) {
          dawBarCounter.textContent = `${String(bar).padStart(3, '0')}.${beat}.${subBeat}`;
        }

        // CANAL 07: RELOJ VIBE (Pulso 16avos Vibe Anchor)
        if (isTrackAudible(6)) {
          const pan = Math.sin(tickerStep * 0.35) * 0.55;
          playCountdownTick(ctx, time, pan);
        }

        // CÁLCULO DE COEFICIENTES EQUAL-POWER CROSSFADE:
        let g1 = 0.0;
        let g2 = 0.0;
        let g3 = 0.0;

        if (s < 112) {
          g1 = 1.0;
        } else if (s >= 112 && s <= 128) {
          const p = (s - 112) / 16;
          g1 = Math.cos(p * Math.PI / 2);
          g2 = Math.sin(p * Math.PI / 2);
        } else if (s > 128 && s < 267) {
          g2 = 1.0;
        } else if (s >= 267 && s <= 283) {
          const p = (s - 267) / 16;
          g2 = Math.cos(p * Math.PI / 2);
          g3 = Math.sin(p * Math.PI / 2);
        } else {
          g3 = 1.0;
        }

        // Armonía modal de referencia C menor / Eb mayor (derivada del clip aprobado)
        const pChords = [
          [130.81, 196.00, 261.63, 311.13], // C menor (C3, G3, C4, Eb4)
          [116.54, 174.61, 233.08, 293.66], // Eb mayor (Eb3, Bb3, Eb4, G4)
          [103.83, 155.56, 207.65, 261.63], // F menor (F3, C4, F4, Ab4)
          [98.00, 146.83, 196.00, 246.94]   // G menor (G3, D4, G4, Bb4)
        ];
        const chordIdx = Math.floor(tickerStep / 16) % pChords.length;

        // --- CAPA ACTO 1: CONSTRUCCIÓN PROGRESIVA EN < 2 MINUTOS (0:00 - 2:00 // g1) ---
        if (g1 > 0.001) {
          // Canal 04: CAMPANAS OoT (Leitmotif ancestral expuesto desde el inicio)
          if (isTrackAudible(3)) {
            if (tickerStep % 4 === 0) {
              const ocarinaNotes = [523.25, 622.25, 783.99, 739.99, 932.33, 1046.50];
              playSine(ctx, time, ocarinaNotes[(tickerStep / 4) % ocarinaNotes.length], 0.28 * g1, 0.65);
            }
          }
          // Canal 05: CORO IA / PADS (Entran progresivamente a partir de s >= 40)
          if (isTrackAudible(4) && s >= 40) {
            if (stepInBar === 0 || stepInBar === 4 || stepInBar === 8 || stepInBar === 12) {
              const filterSweep = 400 + Math.sin(tickerStep * 0.12) * 1600;
              const padVol = Math.min(0.28, 0.12 + ((s - 40) / 60) * 0.16);
              pChords[chordIdx].forEach(f => playSaw(ctx, time, f, padVol * g1, filterSweep, 0.35));
            }
          }
          // Canal 06: CAPA ÉTNICA (Guzheng granular delicado sobre el tema a partir de s >= 40)
          if (isTrackAudible(5) && s >= 40) {
            if (tickerStep % 2 === 0) {
              const gzNotes = [261.63, 311.13, 392.00, 466.16, 523.25];
              playTriangle(ctx, time, gzNotes[(tickerStep / 2) % gzNotes.length], 0.2 * g1, 0.12);
            }
          }
          // Canal 08: BATERÍA (Sub-kick 4/4 sutil a partir de s >= 60)
          if (isTrackAudible(7) && s >= 60) {
            if (stepInBar === 0) playKick(ctx, time, 120, 36, 0.65 * g1);
            if (stepInBar % 8 === 4) playNoise(ctx, time, 0.18 * g1, 5800, 0.05);
          }
          // Canal 01: SUB-BASS (Despertar gradual del Braam 35Hz a partir de s >= 60, pleno al 100% en 1:50 // s >= 110)
          if (isTrackAudible(0)) {
            if (s >= 60 && stepInBar === 0) {
              const subVol = Math.min(1.0, 0.35 + ((s - 60) / 50) * 0.65);
              playMonumentalBraam(ctx, time, 35, subVol * g1, 2.4);
            }
          }
          // Canal 03: LEAD SYNTH (Polifonía aprobada en crescendo, orquestación completa en 1:50 // s >= 110)
          if (isTrackAudible(2) && s >= 70) {
            if (tickerStep % 2 === 0) {
              const polyNotes = [261.63, 311.13, 349.23, 392.00, 523.25];
              const leadVol = Math.min(0.38, 0.18 + ((s - 70) / 40) * 0.2);
              playTriangle(ctx, time, polyNotes[(tickerStep / 2) % polyNotes.length], leadVol * g1, 0.14);
            }
          }
          // Canal 02: NEURO BASS (Swell armónico que entra en 1:50 // s >= 110 preparando la orquestación total de Acto 1)
          if (isTrackAudible(1) && s >= 110 && s < 120) {
            if (stepInBar === 0 || stepInBar === 8) {
              const rNotes = [65.41, 77.78, 87.31, 98.00];
              playSaw(ctx, time, rNotes[chordIdx], 0.35 * g1, 1200, 0.45);
            }
          }
          // Canal 09: TEXTURAS / FX (White noise tension sweep antes del corte del minuto 2:00 // s >= 115)
          if (isTrackAudible(8) && s >= 115 && s < 120) {
            const sweepProg = (s - 115) / 5;
            playNoise(ctx, time, (0.05 + sweepProg * 0.3) * g1, 800 + sweepProg * 4500, 0.08);
          }
        }

        // --- CAPA ACTO 2: RUPTURA A LOS 2 MINUTOS // APAGÓN DE BAJOS & NUEVOS PATRONES (2:00 - 4:35 // g2) ---
        if (g2 > 0.001) {
          // REGLA CRÍTICA DG: A los 2 minutos (s >= 120 y < 135) -> APAGÓN DE BAJOS (1-bar silence dropout)
          const isBassDropout = (s >= 120 && s < 135);

          // Canal 08: BATERÍA (NUEVO PATRÓN: Modular Breakbeat a 118 BPM con ghost snares y ride)
          if (isTrackAudible(7)) {
            if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10) {
              playKick(ctx, time, 160, 36, 1.05 * g2);
            }
            if (stepInBar === 4 || stepInBar === 12) {
              playNoise(ctx, time, 0.62 * g2, 3400, 0.1);
              playKick(ctx, time, 180, 70, 0.4 * g2);
            }
            if (stepInBar % 2 === 1) {
              playNoise(ctx, time, 0.22 * g2, 5400, 0.03);
            }
            if (stepInBar % 4 === 2) {
              playNoise(ctx, time, 0.18 * g2, 7000, 0.08); // Ride sizzle
            }
          }

          // Canal 02: NEURO BASS (Surge XT FM: APAGADO durante 120-135s, luego entra mutado con pausas)
          if (isTrackAudible(1) && !isBassDropout) {
            // El bajo NO persiste continuo: hits sincopados con pausas
            if (stepInBar === 0 || stepInBar === 3 || stepInBar === 10) {
              const rootNotes = [65.41, 77.78, 87.31, 98.00];
              const rF = rootNotes[chordIdx];
              const modF = 130 + ((tickerStep * 19) % 240);
              const filtF = 900 + Math.sin(tickerStep * 0.4) * 2600;
              playNeuroFMGrowl(ctx, time, rF, modF, filtF, 0.82 * g2, 0.26);
            }
          }

          // Canal 01: SUB-BASS (Sub 35Hz sincronizado pero con pausas, APAGADO en dropout)
          if (isTrackAudible(0) && !isBassDropout) {
            if (stepInBar === 0) {
              playSine(ctx, time, 35.0, 0.32 * g2, 0.6);
            }
          }

          // Canal 03: LEAD SYNTH (NUEVO PATRÓN: Arpegios Modulares Ascendentes)
          if (isTrackAudible(2)) {
            if (tickerStep % 2 === 0) {
              const arpScale = [392.00, 466.16, 523.25, 622.25, 783.99, 932.33];
              const arpNote = arpScale[(tickerStep / 2) % arpScale.length];
              playSaw(ctx, time, arpNote, 0.22 * g2, 2800, 0.12);
            }
          }

          // Canal 05: CORO IA / PADS (NUEVO PATRÓN: Formantes A-E-I modulantes con staccato)
          if (isTrackAudible(4)) {
            if (stepInBar === 2 || stepInBar === 6 || stepInBar === 10 || stepInBar === 14) {
              pChords[chordIdx].forEach(f => playSaw(ctx, time, f, 0.26 * g2, 1800, 0.32));
            }
          }

          // Canal 06: CAPA ÉTNICA (NUEVO PATRÓN: Duduk Melismático & Gamelan)
          if (isTrackAudible(5)) {
            if (tickerStep % 4 === 0) {
              const dudukNotes = [311.13, 349.23, 392.00, 466.16, 523.25, 587.33];
              const dNote = dudukNotes[(tickerStep / 4) % dudukNotes.length];
              playTriangle(ctx, time, dNote, 0.3 * g2, 0.35);
            }
          }

          // Canal 09: TEXTURAS / FX (Noise Risers y Glitch Bursts hacia la frontera)
          if (isTrackAudible(8)) {
            if (s >= 250 && s < 275) {
              const progress = (s - 250) / 25;
              const fSweep = 1000 + progress * 5500;
              if (tickerStep % 2 === 0) {
                playNoise(ctx, time, (0.15 + progress * 0.5) * g2, fSweep, 0.09);
              }
            }
          }
        }

        // --- CAPA ACTO 3: CATARSIS MONUMENTAL TRANSMUTADA & GRAN FUGA SIDERAL (04:35 - 07:15 // g3) ---
        if (g3 > 0.001) {
          // Canal 01: SUB-BASS (Monumental Braam 35Hz con resonancia de bronce)
          if (isTrackAudible(0)) {
            if (stepInBar === 0) {
              const braamIntensity = s < 332 ? 1.15 : (s < 390 ? 0.95 : Math.max(0.2, 0.95 - (s - 390) / 45));
              playMonumentalBraam(ctx, time, 35, braamIntensity * g3, 3.4);
            }
          }
          // Canal 05: CORO IA / PADS (Bombeo sidechain catártico)
          if (isTrackAudible(4)) {
            if (stepInBar === 2 || stepInBar === 6 || stepInBar === 10 || stepInBar === 14) {
              const padVol = s < 390 ? 0.32 : Math.max(0.08, 0.32 - (s - 390) / 40);
              pChords[chordIdx].forEach(f => playSaw(ctx, time, f, padVol * g3, 2200, 0.5));
            }
          }
          // Canal 04: CAMPANAS OoT (Campanas celestiales del leitmotif aprobado)
          if (isTrackAudible(3)) {
            if (tickerStep % 4 === 0) {
              const ocarinaNotes = [523.25, 622.25, 783.99, 739.99, 932.33, 1046.50, 1174.66, 1046.50];
              playSine(ctx, time, ocarinaNotes[(tickerStep / 4) % ocarinaNotes.length], 0.35 * g3, 0.7);
            }
          }
          // Canal 06: CAPA ÉTNICA (Evolución de Fuga Transcultural extendida a partir de 05:32)
          if (isTrackAudible(5)) {
            if (s >= 332 && tickerStep % 2 === 0) {
              const fugaNotes = [261.63, 311.13, 392.00, 466.16, 523.25, 622.25, 783.99];
              playTriangle(ctx, time, fugaNotes[(tickerStep / 2) % fugaNotes.length], 0.28 * g3, 0.14);
            }
          }
          // Canal 08: BATERÍA (Bombo profundo espaciado que decae gradualmente)
          if (isTrackAudible(7)) {
            if (s < 390 && stepInBar % 4 === 0) {
              playKick(ctx, time, 85, 28, 0.55 * g3);
            }
          }
        }
      }

      tickerStep++;
    }, 125);

    drawWaveforms();
  }

  function stopDeckPlayback(deckId) {
    if (clockInterval) { clearInterval(clockInterval); clockInterval = null; }
    if (soundTicker) { clearInterval(soundTicker); soundTicker = null; }
    if (playingDeck === deckId) {
      playingDeck = null;
    }
    const dom = deckDOM[deckId];
    dom.playIcon.textContent = '▶';
    dom.playLabel.textContent = `Play ${deckId === 0 ? 'Baseline' : 'Challenger'}`;
    dom.stopBtn.disabled = true;
    drawWaveforms();
  }

  function seekDeck(deckId, sec) {
    const d = decks[deckId];
    d.currentSec = Math.max(0, Math.min(sec, d.duration));
    updateDeckUI(deckId);
  }

  function selectDeckSection(deckId, secIdx) {
    const d = decks[deckId];
    d.activeSecIdx = secIdx;
    const sec = d.sections[secIdx];
    if (!sec) return;

    activeTargetDeck = deckId;
    selStart = sec.startSec;
    selEnd = sec.endSec;

    // Update section buttons highlight
    deckDOM[deckId].stripButtons.forEach((b, i) => {
      b.classList.toggle(`sec-btn-active-${deckId}`, i === secIdx);
      b.setAttribute('aria-pressed', i === secIdx ? 'true' : 'false');
    });

    seekDeck(deckId, sec.startSec);
    updateTargetDeckUI();
    updateSelectionOverlays();
    generateVibePrompt();
  }

  function getChallengerLayoutMetrics(trackWidth) {
    const w = trackWidth || (deckDOM[1].waveformTrack ? deckDOM[1].waveformTrack.clientWidth : 800);
    const headerW = Math.min(130, Math.floor(w * 0.17));
    const timelineW = Math.max(1, w - headerW);
    const visibleDur = decks[1].duration / zoomLevel;
    return { headerW, timelineW, visibleDur };
  }

  function updateDeckUI(deckId) {
    const d = decks[deckId];
    const dom = deckDOM[deckId];
    const curSec = d.sections[d.activeSecIdx];
    const bpm = curSec ? curSec.bpm : (deckId === 0 ? 138 : 118);
    const barNum = Math.floor(d.currentSec / (60 / bpm * 4)) + 1;
    const beatNum = Math.floor((d.currentSec % (60 / bpm * 4)) / (60 / bpm)) + 1;

    dom.timeDisplay.textContent = `${formatTime(d.currentSec)} / ${formatTime(d.duration)} (c.${barNum}.${beatNum}.1)`;
    if (deckId === 1 && dom.waveformTrack) {
      const { headerW, timelineW, visibleDur } = getChallengerLayoutMetrics(dom.waveformTrack.clientWidth);
      const leftPx = headerW + ((d.currentSec - scrollOffsetSec) / visibleDur) * timelineW;
      const clampedLeft = Math.max(headerW, Math.min(dom.waveformTrack.clientWidth, leftPx));
      dom.playhead.style.left = `${clampedLeft}px`;
    } else {
      const pct = (d.currentSec / d.duration) * 100;
      dom.playhead.style.left = `${pct}%`;
    }
    dom.waveformTrack.setAttribute('aria-valuenow', Math.round(d.currentSec));

    // Detect section changes during playback
    const curIdx = d.sections.findIndex(s => d.currentSec >= s.startSec && d.currentSec < s.endSec);
    if (curIdx !== -1 && curIdx !== d.activeSecIdx && loopingDeck !== deckId) {
      d.activeSecIdx = curIdx;
      dom.stripButtons.forEach((b, i) => {
        b.classList.toggle(`sec-btn-active-${deckId}`, i === curIdx);
        b.setAttribute('aria-pressed', i === curIdx ? 'true' : 'false');
      });
      if (activeTargetDeck === deckId) {
        selStart = d.sections[curIdx].startSec;
        selEnd = d.sections[curIdx].endSec;
        updateSelectionOverlays();
        generateVibePrompt();
      }
    }
  }

  function updateSelectionOverlays() {
    decks.forEach((d, idx) => {
      const dom = deckDOM[idx];
      if (!dom.overlay) return;
      if (activeTargetDeck === idx) {
        if (idx === 1 && dom.waveformTrack) {
          const { headerW, timelineW, visibleDur } = getChallengerLayoutMetrics(dom.waveformTrack.clientWidth);
          const leftPx = headerW + ((selStart - scrollOffsetSec) / visibleDur) * timelineW;
          const rightPx = headerW + ((selEnd - scrollOffsetSec) / visibleDur) * timelineW;
          const clampedLeft = Math.max(headerW, Math.min(dom.waveformTrack.clientWidth, leftPx));
          const clampedRight = Math.max(headerW, Math.min(dom.waveformTrack.clientWidth, rightPx));
          const widthPx = Math.max(0, clampedRight - clampedLeft);
          dom.overlay.style.left = `${clampedLeft}px`;
          dom.overlay.style.width = `${widthPx}px`;
        } else {
          const leftPct = (selStart / d.duration) * 100;
          const widthPct = Math.max(0.5, ((selEnd - selStart) / d.duration) * 100);
          dom.overlay.style.left = `${leftPct}%`;
          dom.overlay.style.width = `${widthPct}%`;
        }
        dom.overlay.style.display = 'block';
      } else {
        dom.overlay.style.display = 'none';
      }
    });
    previewRangeBadge.textContent = `${formatTime(selStart)} ── ${formatTime(selEnd)} (${Math.round(selEnd - selStart)}s)`;

    // Update Floating Dock Chip (Estilo DAW Suno Studio)
    if (dockChipText) {
      const d1 = decks[1];
      const curSec = d1.sections[d1.activeSecIdx];
      const bpm = curSec ? curSec.bpm : 118;
      const barNum = Math.floor(selStart / (60 / bpm * 4)) + 1;
      const beatNum = Math.floor((selStart % (60 / bpm * 4)) / (60 / bpm)) + 1;
      const durSec = Math.round(selEnd - selStart);
      const secId = curSec ? curSec.id : 'custom';
      const curTrack = abletonTracks[selectedTrackIdx] || abletonTracks[0];
      dockChipText.innerHTML = `<span class="chip-id-badge mono" style="background:${curTrack.color}22; color:${curTrack.color}; border: 1px solid ${curTrack.color}44;">P.${curTrack.num} ${curTrack.name}</span><span class="chip-id-badge mono">#${secId}</span><span>${formatTime(selStart)} - ${formatTime(selEnd)} (${durSec}s) · c.${barNum}.${beatNum}.1</span>`;
    }
  }

  function updateTargetDeckUI() {
    btnSelectDeck0.classList.toggle('active-deck-toggle', activeTargetDeck === 0);
    btnSelectDeck0.setAttribute('aria-pressed', activeTargetDeck === 0 ? 'true' : 'false');
    btnSelectDeck1.classList.toggle('active-deck-toggle', activeTargetDeck === 1);
    btnSelectDeck1.setAttribute('aria-pressed', activeTargetDeck === 1 ? 'true' : 'false');
    activeTargetDeckLabel.textContent = activeTargetDeck === 0
      ? 'Target: DECK 1 (Baseline Ground Truth)'
      : 'Target: DECK 2 (Challenger Single)';
  }

  // Waveform Rendering that respects light/dark theme & renders 6-Track Ableton Live View
  function drawWaveforms() {
    const isLight = getCurrentTheme() === 'light';
    const canvasBg = isLight ? '#f8fafc' : '#080c14';
    const gridLineColor = isLight ? '#e2e8f0' : '#1a2230';
    const baselineColor = isLight ? '#059669' : '#10b981';

    [0, 1].forEach((idx) => {
      const dom = deckDOM[idx];
      const canvas = dom.canvas;
      if (!canvas) return;

      // Si el elemento está oculto (como Deck 1 Baseline compacto), salir de inmediato
      if (canvas.clientWidth === 0) return;

      const ctx2d = canvas.getContext('2d');
      const w = canvas.width = canvas.clientWidth;
      const h = canvas.height = canvas.clientHeight;

      // ====================================================================
      // DECK 1 (BASELINE CHAMPION COMPACTO)
      // ====================================================================
      if (idx === 0) {
        ctx2d.fillStyle = canvasBg;
        ctx2d.fillRect(0, 0, w, h);
        if (playingDeck !== 0 || !analyser) {
          ctx2d.strokeStyle = gridLineColor;
          ctx2d.lineWidth = 1;
          ctx2d.beginPath();
          ctx2d.moveTo(0, h / 2);
          ctx2d.lineTo(w, h / 2);
          ctx2d.stroke();
          return;
        }
        const bufferLen = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLen);
        analyser.getByteTimeDomainData(dataArray);
        ctx2d.lineWidth = 1.8;
        ctx2d.strokeStyle = baselineColor;
        ctx2d.beginPath();
        const sliceWidth = w / bufferLen;
        let x = 0;
        for (let i = 0; i < bufferLen; i++) {
          const v = dataArray[i] / 128.0;
          const y = (v * h) / 2;
          if (i === 0) ctx2d.moveTo(x, y);
          else ctx2d.lineTo(x, y);
          x += sliceWidth;
        }
        ctx2d.stroke();
        return;
      }

      // ====================================================================
      // DECK 2 (CHALLENGER): VISTA MULTIPISTA ESTILO ABLETON LIVE (6 LANES)
      // ====================================================================
      if (idx === 1) {
        const numTracks = abletonTracks.length; // 9 Canales
        const rulerH = 24;
        const laneH = (h - rulerH) / numTracks; // 34px aprox
        const headerW = Math.min(130, Math.floor(w * 0.17));
        const timelineW = w - headerW;
        const totalDuration = decks[1].duration;
        const visibleDur = totalDuration / zoomLevel;
        const curSec = decks[1].currentSec || 0;
        const isChallengerPlaying = (playingDeck === 1);

        // Auto-scroll durante reproducción si el cabezal sobrepasa el 92% visible
        if (isChallengerPlaying && curSec > scrollOffsetSec + visibleDur * 0.92) {
          scrollOffsetSec = Math.max(0, Math.min(totalDuration - visibleDur, curSec - visibleDur * 0.2));
        }

        // Helper tiempo a píxel X en el timeline
        const timeToX = (sec) => {
          return headerW + ((sec - scrollOffsetSec) / visibleDur) * timelineW;
        };

        // Fondo del Canvas
        ctx2d.fillStyle = isLight ? '#f8fafc' : '#080c14';
        ctx2d.fillRect(0, 0, w, h);

        // ====================================================================
        // RULER SUPERIOR: COMPASES, SEGUNDOS Y POINTERS DE LOOP BRACE (SUNO STUDIO)
        // ====================================================================
        ctx2d.fillStyle = isLight ? '#e2e8f0' : '#0f172a';
        ctx2d.fillRect(0, 0, w, rulerH);
        ctx2d.strokeStyle = isLight ? '#cbd5e1' : '#1e293b';
        ctx2d.lineWidth = 1;
        ctx2d.beginPath();
        ctx2d.moveTo(0, rulerH);
        ctx2d.lineTo(w, rulerH);
        ctx2d.stroke();

        ctx2d.font = 'bold 8.5px monospace';
        ctx2d.fillStyle = isLight ? '#475569' : '#94a3b8';
        ctx2d.fillText('PISTAS (09)', 8, 15);

        // Marcas de compás y tiempo en el Ruler
        const bpmEst = 118;
        const barSec = (60 / bpmEst) * 4;
        const totalBars = Math.ceil(totalDuration / barSec);
        const barStep = zoomLevel >= 2.5 ? 2 : (zoomLevel >= 1.5 ? 4 : 8);

        ctx2d.font = '7.5px monospace';
        for (let b = 1; b <= totalBars; b += barStep) {
          const bSec = (b - 1) * barSec;
          const bx = timeToX(bSec);
          if (bx >= headerW - 5 && bx <= w + 5) {
            ctx2d.strokeStyle = isLight ? 'rgba(0,0,0,0.18)' : 'rgba(255,255,255,0.14)';
            ctx2d.beginPath();
            ctx2d.moveTo(bx, 10);
            ctx2d.lineTo(bx, rulerH);
            ctx2d.stroke();

            ctx2d.fillStyle = isLight ? '#475569' : '#64748b';
            ctx2d.fillText(`c.${b}`, bx + 3, 13);
            ctx2d.fillText(formatTime(bSec), bx + 3, 21);
          }
        }

        // Pointers de Selección / Loop Brace en el Ruler (Punteros triangulares azules estilo Suno Studio)
        const selLeftX = timeToX(selStart);
        const selRightX = timeToX(selEnd);
        if (selRightX >= headerW && selLeftX <= w) {
          const clampedLeft = Math.max(headerW, selLeftX);
          const clampedRight = Math.min(w, selRightX);

          ctx2d.fillStyle = 'rgba(56, 189, 248, 0.2)';
          ctx2d.fillRect(clampedLeft, 0, Math.max(2, clampedRight - clampedLeft), rulerH);

          // Puntero izquierdo hacia abajo
          if (selLeftX >= headerW && selLeftX <= w) {
            ctx2d.fillStyle = '#38bdf8';
            ctx2d.beginPath();
            ctx2d.moveTo(selLeftX - 5, 0);
            ctx2d.lineTo(selLeftX + 5, 0);
            ctx2d.lineTo(selLeftX, 8);
            ctx2d.closePath();
            ctx2d.fill();
          }

          // Puntero derecho hacia abajo
          if (selRightX >= headerW && selRightX <= w) {
            ctx2d.fillStyle = '#38bdf8';
            ctx2d.beginPath();
            ctx2d.moveTo(selRightX - 5, 0);
            ctx2d.lineTo(selRightX + 5, 0);
            ctx2d.lineTo(selRightX, 8);
            ctx2d.closePath();
            ctx2d.fill();
          }
        }

        // Helper hex -> RGB
        const hexToRgb = (hex) => {
          let c = hex.replace('#', '');
          if (c.length === 3) c = c.split('').map(x => x + x).join('');
          const num = parseInt(c, 16);
          return `${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}`;
        };

        // ====================================================================
        // RENDER DE LAS 9 PISTAS DEL ARREGLO
        // ====================================================================
        abletonTracks.forEach((track, tIdx) => {
          const laneY = rulerH + tIdx * laneH;
          const isMuted = tracksMuted[tIdx];
          const isSolo = (soloTrackIdx === tIdx);
          const isTrackSelected = (selectedTrackIdx === tIdx);

          // Fondo de fila
          ctx2d.fillStyle = isLight
            ? (tIdx % 2 === 0 ? '#f8fafc' : '#f1f5f9')
            : (tIdx % 2 === 0 ? '#0b0f17' : '#0e1420');
          ctx2d.fillRect(0, laneY, w, laneH);

          // Resaltado sutil si es la pista seleccionada
          if (isTrackSelected) {
            ctx2d.fillStyle = isLight ? 'rgba(56, 189, 248, 0.08)' : 'rgba(56, 189, 248, 0.06)';
            ctx2d.fillRect(0, laneY, w, laneH);
          }

          // Separador inferior de pista
          ctx2d.strokeStyle = isLight ? '#e2e8f0' : 'rgba(255, 255, 255, 0.06)';
          ctx2d.lineWidth = 1;
          ctx2d.beginPath();
          ctx2d.moveTo(0, laneY + laneH);
          ctx2d.lineTo(w, laneY + laneH);
          ctx2d.stroke();

          // ------------------------------------------------------------------
          // Columna de Cabecera Izquierda (0 -> headerW)
          // ------------------------------------------------------------------
          ctx2d.fillStyle = isLight ? '#e2e8f0' : '#141b27';
          ctx2d.fillRect(0, laneY, headerW, laneH);

          // Barra de acento de color de pista (4px)
          ctx2d.fillStyle = track.color;
          ctx2d.fillRect(0, laneY, 4, laneH);

          if (isSolo) {
            ctx2d.fillStyle = '#f59e0b';
            ctx2d.fillRect(4, laneY, 2, laneH);
          }

          // Separador vertical derecho de la cabecera
          ctx2d.strokeStyle = isLight ? '#cbd5e1' : '#222d3d';
          ctx2d.beginPath();
          ctx2d.moveTo(headerW, laneY);
          ctx2d.lineTo(headerW, laneY + laneH);
          ctx2d.stroke();

          // Número y Nombre de la pista
          ctx2d.font = 'bold 8.5px monospace';
          ctx2d.fillStyle = isMuted ? (isLight ? '#94a3b8' : '#475569') : track.color;
          ctx2d.fillText(track.num, 7, laneY + 12);

          ctx2d.font = 'bold 8.5px monospace';
          ctx2d.fillStyle = isMuted ? (isLight ? '#94a3b8' : '#64748b') : (isLight ? '#0f172a' : '#f8fafc');
          const maxNameChars = headerW < 100 ? 5 : 8;
          ctx2d.fillText(track.name.slice(0, maxNameChars), 23, laneY + 12);

          // Subtítulo del motor de síntesis
          if (headerW > 85) {
            ctx2d.font = '7px monospace';
            ctx2d.fillStyle = isLight ? '#64748b' : '#64748b';
            ctx2d.fillText(track.sub.slice(0, 14), 7, laneY + 23);
          }

          // Botón interactivo Mute en cabecera [ON] / [M]
          const muteBoxX = headerW - 38;
          const muteBoxY = laneY + 4;
          const muteBoxW = 18;
          const muteBoxH = 13;
          ctx2d.fillStyle = isMuted ? (isLight ? '#ef4444' : '#7f1d1d') : (isLight ? '#10b981' : '#064e3b');
          ctx2d.fillRect(muteBoxX, muteBoxY, muteBoxW, muteBoxH);
          ctx2d.font = 'bold 7px monospace';
          ctx2d.fillStyle = '#ffffff';
          ctx2d.fillText(isMuted ? 'M' : 'ON', muteBoxX + (isMuted ? 6 : 3), muteBoxY + 9.5);

          // Botón interactivo Solo [S]
          const soloBoxX = headerW - 17;
          const soloBoxY = laneY + 4;
          const soloBoxW = 14;
          const soloBoxH = 13;
          ctx2d.fillStyle = isSolo ? '#f59e0b' : (isLight ? '#cbd5e1' : '#1e293b');
          ctx2d.fillRect(soloBoxX, soloBoxY, soloBoxW, soloBoxH);
          ctx2d.fillStyle = isSolo ? '#000000' : (isLight ? '#64748b' : '#94a3b8');
          ctx2d.fillText('S', soloBoxX + 4.5, soloBoxY + 9.5);

          // Indicador LED / VU Meter animado
          const activeClip = track.clips.find(c => curSec >= c.startSec && curSec < c.endSec);
          const isTrackActive = isChallengerPlaying && activeClip && activeClip.active && isTrackAudible(tIdx);
          const ledX = headerW - 8;
          const ledY = laneY + 24;
          ctx2d.beginPath();
          ctx2d.arc(ledX, ledY, 2.5, 0, Math.PI * 2);
          ctx2d.fillStyle = isTrackActive ? track.color : (isLight ? '#cbd5e1' : '#1e293b');
          ctx2d.fill();

          // ------------------------------------------------------------------
          // Clips de Arreglo en el Timeline (Columna Derecha: headerW -> w)
          // ------------------------------------------------------------------
          track.clips.forEach(clip => {
            const clipStartX = timeToX(clip.startSec);
            const clipEndX = timeToX(clip.endSec);
            const clipW = Math.max(3, clipEndX - clipStartX - 1);
            const clipY = laneY + 2;
            const clipH = laneH - 4;
            const isClipCurrent = isChallengerPlaying && (curSec >= clip.startSec && curSec < clip.endSec) && isTrackAudible(tIdx);

            if (clipEndX < headerW || clipStartX > w) return;

            const visibleClipStartX = Math.max(headerW, clipStartX);
            const visibleClipW = Math.min(clipW, w - visibleClipStartX);

            if (clip.active && !isMuted) {
              const rgb = hexToRgb(track.color);
              ctx2d.fillStyle = isClipCurrent
                ? `rgba(${rgb}, 0.32)`
                : `rgba(${rgb}, 0.15)`;

              if (ctx2d.roundRect) {
                ctx2d.beginPath();
                ctx2d.roundRect(visibleClipStartX, clipY, visibleClipW, clipH, 3);
                ctx2d.fill();
                ctx2d.strokeStyle = isClipCurrent ? track.color : `rgba(${rgb}, 0.55)`;
                ctx2d.lineWidth = isClipCurrent ? 1.5 : 1;
                ctx2d.stroke();
              } else {
                ctx2d.fillRect(visibleClipStartX, clipY, visibleClipW, clipH);
                ctx2d.strokeStyle = isClipCurrent ? track.color : `rgba(${rgb}, 0.55)`;
                ctx2d.lineWidth = isClipCurrent ? 1.5 : 1;
                ctx2d.strokeRect(visibleClipStartX, clipY, visibleClipW, clipH);
              }

              // Pastilla de encabezado del clip
              if (visibleClipW > 35) {
                ctx2d.fillStyle = isClipCurrent ? track.color : `rgba(${rgb}, 0.8)`;
                ctx2d.fillRect(visibleClipStartX + 1, clipY + 1, Math.min(visibleClipW - 2, 105), 8);
                ctx2d.font = 'bold 7px monospace';
                ctx2d.fillStyle = '#ffffff';
                ctx2d.fillText(clip.label.slice(0, 16), visibleClipStartX + 3, clipY + 7);
              }

              // Formas de onda dinámicas del clip
              ctx2d.strokeStyle = isClipCurrent ? '#ffffff' : `rgba(${rgb}, 0.85)`;
              ctx2d.lineWidth = 1;
              ctx2d.beginPath();

              const waveYMid = clipY + 9 + (clipH - 9) / 2;
              const waveSteps = Math.min(48, Math.floor(visibleClipW / 3));
              const stepW = visibleClipW / Math.max(1, waveSteps);

              for (let ws = 0; ws < waveSteps; ws++) {
                const wx = visibleClipStartX + ws * stepW;
                let amp = 0.5;

                if (clip.type === 'sub') {
                  amp = Math.sin(ws * 0.35 + (isClipCurrent ? Date.now() * 0.008 : 0)) * 0.75;
                } else if (clip.type === 'reese') {
                  amp = (Math.sin(ws * 0.8) + Math.cos(ws * 1.6)) * 0.45;
                } else if (clip.type === 'breakbeat' || clip.type === 'kick') {
                  amp = (ws % 4 === 0) ? 0.9 : ((ws % 2 === 0) ? 0.45 : 0.15);
                } else if (clip.type === 'pulse') {
                  amp = (ws % 2 === 0) ? 0.7 : 0.2;
                } else if (clip.type === 'bells' || clip.type === 'melody' || clip.type === 'arp') {
                  amp = Math.sin(ws * 0.5) * 0.6;
                } else {
                  amp = (Math.sin(ws * 0.4) * 0.4) + 0.2;
                }

                if (isClipCurrent) {
                  amp *= (1.0 + Math.sin(Date.now() * 0.01 + ws) * 0.25);
                }

                const maxAmpH = (clipH - 12) / 2;
                const wyTop = waveYMid - amp * maxAmpH;
                const wyBot = waveYMid + amp * maxAmpH;

                ctx2d.moveTo(wx, wyTop);
                ctx2d.lineTo(wx, wyBot);
              }
              ctx2d.stroke();

            } else {
              // Clip silenciado o en Mute
              ctx2d.fillStyle = isLight ? 'rgba(0,0,0,0.03)' : 'rgba(255,255,255,0.02)';
              ctx2d.fillRect(visibleClipStartX, clipY, visibleClipW, clipH);
              ctx2d.setLineDash([2, 2]);
              ctx2d.strokeStyle = isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.08)';
              ctx2d.strokeRect(visibleClipStartX, clipY, visibleClipW, clipH);
              ctx2d.setLineDash([]);
              if (visibleClipW > 30) {
                ctx2d.font = 'italic 7px monospace';
                ctx2d.fillStyle = isLight ? '#94a3b8' : '#64748b';
                ctx2d.fillText(isMuted ? '[MUTED]' : clip.label, visibleClipStartX + 4, clipY + 14);
              }
            }

            // Resaltado de selección activa de clip con drag handles (estilo Suno Studio)
            if (isTrackSelected && selEnd > clip.startSec && selStart < clip.endSec) {
              const hlStartX = Math.max(headerW, timeToX(Math.max(clip.startSec, selStart)));
              const hlEndX = Math.min(w, timeToX(Math.min(clip.endSec, selEnd)));
              const hlW = Math.max(4, hlEndX - hlStartX);
              ctx2d.strokeStyle = '#38bdf8';
              ctx2d.lineWidth = 1.8;
              ctx2d.strokeRect(hlStartX, clipY - 1, hlW, clipH + 2);

              // Tiradores de esquina estilo DAW
              ctx2d.fillStyle = '#38bdf8';
              ctx2d.fillRect(hlStartX - 1, clipY - 2, 4, 4);
              ctx2d.fillRect(hlStartX + hlW - 3, clipY - 2, 4, 4);
            }
          });
        });

        // Divisores de Acto en el timeline (00:40, 02:00, 04:35)
        [40, 120, 275].forEach(timeMarker => {
          const mx = timeToX(timeMarker);
          if (mx >= headerW && mx <= w) {
            ctx2d.setLineDash([3, 4]);
            ctx2d.strokeStyle = isLight ? 'rgba(0,0,0,0.18)' : 'rgba(255,255,255,0.16)';
            ctx2d.lineWidth = 1;
            ctx2d.beginPath();
            ctx2d.moveTo(mx, rulerH);
            ctx2d.lineTo(mx, h);
            ctx2d.stroke();
            ctx2d.setLineDash([]);
          }
        });

        // Cabezal vertical de reproducción unificado a través de las 9 pistas
        const playheadX = timeToX(curSec);
        if (playheadX >= headerW && playheadX <= w) {
          ctx2d.strokeStyle = '#38bdf8';
          ctx2d.lineWidth = 2;
          ctx2d.shadowColor = '#0284c7';
          ctx2d.shadowBlur = 6;
          ctx2d.beginPath();
          ctx2d.moveTo(playheadX, rulerH);
          ctx2d.lineTo(playheadX, h);
          ctx2d.stroke();
          ctx2d.shadowBlur = 0;

          // Triángulo Scrubber en el Ruler
          ctx2d.fillStyle = '#38bdf8';
          ctx2d.beginPath();
          ctx2d.moveTo(playheadX - 5, rulerH - 6);
          ctx2d.lineTo(playheadX + 5, rulerH - 6);
          ctx2d.lineTo(playheadX, rulerH);
          ctx2d.closePath();
          ctx2d.fill();
        }
      }
    });

    if (playingDeck !== null) {
      requestAnimationFrame(drawWaveforms);
    }
  }

  // Window Resize Listener for Responsive Canvas Dimensions
  window.addEventListener('resize', () => {
    drawWaveforms();
