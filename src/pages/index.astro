  // DAW Multitrack Toolbar & Channel Strip Event Handlers
  function syncChannelStripUI() {
    channelToggleButtons.forEach((btn, idx) => {
      const tIdx = parseInt(btn.getAttribute('data-channel-idx') || String(idx), 10);
      const isMuted = tracksMuted[tIdx];
      const isSolo = (soloTrackIdx === tIdx);
      btn.classList.toggle('muted-channel', isMuted);
      btn.classList.toggle('solo-channel', isSolo);
      btn.setAttribute('aria-pressed', (!isMuted).toString());
      const labelSpan = btn.querySelector('.btn-channel-label');
      if (labelSpan) {
        const trk = abletonTracks[tIdx];
        labelSpan.textContent = isMuted ? `Mute ${trk.name}` : (isSolo ? `Solo ${trk.name}` : trk.name);
      }
