---
import Layout from '../layouts/Layout.astro';
import { TRACKS } from '../data/tracks';

const track = TRACKS[0];
const variations = track.variations;
---

<Layout
  title="RECOVERY // TERMINAL RUNTIME — Single 01: Backup (Trojan Sandbox Iteration)"
  description="Terminal interactiva de audio algorítmico. Simulación del Caballo de Troya en sandbox: de la marcha totalitaria al Rave de reciclaje con solo invertido de Santana."
>
  <div class="terminal-container">
    <div class="terminal-shell">
      <!-- Top Titlebar -->
      <div class="terminal-top-bar">
        <div class="terminal-dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-amber"></span>
          <span class="dot dot-green"></span>
        </div>
        <div class="terminal-sysinfo">
          <span><span class="pulse-indicator"></span> SYS: RECOVERY-OS v1.1.0</span>
          <span>SANDBOX: ISOLATED QUARANTINE</span>
          <span>DSP: WEB-AUDIO / STRUDEL</span>
          <a href="https://github.com/willkwolf/Recovery-album" target="_blank" rel="noopener noreferrer">
            [ GITHUB_REPO ↗ ]
          </a>
        </div>
      </div>

      <!-- ASCII Header -->
      <div class="ascii-banner">
██████╗ ███████╗ ██████╗ ██████╗ ██╗   ██╗███████╗██████╗ ██╗   ██╗
██╔══██╗██╔════╝██╔════╝██╔═══██╗██║   ██║██╔════╝██╔══██╗╚██╗ ██╔╝
██████╔╝█████╗  ██║     ██║   ██║██║   ██║█████╗  ██████╔╝ ╚████╔╝ 
██╔══██╗██╔══╝  ██║     ██║   ██║╚██╗ ██╔╝██╔══╝  ██╔══██╗  ╚██╔╝  
██║  ██║███████╗╚██████╗╚██████╔╝ ╚████╔╝ ███████╗██║  ██║   ██║   
╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚═════╝   ╚═══╝  ╚══════╝╚═╝  ╚═╝   ╚═╝   
>> EXPERIMENTAL CYCLE 01: BACKUP // TROJAN SANDBOX RECYCLING RUNTIME &lt;&lt;
      </div>

      <!-- System Telemetry & Album Manifest -->
      <div style="padding: 1rem 1rem 0;">
        <div class="term-box">
          <div class="term-box-header">
            <span>// ARCHIVO EN CUARENTENA: SINGLE 01 — BACKUP (TROJAN EDITION)</span>
            <span class="term-badge badge-green">APROBADO POR CREADOR HUMANO</span>
          </div>
          <div class="hud-meta-grid">
            <div>
              <span class="hud-label">SISTEMA ACTIVO:</span> <span class="hud-value">ANTIVIRUS SANDBOX (LECTURA DE TROYANO)</span>
            </div>
            <div>
              <span class="hud-label">MEDIO SONORO:</span> <span class="hud-value">MÚSICA DIGITAL / ELECTRÓNICA ALGORÍTMICA</span>
            </div>
            <div>
              <span class="hud-label">ESTRATEGIA CONCEPTUAL:</span> <span class="hud-value font-bold">CABALLO DE TROYA (BRILLO ENGAÑOSO) → MARCHA → RAVE</span>
            </div>
            <div>
              <span class="hud-label">DIRECCIÓN:</span> <span class="hud-value">Solo invertido Black Magic Woman (Santana) + Despido de la marcha con Techno</span>
            </div>
          </div>
        </div>

        <!-- Audio Player Console & Oscilloscope -->
        <div class="term-box player-console">
          <div class="term-box-header">
            <span>// TERMINAL AUDIO ENGINE // REPRODUCCIÓN EN VIVO</span>
            <span class="term-badge badge-cyan" id="stream-status">ESTADO: LISTO PARA AUDICIÓN</span>
          </div>

          <!-- Realtime Canvas Visualizer -->
          <div class="visualizer-wrapper">
            <canvas id="visualizer-canvas" height="95"></canvas>
            <div class="visualizer-overlay">
              <span id="canvas-track-label">TRACK: BACKUP // SUITE COMPLETA (TROYANO EN SANDBOX)</span>
              <span id="canvas-bpm-label">BPM: 124 // 48.0 kHz ESTÉREO</span>
            </div>
          </div>

          <!-- Playback Controls -->
          <div class="player-action-row">
            <div class="main-buttons">
              <button type="button" class="term-btn term-btn-primary" id="btn-master-play">
                <span id="play-glyph">▶</span> <span id="play-text">INICIAR STREAM EN VIVO</span>
              </button>
              <button type="button" class="term-btn term-btn-danger" id="btn-master-stop" disabled>
                ■ DETENER
              </button>
            </div>

            <div class="vol-control">
              <span class="hud-label">VOLUMEN:</span>
              <input type="range" id="vol-slider" min="0" max="1" step="0.05" value="0.8" />
              <span id="vol-display" class="hud-value">80%</span>
            </div>
          </div>

          <!-- Variations Selector (Subroutines) -->
          <div class="subroutines-panel">
            <div class="subroutine-header">
              <span>// SUBRUTINAS DE SIMULACIÓN (SELECCIONAR PARA AUDICIÓN DIRECTA):</span>
            </div>
            <div class="subroutine-grid">
              {variations.map((v, idx) => (
                <button
                  type="button"
                  class={`subroutine-card ${idx === 0 ? 'active' : ''}`}
                  data-var-id={v.id}
                  data-var-bpm={v.bpm}
                  data-var-concept={v.concept}
                  data-var-tension={v.tension}
                >
                  <div class="sub-title">
                    <span class="sub-idx">[{idx === 0 ? 'SUITE' : `ACTO ${idx}`}]</span> {v.name.toUpperCase()}
                  </div>
                  <div class="sub-concept">{v.concept}</div>
                  <div class="sub-meta">TEMPO: {v.bpm} BPM // TENSION: {v.tension}</div>
                </button>
              ))}
            </div>
          </div>

          <!-- Active Variation Specs -->
          <div class="variation-detail-box" id="var-detail-box">
            <div class="detail-row">
              <span class="hud-label">SUBRUTINA ACTIVA:</span>
              <span class="hud-value font-bold" id="detail-name">{variations[0].name}</span>
            </div>
            <div class="detail-row">
              <span class="hud-label">DESCRIPCIÓN TÉCNICA:</span>
              <span class="hud-value" id="detail-desc">{variations[0].description}</span>
            </div>
          </div>
        </div>

        <!-- Terminal Log / Console Telemetry -->
        <div class="term-box">
          <div class="term-box-header">
            <span>// TELEMETRÍA DEL SISTEMA ANTIVIRUS & AUDIO THREAD</span>
            <span class="term-badge">CANAL: LOG/ANTIVIRUS</span>
          </div>
          <div class="term-log" id="terminal-log-output">
            <span class="log-entry"><span class="log-time">[BOOT+0.00s]</span> <span class="log-prefix">&gt;</span> <span class="log-msg">Iniciando sandbox seguro aislado...</span></span>
            <span class="log-entry"><span class="log-time">[BOOT+0.05s]</span> <span class="log-prefix">&gt;</span> <span class="log-msg">Archivo montado: Trojan.MemoryDestroyer (Copia analizada: Backup.flac).</span></span>
            <span class="log-entry"><span class="log-time">[BOOT+0.08s]</span> <span class="log-prefix">&gt;</span> <span class="log-msg">Detector de patrones: arpegios brillantes detectados (Caballo de Troya activo).</span></span>
            <span class="log-entry"><span class="log-time">[BOOT+0.12s]</span> <span class="log-prefix">&gt;</span> <span class="log-msg">DSP Web Audio: búfer estéreo 48kHz listo. Motor Strudel enlazado.</span></span>
            <span class="log-entry"><span class="log-time">[BOOT+0.15s]</span> <span class="log-prefix">&gt;</span> <span class="log-msg">Presiona [INICIAR STREAM EN VIVO] para audicionar la simulación.</span> <span class="cursor-blink">_</span></span>
          </div>
        </div>

        <!-- Code Inspection Drawer -->
        <div class="term-box">
          <div class="term-box-header">
            <span>// CÓDIGO FUENTE DE SÍNTESIS (STRUDEL / TIDALCYCLES ALGORÍTMICO)</span>
            <div style="display: flex; gap: 0.5rem;">
              <button type="button" class="term-btn term-btn-sm" id="btn-copy-code">
                [ COPIAR CÓDIGO ]
              </button>
              <a
                id="btn-strudel-repl"
                href={`https://strudel.cc/#${encodeURIComponent(variations[0].code)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="term-btn term-btn-sm"
              >
                [ ABRIR EN STRUDEL REPL ↗ ]
              </a>
            </div>
          </div>
          <pre class="term-code"><code id="code-display">{variations[0].code}</code></pre>
        </div>

        <!-- Terminal Footer -->
        <div class="terminal-footer">
          <div>
            <span>RECOVERY // EXPERIMENTO SINGLE 01 (BACKUP)</span> // <span>AUTORIDAD CREATIVA: CREADOR HUMANO</span>
          </div>
          <div>
            <span>PUBLIC RUNTIME: <a href="https://willkwolf.github.io/Recovery-album/">willkwolf.github.io/Recovery-album/</a></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ variations }}>
  // Enhanced Terminal Audio Engine: Trojan Horse, Imperial March, Flatline Beep, Santana Inversion & Rave
  let isPlaying = false;
  let activeVar = variations[0]; // Default to Suite Completa
  let audioCtx = null;
  let analyser = null;
  let masterGain = null;
  let synthInterval = null;
  let strudelModule = null;

  const playBtn = document.getElementById('btn-master-play');
  const stopBtn = document.getElementById('btn-master-stop');
  const playGlyph = document.getElementById('play-glyph');
  const playText = document.getElementById('play-text');
  const statusEl = document.getElementById('stream-status');
  const canvas = document.getElementById('visualizer-canvas');
  const canvasCtx = canvas.getContext('2d');
  const logEl = document.getElementById('terminal-log-output');
  const codeEl = document.getElementById('code-display');
  const replLink = document.getElementById('btn-strudel-repl');
  const copyBtn = document.getElementById('btn-copy-code');
  const volSlider = document.getElementById('vol-slider');
  const volDisplay = document.getElementById('vol-display');
  const subBtns = document.querySelectorAll('.subroutine-card');
  const detailName = document.getElementById('detail-name');
  const detailDesc = document.getElementById('detail-desc');
  const canvasTrackLabel = document.getElementById('canvas-track-label');
  const canvasBpmLabel = document.getElementById('canvas-bpm-label');

  function appendLog(msg, prefix = '>') {
    const now = new Date();
    const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
    const span = document.createElement('span');
    span.className = 'log-entry';
    span.innerHTML = `<span class="log-time">[${timeStr}]</span> <span class="log-prefix">${prefix}</span> <span class="log-msg">${msg}</span>`;
    logEl.appendChild(span);
    logEl.scrollTop = logEl.scrollHeight;
  }

  function getAudioContext() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window['webkitAudioContext'];
      audioCtx = new AudioContextClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      masterGain = audioCtx.createGain();
      masterGain.gain.setValueAtTime(parseFloat(volSlider.value), audioCtx.currentTime);
      masterGain.connect(analyser);
      analyser.connect(audioCtx.destination);
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // WaveShaper for electric guitar rock distortion
  function makeDistortionCurve(amount = 50) {
    const k = amount;
    const n_samples = 44100;
    const curve = new Float32Array(n_samples);
    const deg = Math.PI / 180;
    for (let i = 0; i < n_samples; ++i) {
      const x = (i * 2) / n_samples - 1;
      curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
    }
    return curve;
  }

  // Multi-phased Procedural Audio Engine for the Trojan Simulator
  function startNativeSynth(varId, bpm) {
    const ctx = getAudioContext();
    const intervalSec = (60 / bpm) / 4; // 16th notes
    let step = 0;
    const distortionCurve = makeDistortionCurve(45);

    // Inverted Santana (Black Magic Woman) Notes in D minor (reversed melodic contour)
    const santanaInvertedNotes = [
      587.33, // D5
      440.00, // A4
      349.23, // F4
      523.25, // C5
      392.00, // G4
      329.63, // E4
      466.16, // Bb4
      349.23, // F4
      293.66, // D4
      440.00, // A4
      329.63, // E4
      277.18  // C#4
    ];

    synthInterval = setInterval(() => {
      const time = ctx.currentTime;
      const measure = Math.floor(step / 16);

      // Determine current mode if in Suite or specific act
      let currentPhase = 'sandbox';
      if (varId === 'fork-suite') {
        if (measure < 4) currentPhase = 'sandbox';
        else if (measure < 8) currentPhase = 'march';
        else currentPhase = 'rave';
      } else if (varId === 'fork-sandbox') {
        currentPhase = 'sandbox';
      } else if (varId === 'fork-march') {
        currentPhase = 'march';
      } else if (varId === 'fork-rave') {
        currentPhase = 'rave';
      }

      // --- PHASE 1: SANDBOX & CABALLO DE TROYA ---
      if (currentPhase === 'sandbox') {
        // Kick on 1 and 9
        if (step % 8 === 0) {
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(130, time);
          osc.frequency.exponentialRampToValueAtTime(36, time + 0.15);
          g.gain.setValueAtTime(0.75, time);
          g.gain.exponentialRampToValueAtTime(0.001, time + 0.18);
          osc.connect(g);
          g.connect(masterGain);
          osc.start(time);
          osc.stop(time + 0.18);
        }

        // Tense Bass
        if (step % 4 === 0) {
          const bass = ctx.createOscillator();
          const f = ctx.createBiquadFilter();
          const g = ctx.createGain();
          bass.type = 'sawtooth';
          const bassFreqs = [65.41, 77.78, 87.31, 92.50]; // C2, Eb2, F2, F#2
          bass.frequency.setValueAtTime(bassFreqs[(step / 4) % bassFreqs.length], time);
          f.type = 'lowpass';
          f.frequency.setValueAtTime(700, time);
          g.gain.setValueAtTime(0.3, time);
          g.gain.exponentialRampToValueAtTime(0.001, time + 0.25);
          bass.connect(f);
          f.connect(g);
          g.connect(masterGain);
          bass.start(time);
          bass.stop(time + 0.25);
        }

        // Trojan Bright Arpeggio (Deceptive Brightness / Positive Mask)
        if (step % 2 === 0) {
          const chime = ctx.createOscillator();
          const g = ctx.createGain();
          chime.type = 'triangle';
          const brightNotes = [523.25, 659.25, 783.99, 987.77, 1046.50, 1174.66, 739.99]; // High C5, E5, G5, B5, C6, D6, F#5
          chime.frequency.setValueAtTime(brightNotes[(step / 2) % brightNotes.length], time);
          g.gain.setValueAtTime(0.14, time);
          g.gain.exponentialRampToValueAtTime(0.001, time + 0.18);
          chime.connect(g);
          g.connect(masterGain);
          chime.start(time);
          chime.stop(time + 0.18);
        }

        // Subtle Hi-hats
        if (step % 2 === 1) {
          triggerNoiseHat(ctx, time, 0.12, 4500);
        }
      }

      // --- PHASE 2: MARCHA IMPERIAL & FLATLINE 1990s ---
      else if (currentPhase === 'march') {
        const marchMeasure = measure % 4;

        if (marchMeasure < 3) {
          // Militaristic Snare Roll (Imperial March)
          const snareGain = (step % 4 === 0) ? 0.6 : (step % 2 === 0 ? 0.35 : 0.2);
          triggerNoiseHat(ctx, time, snareGain, 1200);

          // Authoritarian Stabs
          if (step % 4 === 0) {
            const stab = ctx.createOscillator();
            const f = ctx.createBiquadFilter();
            const g = ctx.createGain();
            stab.type = 'sawtooth';
            stab.frequency.setValueAtTime(130.81, time); // C3
            f.type = 'bandpass';
            f.frequency.setValueAtTime(1400, time);
            g.gain.setValueAtTime(0.4, time);
            g.gain.exponentialRampToValueAtTime(0.001, time + 0.18);
            stab.connect(f);
            f.connect(g);
            g.connect(masterGain);
            stab.start(time);
            stab.stop(time + 0.18);
          }
        } else {
          // BASS ELIMINATED: Vital signs EKG flatline beep + 1990s dial-up glitch
          if (step % 8 === 0) {
            // EKG vital sign beep (monotone high sine)
            const beep = ctx.createOscillator();
            const g = ctx.createGain();
            beep.type = 'sine';
            beep.frequency.setValueAtTime(1046.50, time); // C6 flatline
            g.gain.setValueAtTime(0.35, time);
            g.gain.exponentialRampToValueAtTime(0.001, time + 0.08);
            beep.connect(g);
            g.connect(masterGain);
            beep.start(time);
            beep.stop(time + 0.08);
          }

          if (step % 4 === 2) {
            // Dial-up 56k handshake squeal chirp
            const modem = ctx.createOscillator();
            const g = ctx.createGain();
            modem.type = 'square';
            const chirpFreq = 1800 + Math.sin(step * 3) * 600;
            modem.frequency.setValueAtTime(chirpFreq, time);
            g.gain.setValueAtTime(0.08, time);
            g.gain.exponentialRampToValueAtTime(0.001, time + 0.06);
            modem.connect(g);
            g.connect(masterGain);
            modem.start(time);
            modem.stop(time + 0.06);
          }
        }
      }

      // --- PHASE 3: SANTANA INVERSION & RECYCLING TECHNO RAVE ---
      else if (currentPhase === 'rave') {
        // Heavy 4/4 Techno Rave Kick
        if (step % 4 === 0) {
          const kick = ctx.createOscillator();
          const g = ctx.createGain();
          kick.type = 'sine';
          kick.frequency.setValueAtTime(160, time);
          kick.frequency.exponentialRampToValueAtTime(38, time + 0.18);
          g.gain.setValueAtTime(0.95, time);
          g.gain.exponentialRampToValueAtTime(0.001, time + 0.22);
          kick.connect(g);
          g.connect(masterGain);
          kick.start(time);
          kick.stop(time + 0.22);
        }

        // Off-beat Rave Hi-hats
        if (step % 4 === 2) {
          triggerNoiseHat(ctx, time, 0.45, 6000);
        }

        // Acid 303 Bassline fighting the march
        if (step % 2 === 0) {
          const acid = ctx.createOscillator();
          const filter = ctx.createBiquadFilter();
          const g = ctx.createGain();
          acid.type = 'sawtooth';
          const acidNotes = [73.42, 87.31, 98.00, 116.54, 138.59, 146.83];
          acid.frequency.setValueAtTime(acidNotes[(step / 2) % acidNotes.length], time);
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(800 + Math.sin(step * 0.4) * 1600, time);
          filter.Q.value = 14;
          g.gain.setValueAtTime(0.35, time);
          g.gain.exponentialRampToValueAtTime(0.001, time + 0.14);
          acid.connect(filter);
          filter.connect(g);
          g.connect(masterGain);
          acid.start(time);
          acid.stop(time + 0.14);
        }

        // Electric Rock Guitar Lead: Black Magic Woman inverted phrases
        if (step % 3 === 0 || step % 7 === 0) {
          const guitar = ctx.createOscillator();
          const shaper = ctx.createWaveShaper();
          const filter = ctx.createBiquadFilter();
          const g = ctx.createGain();
          guitar.type = 'sawtooth';
          const guitarFreq = santanaInvertedNotes[(step / 3) % santanaInvertedNotes.length];
          guitar.frequency.setValueAtTime(guitarFreq, time);
          shaper.curve = distortionCurve;
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(2600, time);
          g.gain.setValueAtTime(0.25, time);
          g.gain.exponentialRampToValueAtTime(0.001, time + 0.38);
          guitar.connect(shaper);
          shaper.connect(filter);
          filter.connect(g);
          g.connect(masterGain);
          guitar.start(time);
          guitar.stop(time + 0.38);
        }
      }

      step++;
    }, intervalSec * 1000);
  }

  function triggerNoiseHat(ctx, time, volume, freq) {
    const bufferSize = ctx.sampleRate * 0.04;
    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = Math.random() * 2 - 1;
    }
    const noise = ctx.createBufferSource();
    noise.buffer = buffer;
    const filter = ctx.createBiquadFilter();
    filter.type = 'highpass';
    filter.frequency.value = freq;
    const g = ctx.createGain();
    g.gain.setValueAtTime(volume, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.038);
    noise.connect(filter);
    filter.connect(g);
    g.connect(masterGain);
    noise.start(time);
    noise.stop(time + 0.04);
  }

  function stopNativeSynth() {
    if (synthInterval) {
      clearInterval(synthInterval);
      synthInterval = null;
    }
  }

  // Oscilloscope & Spectrum Visualizer
  function drawVisualizer() {
    if (!canvas) return;
    const width = canvas.width = canvas.clientWidth;
    const height = canvas.height = canvas.clientHeight;

    if (!analyser || !isPlaying) {
      canvasCtx.fillStyle = '#03060a';
      canvasCtx.fillRect(0, 0, width, height);
      canvasCtx.strokeStyle = 'rgba(0, 255, 157, 0.25)';
      canvasCtx.lineWidth = 1;
      canvasCtx.beginPath();
      canvasCtx.moveTo(0, height / 2);
      canvasCtx.lineTo(width, height / 2);
      canvasCtx.stroke();
      return;
    }

    const bufferLength = analyser.frequencyBinCount;
    const timeData = new Uint8Array(bufferLength);
    analyser.getByteTimeDomainData(timeData);

    const freqData = new Uint8Array(bufferLength);
    analyser.getByteFrequencyData(freqData);

    canvasCtx.fillStyle = 'rgba(3, 6, 10, 0.35)';
    canvasCtx.fillRect(0, 0, width, height);

    // Spectrum bars
    const barWidth = (width / bufferLength) * 2;
    let x = 0;
    for (let i = 0; i < bufferLength; i++) {
      const barHeight = (freqData[i] / 255) * height * 0.72;
      canvasCtx.fillStyle = `rgba(0, 229, 255, ${0.1 + (freqData[i] / 255) * 0.45})`;
      canvasCtx.fillRect(x, height - barHeight, barWidth - 1, barHeight);
      x += barWidth;
    }

    // Oscilloscope waveform on top
    canvasCtx.lineWidth = 2;
    canvasCtx.strokeStyle = '#00ff9d';
    canvasCtx.shadowBlur = 8;
    canvasCtx.shadowColor = '#00ff9d';
    canvasCtx.beginPath();

    const sliceWidth = width / bufferLength;
    let wx = 0;
    for (let i = 0; i < bufferLength; i++) {
      const v = timeData[i] / 128.0;
      const y = (v * height) / 2;
      if (i === 0) {
        canvasCtx.moveTo(wx, y);
      } else {
        canvasCtx.lineTo(wx, y);
      }
      wx += sliceWidth;
    }
    canvasCtx.stroke();
    canvasCtx.shadowBlur = 0;

    requestAnimationFrame(drawVisualizer);
  }

  async function startAudioStream() {
    appendLog(`Inicializando simulación en sandbox para subrutina: ${activeVar.name}...`);
    statusEl.textContent = `ESTADO: TRANSMITIENDO [${activeVar.name.toUpperCase()}]`;
    statusEl.className = 'term-badge badge-green';

    getAudioContext();

    // Start procedural synth
    startNativeSynth(activeVar.id, activeVar.bpm);
    appendLog(`Motor DSP procedural activo a ${activeVar.bpm} BPM.`);

    if (activeVar.id === 'fork-suite') {
      appendLog(`[Fase 1] Caballo de Troya: arpegios brillantes en máscara.`);
    } else if (activeVar.id === 'fork-march') {
      appendLog(`[Marcha Totalitaria] Cadencia uniforme y flatline con modem 56k.`);
    } else if (activeVar.id === 'fork-rave') {
      appendLog(`[Inversión Santana & Rave] Guitarra rock invertida y Techno demoledor.`);
    }

    // Connect to Strudel in parallel
    try {
      if (!strudelModule) {
        strudelModule = await import('https://unpkg.com/@strudel/web@1.3.0/dist/index.mjs');
        if (strudelModule && strudelModule.initStrudel) {
          await strudelModule.initStrudel();
        }
      }
      if (strudelModule && strudelModule.evaluate) {
        strudelModule.evaluate(activeVar.code);
        appendLog(`Kernel Strudel evaluando patrones TidalCycles.`);
      }
    } catch (e) {
      appendLog(`Aviso Strudel externo: ${e.message || 'offline'}. Ejecutando en DSP nativo Web Audio.`);
    }

    isPlaying = true;
    playGlyph.textContent = '⏸';
    playText.textContent = 'PAUSAR TRANSMISIÓN';
    stopBtn.disabled = false;
    drawVisualizer();
  }

  function stopAudioStream() {
    stopNativeSynth();
    if (strudelModule && strudelModule.hush) {
      try { strudelModule.hush(); } catch(e){}
    }
    isPlaying = false;
    statusEl.textContent = 'ESTADO: TRANSMISIÓN DETENIDA';
    statusEl.className = 'term-badge badge-amber';
    playGlyph.textContent = '▶';
    playText.textContent = 'REANUDAR TRANSMISIÓN';
    stopBtn.disabled = true;
    appendLog('Transmisión detenida por el operador.');
    drawVisualizer();
  }

  playBtn.addEventListener('click', () => {
    if (isPlaying) {
      stopAudioStream();
    } else {
      startAudioStream();
    }
  });

  stopBtn.addEventListener('click', () => {
    stopAudioStream();
    playText.textContent = 'INICIAR STREAM EN VIVO';
  });

  volSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    volDisplay.textContent = `${Math.round(val * 100)}%`;
    if (masterGain && audioCtx) {
      masterGain.gain.setValueAtTime(val, audioCtx.currentTime);
    }
  });

  subBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const varId = btn.getAttribute('data-var-id');
      const found = variations.find((v) => v.id === varId);
      if (!found) return;

      subBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      activeVar = found;
      detailName.textContent = found.name;
      detailDesc.textContent = found.description;
      canvasTrackLabel.textContent = `TRACK: BACKUP // ${found.name.toUpperCase()}`;
      canvasBpmLabel.textContent = `BPM: ${found.bpm} // 48.0 kHz ESTÉREO`;
      codeEl.textContent = found.code;
      replLink.href = `https://strudel.cc/#${encodeURIComponent(found.code)}`;

      appendLog(`Conmutado a: ${found.name} (${found.bpm} BPM)`);

      if (isPlaying) {
        stopNativeSynth();
        startNativeSynth(found.id, found.bpm);
        if (strudelModule && strudelModule.evaluate) {
          try { strudelModule.evaluate(found.code); } catch(e){}
        }
      }
    });
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(activeVar.code);
      const prev = copyBtn.textContent;
      copyBtn.textContent = '[ ¡CÓDIGO COPIADO! ]';
      setTimeout(() => { copyBtn.textContent = prev; }, 2000);
      appendLog('Código algorítmico copiado al portapapeles.');
    } catch (e) {
      console.warn(e);
    }
  });

  // Initial draw
  drawVisualizer();
</script>

