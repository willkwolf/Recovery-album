    dom.stripButtons.forEach((btn, sIdx) => {
      btn.addEventListener('click', () => {
        selectDeckSection(idx, sIdx);
      });
    });
  });

  // DRAG & SELECTION ANNOTATION SYSTEM (Exclusivo para Deck 2 / Challenger)
  const challengerWaveformTrack = deckDOM[1].waveformTrack;
  let isSelecting = false;
  let selectStartPx = 0;
  let selectStartTime = 0;

  function recalculateAnnotationOverlaps() {
    directorAnnotations.forEach((a1, i) => {
      a1.hasOverlap = directorAnnotations.some((a2, j) => {
        if (i === j) return false;
        return (a1.startSec < a2.endSec && a1.endSec > a2.startSec);
      });
    });
  }

  function renderAnnotationMarkers() {
    if (!annotationsMarkersLayer) return;
    annotationsMarkersLayer.innerHTML = '';
    const trackWidth = challengerWaveformTrack ? challengerWaveformTrack.clientWidth : 0;
    const { headerW, timelineW, visibleDur } = getChallengerLayoutMetrics(trackWidth);

    directorAnnotations.forEach((ann, idx) => {
      let leftStyle, widthStyle;
      if (trackWidth > 0 && timelineW > 0) {
        const leftPx = headerW + ((ann.startSec - scrollOffsetSec) / visibleDur) * timelineW;
        const rightPx = headerW + ((ann.endSec - scrollOffsetSec) / visibleDur) * timelineW;
        if (rightPx < headerW || leftPx > trackWidth) return;
        const clampedLeft = Math.max(headerW, Math.min(trackWidth, leftPx));
        const clampedRight = Math.max(headerW, Math.min(trackWidth, rightPx));
        const widthPx = Math.max(4, clampedRight - clampedLeft);
        leftStyle = `${clampedLeft}px`;
        widthStyle = `${widthPx}px`;
      } else {
        leftStyle = `${(ann.startSec / decks[1].duration) * 100}%`;
        widthStyle = `${Math.max(0.5, ((ann.endSec - ann.startSec) / decks[1].duration) * 100)}%`;
      }

      const marker = document.createElement('div');
      marker.className = `annotation-timeline-marker ${ann.hasOverlap ? 'marker-has-overlap' : ''}`;
      marker.style.left = leftStyle;
      marker.style.width = widthStyle;
      marker.title = `[Nota ${idx + 1}] ${ann.startStr} - ${ann.endStr}: ${ann.note}`;
      annotationsMarkersLayer.appendChild(marker);
    });

    renderAnnotationsChips();
  }

  function renderAnnotationsChips() {
    if (!directorAnnotationsBar || !annotationsChipsList || !annotationsCountEl) return;
    annotationsCountEl.textContent = directorAnnotations.length;
    directorAnnotationsBar.style.display = directorAnnotations.length > 0 ? 'block' : 'none';
    annotationsChipsList.innerHTML = '';

    directorAnnotations.forEach((ann, idx) => {
      const chip = document.createElement('div');
      chip.className = `ann-chip ${ann.hasOverlap ? 'ann-chip-overlap' : ''}`;

      const textSpan = document.createElement('span');
      textSpan.className = 'ann-chip-text mono';
      const overlapBadge = ann.hasOverlap ? ' 🔀 [Falta Crossfader]' : '';
      textSpan.textContent = `[${ann.startStr} - ${ann.endStr}] ${ann.note}${overlapBadge}`;

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'ann-chip-del';
      deleteBtn.setAttribute('aria-label', `Eliminar nota ${idx + 1}`);
      deleteBtn.textContent = '✕';
      deleteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        directorAnnotations.splice(idx, 1);
        recalculateAnnotationOverlaps();
        renderAnnotationMarkers();
        generateVibePrompt();
      });

      chip.appendChild(textSpan);
      chip.appendChild(deleteBtn);
      chip.addEventListener('click', () => {
        selStart = ann.startSec;
        selEnd = ann.endSec;
        seekDeck(1, ann.startSec);
        updateSelectionOverlays();
        generateVibePrompt();
      });
      annotationsChipsList.appendChild(chip);
    });
  }

  function openAnnotationPopover(startSec, endSec, clientX) {
    if (!annotationPopover || !popoverRangeLabel || !popoverNoteInput) return;
    const sStart = Math.min(startSec, endSec);
    const sEnd = Math.max(startSec, endSec);
    pendingAnnotationRange = {
      startSec: Math.round(sStart),
      endSec: Math.round(sEnd),
      durSec: Math.round(sEnd - sStart),
      startStr: formatTime(sStart),
      endStr: formatTime(sEnd)
    };

    popoverRangeLabel.textContent = `RANGO: ${pendingAnnotationRange.startStr} ── ${pendingAnnotationRange.endStr} (${pendingAnnotationRange.durSec}s)`;
    popoverNoteInput.value = '';

    // Posicionamiento horizontal relativo a la pista
    const trackRect = challengerWaveformTrack.getBoundingClientRect();
    const relativeX = clientX - trackRect.left;
    const clampedX = Math.max(12, Math.min(trackRect.width - 240, relativeX - 100));
    annotationPopover.style.left = `${clampedX}px`;
    annotationPopover.style.display = 'flex';
    popoverNoteInput.focus();
  }

  function closeAnnotationPopover() {
    if (annotationPopover) {
      annotationPopover.style.display = 'none';
      pendingAnnotationRange = null;
    }
    if (selectionDraftOverlay) {
      selectionDraftOverlay.style.display = 'none';
    }
  }

  if (challengerWaveformTrack) {
    challengerWaveformTrack.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return; // Solo click izquierdo
      if (annotationPopover && annotationPopover.contains(e.target)) return;
      if (timelineContextMenu && timelineContextMenu.contains(e.target)) return;
      if (timelineContextMenu) timelineContextMenu.style.display = 'none';

      const rect = challengerWaveformTrack.getBoundingClientRect();
      const { headerW, timelineW, visibleDur } = getChallengerLayoutMetrics(rect.width);
      const rulerH = 24;
      const numTracks = abletonTracks.length;
      const laneH = (rect.height - rulerH) / numTracks;
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      // Clic dentro de la columna de cabecera de pistas (Header lateral izquierdo)
      if (clickX < headerW) {
        if (clickY < rulerH) {
          // Esquina superior "PISTAS 09": reset/toggle zoom fit
          zoomLevel = (zoomLevel === 1.0) ? 2.0 : 1.0;
          scrollOffsetSec = 0;
          if (zoomLevelBadge) zoomLevelBadge.textContent = `${Math.round(zoomLevel * 100)}%`;
          drawWaveforms();
          updateSelectionOverlays();
          updateDeckUI(1);
          renderAnnotationMarkers();
          return;
        }

        const tIdx = Math.max(0, Math.min(numTracks - 1, Math.floor((clickY - rulerH) / laneH)));
        selectedTrackIdx = tIdx;

        // Botón Mute en cabecera [ON] / [M] (headerW - 38 .. headerW - 20)
        if (clickX >= headerW - 38 && clickX <= headerW - 20) {
          tracksMuted[tIdx] = !tracksMuted[tIdx];
          syncChannelStripUI();
          drawWaveforms();
          return;
        }

        // Botón Solo en cabecera [S] (headerW - 17 .. headerW - 3)
        if (clickX >= headerW - 17 && clickX <= headerW - 3) {
          soloTrackIdx = (soloTrackIdx === tIdx ? null : tIdx);
          syncChannelStripUI();
          drawWaveforms();
          return;
        }

        // Clic en el nombre o color: seleccionar pista
        syncChannelStripUI();
        updateSelectionOverlays();
        drawWaveforms();
        return;
      }

      // Clic en el Ruler superior (Seek inmediato del cabezal)
      if (clickY < rulerH) {
        const targetTime = Math.max(0, Math.min(decks[1].duration, scrollOffsetSec + ((clickX - headerW) / timelineW) * visibleDur));
        seekDeck(1, targetTime);
        return;
      }

      // Clic dentro de los carriles (lanes) de las pistas
      const tIdx = Math.max(0, Math.min(numTracks - 1, Math.floor((clickY - rulerH) / laneH)));
      selectedTrackIdx = tIdx;

      isSelecting = true;
      selectStartPx = Math.max(0, Math.min(timelineW, clickX - headerW));
      selectStartTime = Math.max(0, Math.min(decks[1].duration, scrollOffsetSec + (selectStartPx / timelineW) * visibleDur));

      if (selectionDraftOverlay) {
        selectionDraftOverlay.style.left = `${headerW + selectStartPx}px`;
        selectionDraftOverlay.style.width = '0px';
        selectionDraftOverlay.style.display = 'block';
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isSelecting) return;
      const rect = challengerWaveformTrack.getBoundingClientRect();
      const { headerW, timelineW } = getChallengerLayoutMetrics(rect.width);
      const currentX = e.clientX - rect.left;
      const currentPx = Math.max(0, Math.min(timelineW, currentX - headerW));
      const leftPx = Math.min(selectStartPx, currentPx);
      const widthPx = Math.abs(currentPx - selectStartPx);

      if (selectionDraftOverlay) {
        selectionDraftOverlay.style.left = `${headerW + leftPx}px`;
        selectionDraftOverlay.style.width = `${Math.max(1, widthPx)}px`;
      }
    });

    window.addEventListener('mouseup', (e) => {
      if (!isSelecting) return;
      isSelecting = false;

      const rect = challengerWaveformTrack.getBoundingClientRect();
      const { headerW, timelineW, visibleDur } = getChallengerLayoutMetrics(rect.width);
      const currentX = e.clientX - rect.left;

      if (currentX < headerW && selectStartPx === 0) {
        if (selectionDraftOverlay) selectionDraftOverlay.style.display = 'none';
        return;
      }

      const endPx = Math.max(0, Math.min(timelineW, currentX - headerW));
      const widthPx = Math.abs(endPx - selectStartPx);

      // Si el arrastre es muy corto (< 6px), tratar como click de selección de clip o seek habitual
      if (widthPx < 6) {
        if (selectionDraftOverlay) selectionDraftOverlay.style.display = 'none';
        const clickTime = Math.max(0, Math.min(decks[1].duration, scrollOffsetSec + (selectStartPx / timelineW) * visibleDur));
        seekDeck(1, clickTime);

        // Si se hizo click sobre un clip de la pista seleccionada, fijar su rango exacto
        const track = abletonTracks[selectedTrackIdx];
        if (track && track.clips) {
          const foundClip = track.clips.find(c => clickTime >= c.startSec && clickTime < c.endSec);
          if (foundClip) {
            activeTargetDeck = 1;
            selStart = foundClip.startSec;
            selEnd = foundClip.endSec;
            updateTargetDeckUI();
            updateSelectionOverlays();
            generateVibePrompt();
            drawWaveforms();
            return;
          }
        }
        drawWaveforms();
        return;
      }

      // Rango seleccionado válido para anotación y edición DAW
      const t1 = Math.max(0, Math.min(decks[1].duration, scrollOffsetSec + (Math.min(selectStartPx, endPx) / timelineW) * visibleDur));
      const t2 = Math.max(0, Math.min(decks[1].duration, scrollOffsetSec + (Math.max(selectStartPx, endPx) / timelineW) * visibleDur));

      activeTargetDeck = 1;
      selStart = t1;
      selEnd = t2;
      seekDeck(1, t1);
      updateTargetDeckUI();
      updateSelectionOverlays();
      drawWaveforms();

      openAnnotationPopover(t1, t2, e.clientX);
    });

    // Soporte para Zoom con Ctrl+Rueda y Scroll/Pan horizontal en la pista
    challengerWaveformTrack.addEventListener('wheel', (e) => {
      const rect = challengerWaveformTrack.getBoundingClientRect();
      const { headerW, timelineW } = getChallengerLayoutMetrics(rect.width);
      const cursorX = e.clientX - rect.left;

      if (e.ctrlKey) {
        e.preventDefault();
        const zoomDelta = e.deltaY < 0 ? 0.3 : -0.3;
        const oldZoom = zoomLevel;
        zoomLevel = Math.max(1.0, Math.min(4.0, +(zoomLevel + zoomDelta).toFixed(2)));
        if (zoomLevelBadge) zoomLevelBadge.textContent = `${Math.round(zoomLevel * 100)}%`;

        if (cursorX >= headerW && timelineW > 0) {
          const cursorTimeRel = ((cursorX - headerW) / timelineW) * (decks[1].duration / oldZoom);
          const cursorAbsTime = scrollOffsetSec + cursorTimeRel;
          const newVisibleDur = decks[1].duration / zoomLevel;
          scrollOffsetSec = Math.max(0, Math.min(decks[1].duration - newVisibleDur, cursorAbsTime - ((cursorX - headerW) / timelineW) * newVisibleDur));
        }

        drawWaveforms();
        updateSelectionOverlays();
        updateDeckUI(1);
        renderAnnotationMarkers();
      } else if (e.shiftKey || Math.abs(e.deltaX) > 0 || Math.abs(e.deltaY) > 0) {
        e.preventDefault();
        const visibleDur = decks[1].duration / zoomLevel;
        const maxScroll = Math.max(0, decks[1].duration - visibleDur);
        const panDelta = (e.deltaX || e.deltaY) * 0.04 * (visibleDur / 100);
        scrollOffsetSec = Math.max(0, Math.min(maxScroll, scrollOffsetSec + panDelta));
        drawWaveforms();
        updateSelectionOverlays();
        updateDeckUI(1);
        renderAnnotationMarkers();
      }
    }, { passive: false });
  }

  if (btnPopoverSave) {
    btnPopoverSave.addEventListener('click', () => {
      if (!pendingAnnotationRange) return;
      const noteText = popoverNoteInput.value.trim() || 'Ajuste solicitado por el Director General en este rango.';
      directorAnnotations.push({
        ...pendingAnnotationRange,
        note: noteText,
        hasOverlap: false
      });
      recalculateAnnotationOverlaps();
      renderAnnotationMarkers();
      generateVibePrompt();
      closeAnnotationPopover();
    });
  }

  if (btnPopoverClose) {
    btnPopoverClose.addEventListener('click', closeAnnotationPopover);
  }

  if (btnClearAnnotations) {
    btnClearAnnotations.addEventListener('click', () => {
      directorAnnotations = [];
      renderAnnotationMarkers();
      generateVibePrompt();
    });
  }

  // Target Deck Selector buttons
  btnSelectDeck0.addEventListener('click', () => {
    activeTargetDeck = 0;
    const d = decks[0];
    const sec = d.sections[d.activeSecIdx];
    selStart = sec ? sec.startSec : 0;
    selEnd = sec ? sec.endSec : 75;
    updateTargetDeckUI();
    updateSelectionOverlays();
    generateVibePrompt();
  });

  btnSelectDeck1.addEventListener('click', () => {
    activeTargetDeck = 1;
    const d = decks[1];
    const sec = d.sections[d.activeSecIdx];
    selStart = sec ? sec.startSec : 0;
    selEnd = sec ? sec.endSec : 65;
    updateTargetDeckUI();
    updateSelectionOverlays();
    generateVibePrompt();
  });

  // Mutation Tags Rendering & Compact + Dropdown System
  let lastFocusedRole = 'CP'; // Agente objetivo por defecto

  function renderAgentMutationTags() {
    // 1. Renderizar en las tarjetas de directivas por rol
    Object.keys(roleTagsContainers).forEach(role => {
      const container = roleTagsContainers[role];
      if (!container) return;
      container.innerHTML = '';
      const tags = agentMutationTags[role] || new Set();
      if (tags.size === 0) {
        const emptySpan = document.createElement('span');
        emptySpan.className = 'mono text-xs text-muted role-tag-empty';
        emptySpan.textContent = 'Sin tags asignados';
        container.appendChild(emptySpan);
        return;
      }
      tags.forEach(tId => {
        const def = tagDefinitions[tId] || { label: tId };
        const badge = document.createElement('span');
        badge.className = 'role-tag-badge mono';
        badge.innerHTML = `<span>${def.label}</span><button type="button" class="btn-remove-tag" data-role="${role}" data-tag="${tId}" aria-label="Remover tag ${tId}">✕</button>`;
        container.appendChild(badge);
      });
    });

    // 2. Renderizar pills en la barra compacta superior
    if (mutationActivePills) {
      mutationActivePills.innerHTML = '';
      let totalTags = 0;
      Object.keys(agentMutationTags).forEach(role => {
        const tags = agentMutationTags[role] || new Set();
        tags.forEach(tId => {
          totalTags++;
          const def = tagDefinitions[tId] || { label: tId };
          const pill = document.createElement('span');
          pill.className = 'compact-tag-pill mono';
          pill.innerHTML = `<span class="pill-role">${role}</span><span>${def.label}</span><button type="button" class="btn-remove-tag" data-role="${role}" data-tag="${tId}" aria-label="Remover tag ${tId}">✕</button>`;
          mutationActivePills.appendChild(pill);
        });
      });
      if (totalTags === 0) {
        const hint = document.createElement('span');
        hint.className = 'mono text-xs text-muted';
        hint.id = 'empty-tags-hint';
        hint.textContent = 'Sin tags activos (Limpio)';
        mutationActivePills.appendChild(hint);
      }
    }

    // 3. Actualizar estados visuales del dropdown
    const allAssigned = new Set();
    Object.values(agentMutationTags).forEach(s => s.forEach(t => allAssigned.add(t)));
    document.querySelectorAll('.tag-menu-item').forEach(item => {
      const tId = item.getAttribute('data-tag-id');
      const isAssigned = allAssigned.has(tId);
      item.classList.toggle('tag-item-active', isAssigned);
      item.setAttribute('aria-pressed', isAssigned ? 'true' : 'false');
    });
  }

  // Toggle Dropdown de Tags al hacer click en el botón +
  if (btnAddMutationTag && mutationDropdownMenu) {
    btnAddMutationTag.addEventListener('click', (e) => {
      e.stopPropagation();
      const isShown = mutationDropdownMenu.style.display !== 'none';
      mutationDropdownMenu.style.display = isShown ? 'none' : 'flex';
      btnAddMutationTag.setAttribute('aria-expanded', (!isShown).toString());
    });

    document.addEventListener('click', (e) => {
      if (mutationDropdownMenu && !mutationDropdownMenu.contains(e.target) && !btnAddMutationTag.contains(e.target)) {
        mutationDropdownMenu.style.display = 'none';
        btnAddMutationTag.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Click en items del menú dropdown de tags
  document.querySelectorAll('.tag-menu-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      const tId = item.getAttribute('data-tag-id');
      const targetRole = lastFocusedRole || 'CP';
      if (!agentMutationTags[targetRole]) agentMutationTags[targetRole] = new Set();
      if (agentMutationTags[targetRole].has(tId)) {
        agentMutationTags[targetRole].delete(tId);
      } else {
        agentMutationTags[targetRole].add(tId);
      }
      renderAgentMutationTags();
      generateVibePrompt();
    });
  });

  // Delegación de eventos para remover tags
  document.addEventListener('click', (e) => {
    const removeBtn = e.target.closest('.btn-remove-tag');
    if (removeBtn) {
      const role = removeBtn.getAttribute('data-role');
      const tag = removeBtn.getAttribute('data-tag');
      if (agentMutationTags[role]) {
        agentMutationTags[role].delete(tag);
        renderAgentMutationTags();
        generateVibePrompt();
      }
    }
  });

  // Configurar tarjetas de roles para Drag & Drop y foco táctico
  Object.keys(roleCards).forEach(role => {
    const card = roleCards[role];
    if (card) {
      card.addEventListener('click', () => {
        lastFocusedRole = role;
        Object.values(roleCards).forEach(c => c && c.classList.remove('role-card-focused'));
        card.classList.add('role-card-focused');
      });

      card.addEventListener('dragover', (e) => {
        e.preventDefault();
        card.classList.add('role-card-dragover');
      });

      card.addEventListener('dragleave', () => {
        card.classList.remove('role-card-dragover');
      });

      card.addEventListener('drop', (e) => {
        e.preventDefault();
        card.classList.remove('role-card-dragover');
        const tagId = e.dataTransfer.getData('text/plain');
        if (tagId && tagDefinitions[tagId]) {
          if (!agentMutationTags[role]) agentMutationTags[role] = new Set();
          agentMutationTags[role].add(tagId);
          renderAgentMutationTags();
          generateVibePrompt();
        }
      });
    }
  });

  // FLOATING SELECTION DOCK (Inspirado en Suno Studio)
  if (dockQuickPromptInput) {
    dockQuickPromptInput.addEventListener('input', (e) => {
      vibeDirectorNote.value = e.target.value;
      generateVibePrompt();
    });
    dockQuickPromptInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (btnDockQuickSubmit) btnDockQuickSubmit.click();
      }
    });
  }

  if (dockEngineSelect) {
    dockEngineSelect.addEventListener('change', (e) => {
      const selectedEngine = e.target.value;
      const curTrack = abletonTracks[selectedTrackIdx];
      if (curTrack) {
        curTrack.sub = selectedEngine;
      }
      if (roleInputs.SD) {
        roleInputs.SD.value = `Motor para ${curTrack ? curTrack.name : 'Pista'}: ${selectedEngine}. Formantes y filtros adaptados.`;
      }
      drawWaveforms();
      generateVibePrompt();
    });
  }

  if (vibeDirectorNote) {
    vibeDirectorNote.addEventListener('input', (e) => {
      if (dockQuickPromptInput) {
        dockQuickPromptInput.value = e.target.value;
      }
    });
  }

  if (btnDockQuickSubmit) {
    btnDockQuickSubmit.addEventListener('click', () => {
      generateVibePrompt();
      if (btnCopyVibePrompt) {
        btnCopyVibePrompt.click();
      }
      btnDockQuickSubmit.classList.add('btn-dock-copied');
      btnDockQuickSubmit.innerHTML = '<span>✅ Copiado</span>';
      setTimeout(() => {
        btnDockQuickSubmit.classList.remove('btn-dock-copied');
        btnDockQuickSubmit.innerHTML = '<span aria-hidden="true">↑</span><span>Despachar</span>';
      }, 1500);
    });
  }

  if (btnDockClearSel) {
    btnDockClearSel.addEventListener('click', () => {
      const d1 = decks[1];
      const sec = d1.sections[d1.activeSecIdx] || d1.sections[0];
      selStart = sec.startSec;
      selEnd = sec.endSec;
      updateSelectionOverlays();
      generateVibePrompt();
    });
  }

  // TIMELINE CONTEXT MENU (Estilo DAW)
  const challengerTrackEl = deckDOM[1].waveformTrack;
  if (challengerTrackEl && timelineContextMenu) {
    challengerTrackEl.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      const rect = challengerTrackEl.getBoundingClientRect();
      const { headerW, timelineW, visibleDur } = getChallengerLayoutMetrics(rect.width);
      const rulerH = 24;
      const numTracks = abletonTracks.length;
      const laneH = (rect.height - rulerH) / numTracks;
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      const clickTime = Math.max(0, Math.min(decks[1].duration, scrollOffsetSec + (Math.max(0, clickX - headerW) / timelineW) * visibleDur));
      const clickedTrackIdx = Math.max(0, Math.min(numTracks - 1, Math.floor(Math.max(0, clickY - rulerH) / laneH)));

      selectedTrackIdx = clickedTrackIdx;
      timelineContextMenu.dataset.clickTime = String(clickTime);
      timelineContextMenu.dataset.trackIdx = String(clickedTrackIdx);

      if (ctxMuteLabel) {
        ctxMuteLabel.textContent = tracksMuted[clickedTrackIdx] ? 'Desmutear Pista' : 'Silenciar Pista (Mute)';
      }

      timelineContextMenu.style.left = `${Math.min(window.innerWidth - 220, e.clientX)}px`;
      timelineContextMenu.style.top = `${e.clientY + 5}px`;
      timelineContextMenu.style.display = 'flex';
      drawWaveforms();
    });

    document.addEventListener('click', (e) => {
      if (!timelineContextMenu.contains(e.target) && e.target !== challengerTrackEl) {
        timelineContextMenu.style.display = 'none';
      }
    });
  }

  if (ctxBtnCopy) {
    ctxBtnCopy.addEventListener('click', () => {
      generateVibePrompt();
      if (btnCopyVibePrompt) btnCopyVibePrompt.click();
      if (timelineContextMenu) timelineContextMenu.style.display = 'none';
