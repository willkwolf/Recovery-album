  // Playback & Sound Engine
  let tickerStep = 0;
  function startPlayback(isRangePreview = false) {
    getAudioContext();
    isPlaying = true;
    isPreviewingRange = isRangePreview;
    playIcon.textContent = '⏸';
    playLabel.textContent = 'Pause';
    stopBtn.disabled = false;

    if (isRangePreview) {
      trackSeconds = selectionStart;
    }

    clockInterval = setInterval(() => {
      trackSeconds += 0.5;

      if (isPreviewingRange) {
        if (trackSeconds >= selectionEnd) {
          trackSeconds = selectionStart;
        }
      } else if (isLoopingSection && currentMode === 'challenger') {
        const sections = getActiveSections();
        const curSec = sections[activeSectionIndex];
        if (curSec && trackSeconds >= curSec.endSec) {
          trackSeconds = curSec.startSec;
        }
      } else {
        if (trackSeconds >= totalDuration) {
          trackSeconds = 0;
        }
      }
      updateUI();
    }, 500);

    soundTicker = setInterval(() => {
      const ctx = audioCtx;
      if (!ctx) return;
      const time = ctx.currentTime;
      const s = trackSeconds;

      // TRACK 01: BACKUP (FORK BASE & TROJAN SUITE)
      if (currentTrackIdx === 0) {
        if (currentMode === 'mutacion') {
          const stepInBar = tickerStep % 16;
          const barIdx = Math.floor(tickerStep / 16) % 4;
          const lfoFilterFreq = 1350 + Math.sin(tickerStep * 0.15) * 850;

          if (stepInBar === 0) {
            const dyad = forkDyads[barIdx];
            triggerForkChord(ctx, time, dyad[0], dyad[1], lfoFilterFreq, 2.0);
          }
          if (tickerStep % 2 === 0 || tickerStep % 7 === 3) {
            const mIdx = Math.floor(tickerStep * 1.75) % forkMelodyNotes.length;
            triggerForkMelody(ctx, time, forkMelodyNotes[mIdx], 0.38);
          }
          if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12 || stepInBar === 14) {
            const kickVol = (stepInBar === 0 || stepInBar === 12) ? 0.85 : 0.65;
            triggerKick(ctx, time, 135, 36, kickVol);
          }
          if (stepInBar === 0 || stepInBar === 3 || stepInBar === 6 || stepInBar === 10 || stepInBar === 13) {
            triggerNoise(ctx, time, 0.28, 2200, 0.035);
          }
          if (tickerStep % 4 === 1) {
            triggerNoise(ctx, time, 0.18, 4800, 0.02);
          }
        }
        else if (currentMode === 'challenger') {
          const stepInBar = tickerStep % 16;
          const barIdx = Math.floor(tickerStep / 16) % 4;

          // Sec 01: Fork Suspense (0:00 - 1:15)
          if (s < 75) {
            const lfoFilterFreq = 1350 + Math.sin(tickerStep * 0.15) * 850;
            if (stepInBar === 0) {
              const dyad = forkDyads[barIdx];
              triggerForkChord(ctx, time, dyad[0], dyad[1], lfoFilterFreq, 2.0);
            }
            if (tickerStep % 2 === 0) {
              const mIdx = Math.floor(tickerStep * 1.75) % forkMelodyNotes.length;
              triggerForkMelody(ctx, time, forkMelodyNotes[mIdx], 0.32);
            }
            if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12) {
              triggerKick(ctx, time, 135, 36, 0.8);
            }
            if (stepInBar % 2 === 1) {
              triggerNoise(ctx, time, 0.18, 3000, 0.03);
            }
          }
          // Sec 02: Trojan Chimes (1:15 - 2:00)
          else if (s >= 75 && s < 120) {
            if (stepInBar === 0) {
              const dyad = forkDyads[barIdx];
              triggerForkChord(ctx, time, dyad[0], dyad[1], 1200, 2.0);
            }
            if (tickerStep % 2 === 0) {
              const brightFreqs = [523.25, 659.25, 783.99, 987.77, 1046.50, 1174.66];
              triggerTriangle(ctx, time, brightFreqs[(tickerStep / 2) % brightFreqs.length], 0.22, 0.2);
            }
            if (stepInBar === 0 || stepInBar === 5 || stepInBar === 12) {
              triggerKick(ctx, time, 135, 36, 0.8);
            }
            if (stepInBar % 2 === 1) {
              triggerNoise(ctx, time, 0.16, 3200, 0.03);
            }
          }
          // Sec 03: Marcha Totalitaria (2:00 - 2:45)
          else if (s >= 120 && s < 165) {
            const snareVol = (tickerStep % 4 === 0) ? 0.65 : 0.35;
            triggerNoise(ctx, time, snareVol, 1400, 0.05);
            if (tickerStep % 4 === 0) {
              triggerSaw(ctx, time, 130.81, 0.35, 1600, 0.18);
            }
          }
          // Sec 04: Flatline & 56k Modem (2:45 - 3:25)
          else if (s >= 165 && s < 205) {
            if (tickerStep % 8 === 0) {
              triggerSine(ctx, time, 1046.50, 0.35, 0.07);
            }
            if (tickerStep % 4 === 2) {
              const chirpFreq = 1600 + Math.sin(tickerStep * 4) * 800;
              triggerSquare(ctx, time, chirpFreq, 0.09, 0.05);
            }
          }
          // Sec 05: Solo Rock Santana (3:25 - 4:05)
          else if (s >= 205 && s < 245) {
            if (tickerStep % 3 === 0 || tickerStep % 7 === 0) {
              const gFreq = santanaNotes[(tickerStep / 3) % santanaNotes.length];
              triggerGuitar(ctx, time, gFreq, 0.3, 0.4);
            }
          }
          // Sec 06: Rave Techno (4:05 - 5:15)
          else if (s >= 245 && s <= 315) {
            if (tickerStep % 4 === 0) {
              triggerKick(ctx, time, 160, 38, 0.95);
            }
            if (tickerStep % 4 === 2) {
              triggerNoise(ctx, time, 0.45, 6000, 0.08);
            }
            if (tickerStep % 2 === 0) {
              const acidNotes = [73.42, 87.31, 98.00, 116.54, 138.59, 146.83];
              const acidFreq = acidNotes[(tickerStep / 2) % acidNotes.length];
              const filterFreq = 800 + Math.sin(tickerStep * 0.4) * 1600;
              triggerAcid(ctx, time, acidFreq, filterFreq, 0.35, 0.14);
            }
          }
        }
      }

      // TRACK 02: SPLINTERNET // REWIRED (ZIMMER, LINKIN PARK, CODE ORANGE, SKRILLEX, DAFT PUNK)
      else if (currentTrackIdx === 1) {
        const stepInBar = tickerStep % 16;
        const barIdx = Math.floor(tickerStep / 16) % 4;

        // Act 1: Ticking Clock Zimmer x French Sweep Daft Punk (0:00 - 1:05)
        if (s < 65) {
          // Zimmer 16th Ticking
          const panVal = Math.sin(tickerStep * 0.3) * 0.6;
          triggerZimmerTick(ctx, time, panVal);

          // Daft Punk French Touch chord sweep on bar start
          if (stepInBar === 0) {
            const chord = daftPunkChords[barIdx];
            const lpfSweep = 500 + Math.sin(tickerStep * 0.1) * 2200;
            chord.forEach(f => triggerSaw(ctx, time, f, 0.18, lpfSweep, 1.8));
          }

          // Sub drone
          if (stepInBar === 0) {
            triggerSine(ctx, time, 35, 0.6, 2.0);
          }
        }

        // Act 2: Hybrid Breakbeat & Drop-D Crunch (1:05 - 2:00)
        else if (s >= 65 && s < 120) {
          // Linkin Park Breakbeat
          if (stepInBar === 0 || stepInBar === 5 || stepInBar === 8 || stepInBar === 10) {
            triggerKick(ctx, time, 150, 42, 0.9);
          }
          if (stepInBar === 4 || stepInBar === 12) {
            triggerNoise(ctx, time, 0.55, 1200, 0.08); // Snare hit
          }
          if (stepInBar === 7 || stepInBar === 15) {
            triggerNoise(ctx, time, 0.25, 2400, 0.04); // Ghost snare
          }
          if (stepInBar % 2 === 1) {
            triggerNoise(ctx, time, 0.18, 4500, 0.02);
          }

          // Industrial Drop-D riff
          if (stepInBar === 0 || stepInBar === 2 || stepInBar === 8 || stepInBar === 11) {
            const riffNotes = [65.41, 65.41, 77.78, 87.31]; // C2, C2, Eb2, F2
            triggerDropDIndustrial(ctx, time, riffNotes[stepInBar % riffNotes.length], 0.6, 0.25);
          }
        }

        // Act 3: Dropout Digital Brutalista & Clipping (2:00 - 2:50)
        else if (s >= 120 && s < 170) {
          // Code Orange Digital Dropout
          const isSilentHole = (stepInBar >= 4 && stepInBar <= 7) || (stepInBar >= 12 && stepInBar <= 14);

          if (isSilentHole) {
            // Absolute silence / 120Hz Server hum
            if (tickerStep % 8 === 0) {
              triggerSine(ctx, time, 120, 0.08, 0.5);
            }
          } else {
            // Harsh clipping bursts
            if (stepInBar === 0 || stepInBar === 8) {
              triggerSquare(ctx, time, 92.50, 0.75, 0.14); // Tritono F#
              triggerNoise(ctx, time, 0.6, 800, 0.1);
            }
            if (stepInBar === 2 || stepInBar === 10) {
              triggerSquare(ctx, time, 65.41, 0.7, 0.12);
            }
          }
        }

        // Act 4: Skrillex Surgical FM Neuro Growl (2:50 - 3:40)
        else if (s >= 170 && s < 220) {
          // 140 BPM Heavy Kick & Snare
          if (stepInBar % 8 === 0) {
            triggerKick(ctx, time, 160, 38, 1.0);
          }
          if (stepInBar % 8 === 4) {
            triggerNoise(ctx, time, 0.65, 1800, 0.08); // Snare slap
          }
          if (stepInBar % 2 === 1) {
            triggerNoise(ctx, time, 0.22, 5000, 0.02);
          }

          // FM Neuro Growl Modulations
          if (stepInBar % 2 === 0) {
            const growlCarrier = [65.41, 77.78, 92.50, 116.54][(tickerStep / 2) % 4];
            const growlFilter = 800 + Math.sin(tickerStep * 0.8) * 2800;
            triggerSkrillexFMGrowl(ctx, time, growlCarrier, 140, growlFilter, 0.85, 0.22);
          }

          // Micro-stutters
          if (stepInBar === 6 || stepInBar === 14) {
            triggerSquare(ctx, time, 523.25, 0.3, 0.04);
          }
        }

        // Act 5: Monumental Braam 35Hz & Sidechain Fade (3:40 - 4:45)
        else if (s >= 220 && s <= 285) {
          // Zimmer Braam
          if (stepInBar === 0) {
            triggerZimmerBraam(ctx, time, 35, 0.85, 2.2);
          }

          // French Touch Sidechain pump pad
          if (stepInBar % 4 === 1 || stepInBar % 4 === 2) {
            const padChords = [261.63, 311.13, 392.00];
            padChords.forEach(f => triggerTriangle(ctx, time, f, 0.2, 0.25));
          }

          // Archaeological bell decay
          if (stepInBar === 0 && barIdx % 2 === 0) {
            triggerSine(ctx, time, 1046.50, 0.25, 0.8);
          }
        }
      }

      tickerStep++;
    }, 125);

    drawWaveform();
  }

  function stopPlayback() {
    if (clockInterval) { clearInterval(clockInterval); clockInterval = null; }
    if (soundTicker) { clearInterval(soundTicker); soundTicker = null; }
    isPlaying = false;
    isPreviewingRange = false;
    playIcon.textContent = '▶';
    playLabel.textContent = 'Play';
    stopBtn.disabled = true;
    drawWaveform();
  }

  function drawWaveform() {
    if (!canvas) return;
    const width = canvas.width = canvas.clientWidth;
    const height = canvas.height = canvas.clientHeight;

    canvasCtx.fillStyle = '#101217';
    canvasCtx.fillRect(0, 0, width, height);

    if (!analyser || !isPlaying) {
      canvasCtx.strokeStyle = '#232731';
      canvasCtx.lineWidth = 1;
      canvasCtx.beginPath();
      canvasCtx.moveTo(0, height / 2);
      canvasCtx.lineTo(width, height / 2);
      canvasCtx.stroke();
      return;
    }

    const bufferLength = analyser.frequencyBinCount;
    const timeData = new Uint8Array(bufferLength);
    analyser.getByteTimeDomainData(timeData);

    canvasCtx.lineWidth = 1.6;
    canvasCtx.strokeStyle = currentTrackIdx === 1 ? '#38bdf8' : (currentMode === 'mutacion' ? '#34d399' : '#fbbf24');
    canvasCtx.beginPath();

    const sliceWidth = width / bufferLength;
    let x = 0;
    for (let i = 0; i < bufferLength; i++) {
      const v = timeData[i] / 128.0;
      const y = (v * height) / 2;
      if (i === 0) canvasCtx.moveTo(x, y);
      else canvasCtx.lineTo(x, y);
      x += sliceWidth;
    }
    canvasCtx.stroke();

    requestAnimationFrame(drawWaveform);
  }

  // Event Listeners
  trackBtn1.addEventListener('click', () => setTrack(0));
  trackBtn2.addEventListener('click', () => setTrack(1));

  playBtn.addEventListener('click', () => {
    if (isPlaying) stopPlayback();
    else startPlayback(false);
  });

  stopBtn.addEventListener('click', () => {
    stopPlayback();
    seekTo(0);
  });

  loopBtn.addEventListener('click', () => {
    isLoopingSection = !isLoopingSection;
    loopLabel.textContent = isLoopingSection ? `Loop: Sec 0${activeSectionIndex + 1}` : 'Loop: Off';
    loopBtn.classList.toggle('btn-active', isLoopingSection);
  });

  volSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    volVal.textContent = `${Math.round(val * 100)}%`;
    if (masterGain && audioCtx) {
      masterGain.gain.setValueAtTime(val, audioCtx.currentTime);
    }
  });

  tabMutacion.addEventListener('click', () => setMode('mutacion'));
  tabChallenger.addEventListener('click', () => setMode('challenger'));
  tabExp.addEventListener('click', () => setMode('exp'));

  waveformTrack.addEventListener('click', (e) => {
    const rect = waveformTrack.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const pct = Math.max(0, Math.min(1, clickX / rect.width));
    seekTo(pct * totalDuration);
  });

  // Range Slider Listeners
  rangeStartSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (val >= selectionEnd) {
      selectionStart = Math.max(0, selectionEnd - 1);
      rangeStartSlider.value = selectionStart;
    } else {
      selectionStart = val;
    }
    updateToolScrubbers();
    updateSelectionOverlay();
    generateSmartPrompt();
  });

  rangeEndSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (val <= selectionStart) {
      selectionEnd = Math.min(totalDuration, selectionStart + 1);
      rangeEndSlider.value = selectionEnd;
    } else {
      selectionEnd = val;
    }
    updateToolScrubbers();
    updateSelectionOverlay();
    generateSmartPrompt();
  });

  btnPreviewRange.addEventListener('click', () => {
    if (isPlaying && isPreviewingRange) {
      stopPlayback();
    } else {
      stopPlayback();
      startPlayback(true);
    }
  });

  directivePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const tag = pill.getAttribute('data-tag');
      if (activeDirectives.has(tag)) {
        activeDirectives.delete(tag);
        pill.classList.remove('pill-btn-active');
      } else {
        activeDirectives.add(tag);
        pill.classList.add('pill-btn-active');
      }
      generateSmartPrompt();
    });
  });

  crewPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const role = pill.getAttribute('data-role');
      if (activeCrewRoles.has(role)) {
        activeCrewRoles.delete(role);
        pill.classList.remove('pill-crew-active');
      } else {
        activeCrewRoles.add(role);
        pill.classList.add('pill-crew-active');
      }
      generateSmartPrompt();
    });
  });

  producerNoteTextarea.addEventListener('input', () => {
    generateSmartPrompt();
  });

  btnCopySmartPrompt.addEventListener('click', async () => {
    const promptText = promptPreviewCode.textContent;
    try {
      await navigator.clipboard.writeText(promptText);
      const originalText = copyPromptBtnText.textContent;
      copyPromptBtnText.textContent = '✅ ¡PROMPT COPIADO AL PORTAPAPELES!';
      btnCopySmartPrompt.classList.add('btn-success-glow');
      setTimeout(() => {
        copyPromptBtnText.textContent = originalText;
        btnCopySmartPrompt.classList.remove('btn-success-glow');
      }, 2500);
    } catch (e) {
      console.warn('Clipboard write error:', e);
    }
  });

  btnCopyRef.addEventListener('click', async () => {
    const promptText = promptPreviewCode.textContent;
    try {
      await navigator.clipboard.writeText(promptText);
      const originalText = copyRefText.textContent;
      copyRefText.textContent = '¡Copiado!';
      setTimeout(() => { copyRefText.textContent = originalText; }, 2000);
    } catch (e) {
      console.warn(e);
    }
  });

  // Init
  setTrack(0);
  drawWaveform();
</script>

