---
import Layout from '../layouts/Layout.astro';
import { SONG_SECTIONS, TRACK_VARIATIONS, SPLINTERNET_SECTIONS, SPLINTERNET_VARIATIONS, TRACKS } from '../data/tracks';

const tracksData = TRACKS;
---

<Layout
  title="RECOVERY // Studio Deck & HITL Life-Cycle Lab"
  description="Mesa de audición minimalista de producción musical, genealogía HITL (:Experimentacion, :Mutacion, :Challenger, :Victory) y herramienta de selección inteligente de prompts para Antigravity."
>
  <div class="studio-container">
    <!-- Header -->
    <header class="studio-header">
      <div class="studio-title-group">
        <h1 class="studio-title">RECOVERY</h1>
        <span class="studio-tag" id="current-track-tag">SINGLE 01 // BACKUP</span>
      </div>

      <!-- Track Switcher -->
      <div class="track-switcher">
        <button type="button" class="btn btn-sm btn-active" id="track-btn-1" data-track-index="0">
          <span class="mono font-bold">01</span>
          <span>Backup (05:15)</span>
        </button>
        <button type="button" class="btn btn-sm" id="track-btn-2" data-track-index="1">
          <span class="mono font-bold">02</span>
          <span>Splinternet // Rewired (04:45)</span>
        </button>
      </div>

      <a
        href="https://github.com/willkwolf/Recovery-album"
        target="_blank"
        rel="noopener noreferrer"
        class="studio-repo-link"
      >
        GitHub ↗
      </a>
    </header>

    <!-- Lifecycle State Bar (HITL Memory & Genealogía) -->
    <div class="lifecycle-bar">
      <div class="lifecycle-label-group">
        <span class="mono label-muted">ESTADO DE CICLO DE VIDA HITL:</span>
        <span class="mono active-track-badge" id="active-track-name">Track 01: Backup</span>
      </div>
      <div class="lifecycle-nav" id="lifecycle-nav-container">
        <!-- Rendered based on active track -->
        <button type="button" class="btn btn-sm btn-active" id="tab-mutacion" data-mode="mutacion">
          <span class="status-indicator ind-mutacion"></span>
          <span id="tab-mutacion-label">:Mutacion (Base Fork C)</span>
        </button>
        <button type="button" class="btn btn-sm" id="tab-challenger" data-mode="challenger">
          <span class="status-indicator ind-challenger"></span>
          <span id="tab-challenger-label">:Challenger (Suite Trojan 05:15)</span>
        </button>
        <button type="button" class="btn btn-sm" id="tab-exp" data-mode="exp">
          <span class="status-indicator ind-exp"></span>
          <span id="tab-exp-label">:Experimentacion (Bocetos)</span>
        </button>
      </div>
    </div>

    <!-- Transport & Master Deck -->
    <section class="deck-card">
      <div class="deck-top">
        <div class="transport-controls">
          <button type="button" class="btn btn-primary" id="btn-play" aria-label="Reproducir o pausar">
            <span id="play-icon">▶</span>
            <span id="play-label">Play</span>
          </button>
          <button type="button" class="btn" id="btn-stop" disabled aria-label="Detener">
            <span>■</span>
            <span>Stop</span>
          </button>
          <button type="button" class="btn" id="btn-loop-sec" aria-label="Alternar bucle de sección">
            <span>🔁</span>
            <span id="loop-label">Loop: Off</span>
          </button>
        </div>

        <div class="deck-meta">
          <div class="time-display mono" id="time-display">00:00 / 01:15</div>
          <div class="active-sec-badge mono" id="active-sec-badge">:Mutacion // Fork Base C</div>
        </div>

        <div class="volume-control">
          <span class="mono label-muted">VOL</span>
          <input type="range" id="vol-slider" min="0" max="1" step="0.05" value="0.8" aria-label="Volumen general" />
          <span id="vol-val" class="mono label-muted">80%</span>
        </div>
      </div>

      <!-- Scrubber & Waveform visualizer with Selection Overlay -->
      <div class="waveform-container" id="waveform-track" title="Haz clic en cualquier punto para mover el cabezal o ajustar selección">
        <canvas id="waveform-canvas" height="64"></canvas>
        <div class="selection-overlay" id="selection-overlay"></div>
        <div class="playhead" id="playhead"></div>
      </div>

      <!-- Arranger Section Strip (Challenger Suite Mode) -->
      <div class="sections-strip" id="challenger-strip" style="display: none;">
        <!-- Populated dynamically via JS according to active track -->
      </div>

      <!-- Single block strip for Mutacion mode -->
      <div class="mutation-strip" id="mutation-strip">
        <div class="mutation-info-bar">
          <span class="mono sec-num" id="mutation-badge-title">:Mutacion Aprobada</span>
          <span class="sec-name font-medium" id="mutation-badge-name">Variación C — Fork (ADN Inmutable: Polirritmia 1.75 + Disonancia F# + TR-909)</span>
          <span class="mono sec-range" id="mutation-badge-time">00:00 ── 01:15 (Loop puro)</span>
        </div>
      </div>
    </section>

    <!-- SMART SECTION SELECTION & FEEDBACK PROMPT TOOL -->
    <section class="smart-tool-card" id="smart-selection-tool">
      <div class="tool-header">
        <div class="tool-title-group">
          <div class="tool-badge-row">
            <span class="tool-badge mono">PRODUCER HITL TOOL</span>
            <span class="mono text-xs text-muted" id="tool-active-track-label">Target: Track 01 (Backup)</span>
          </div>
          <h2 class="tool-heading">Selector de Secciones & Generador de Prompt Inteligente</h2>
          <p class="tool-subheading">
            Selecciona el corte temporal, activa directivas estilísticas y copia el prompt formateado para continuar la orquestación en Antigravity.
          </p>
        </div>
        <div class="tool-header-actions">
          <button type="button" class="btn btn-sm" id="btn-preview-range" title="Reproducir sólo el rango temporal seleccionado">
            <span>▶</span>
            <span>Preescuchar Rango</span>
          </button>
          <button type="button" class="btn btn-primary btn-copy-prompt" id="btn-copy-smart-prompt" title="Copiar bloque de prompt estructurado para pegar en Antigravity">
            <span>📋</span>
            <span id="copy-prompt-btn-text">Copiar Prompt Inteligente</span>
          </button>
        </div>
      </div>

      <div class="tool-body">
        <!-- Interactive Range Scrubbers -->
        <div class="tool-range-grid">
          <div class="range-field">
            <div class="range-field-top">
              <label for="range-start-slider" class="mono label-muted">PUNTO DE ENTRADA (INICIO):</label>
              <span id="label-start-time" class="mono time-badge">00:00</span>
            </div>
            <input type="range" id="range-start-slider" min="0" max="315" value="0" step="1" class="time-range-slider" />
          </div>

          <div class="range-divider-box mono">
            <span class="label-muted">DURACIÓN</span>
            <span id="label-range-dur" class="font-bold text-accent">65s</span>
          </div>

          <div class="range-field">
            <div class="range-field-top">
              <label for="range-end-slider" class="mono label-muted">PUNTO DE SALIDA (FIN):</label>
              <span id="label-end-time" class="mono time-badge">01:05</span>
            </div>
            <input type="range" id="range-end-slider" min="0" max="315" value="65" step="1" class="time-range-slider" />
          </div>
        </div>

        <!-- Quick Section Chips -->
        <div class="tool-section-chips-row">
          <span class="mono label-muted">SALTO RÁPIDO A SECCIÓN:</span>
          <div class="section-quick-chips" id="section-quick-chips">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- Directive Style Pills (Inspirations & Directives) -->
        <div class="tool-directives-row">
          <span class="mono label-muted">DIRECTIVAS ESTILÍSTICAS // INSPIRACIONES:</span>
          <div class="directive-pills" id="directive-pills">
            <button type="button" class="pill-btn" data-tag="[+ Reloj Hans Zimmer]">⏱ Reloj Zimmer</button>
            <button type="button" class="pill-btn" data-tag="[+ Breakbeat Linkin Park]">🥁 Breakbeat Linkin Park</button>
            <button type="button" class="pill-btn" data-tag="[+ Dropout Brutal Code Orange]">⚡ Dropout Code Orange</button>
            <button type="button" class="pill-btn" data-tag="[+ Neuro Growl Skrillex]">👾 Neuro Growl Skrillex</button>
            <button type="button" class="pill-btn" data-tag="[+ French Touch Daft Punk]">🎛 French Touch Daft Punk</button>
            <button type="button" class="pill-btn" data-tag="[+ Sub-Bass 35Hz]">🔊 Sub-Bass 35Hz</button>
            <button type="button" class="pill-btn" data-tag="[+ Silencio Puro 0ms]">🔇 Silencio Puro 0ms</button>
            <button type="button" class="pill-btn" data-tag="[+ Más Disonancia F#]">⚠️ Disonancia Tritono F#</button>
            <button type="button" class="pill-btn" data-tag="[+ Acelerar BPM]">⏩ Subir Tempo / BPM</button>
            <button type="button" class="pill-btn" data-tag="[+ Reducir BPM]">⏪ Bajar Tempo / BPM</button>
            <button type="button" class="pill-btn" data-tag="[+ Mutar a Challenger]">🧬 Mutar a :Challenger</button>
          </div>
        </div>

        <!-- Target Crew Agent Routing -->
        <div class="tool-routing-row">
          <span class="mono label-muted">DESTINATARIOS AGÉNTICOS (CREW):</span>
          <div class="crew-pills" id="crew-pills">
            <button type="button" class="pill-crew pill-crew-active" data-role="DM">L1 · DM (Dirección Musical)</button>
            <button type="button" class="pill-crew pill-crew-active" data-role="CP">L2 · CP (Composición)</button>
            <button type="button" class="pill-crew pill-crew-active" data-role="SD">L2 · SD (Diseño Sonoro)</button>
            <button type="button" class="pill-crew" data-role="AE">L2 · AE (Ingeniería Audio)</button>
            <button type="button" class="pill-crew" data-role="QA">L3 · QA (Auditoría Gate)</button>
          </div>
        </div>

        <!-- Producer Note Textarea -->
        <div class="tool-note-row">
          <label for="tool-producer-note" class="mono label-muted">DIRECCIÓN TÁCTICA DEL DIRECTOR GENERAL (DG):</label>
          <textarea
            id="tool-producer-note"
            rows="2"
            class="producer-textarea mono"
            placeholder="Escribe tus observaciones para esta sección (ej: 'El solo entra tarde, quiero que el bombo tenga más pegada y que el corte glitch sea más abrupto')..."
          ></textarea>
        </div>

        <!-- Live Formatted Prompt Preview -->
        <div class="tool-prompt-preview">
          <div class="preview-header">
            <span class="mono label-muted">PROMPT ESTRUCTURADO PARA ANTIGRAVITY (VISTA PREVIA):</span>
            <span class="mono text-xs text-muted">Se sincroniza automáticamente</span>
          </div>
          <pre class="prompt-preview-block mono"><code id="prompt-preview-code">Generando prompt...</code></pre>
        </div>
      </div>
    </section>

    <!-- Section / Variation Detail Drawer (Inspection Deck) -->
    <section class="drawer-card">
      <div class="drawer-header">
        <div class="drawer-title-group">
          <span class="mono drawer-tag" id="drawer-tag">:Mutacion // BASE</span>
          <h2 class="drawer-name" id="drawer-name">Variación C — Fork (Base Original)</h2>
          <span class="mono drawer-time" id="drawer-time">00:00 ── 01:15</span>
        </div>
        <button type="button" class="btn btn-sm btn-active" id="btn-copy-ref" title="Copiar referencia al portapapeles">
          <span>📋</span>
          <span id="copy-ref-text">Copiar ref al portapapeles</span>
        </button>
      </div>

      <div class="drawer-body">
        <div class="drawer-meta-row">
          <div>
            <span class="label-muted mono">ESTADO HITL:</span>
            <span class="mono font-bold" id="drawer-lifecycle">:Mutacion</span>
          </div>
          <div>
            <span class="label-muted mono">TEMPO / TONALIDAD:</span>
            <span class="mono" id="drawer-tempo">110 BPM // C menor (F# persistente)</span>
          </div>
          <div>
            <span class="label-muted mono">ELEMENTOS CLAVE:</span>
            <span id="drawer-inst">Sawtooth Chords LFO, Fast 1.75 Melody, Roland TR-909, Rimshot 5-tuplet, 3v7 Hats</span>
          </div>
        </div>

        <p class="drawer-desc" id="drawer-desc">
          LÍNEA BASE MUTANTE APROBADA. Acordes dyad Sawtooth con filtro LFO, melodía rápida en delay ping-pong, Roland TR-909 y polirritmia hi-hat 3 contra 7.
        </p>

        <!-- Collapsible Strudel Code View -->
        <details class="code-details">
          <summary class="mono code-summary">
            <span>Ver código Strudel</span>
            <a
              id="drawer-repl-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="mono repl-link"
            >
              Abrir en Strudel REPL ↗
            </a>
          </summary>
          <pre class="code-block mono"><code id="drawer-code"></code></pre>
        </details>
      </div>
    </section>

    <!-- Footer minimal -->
    <footer class="studio-footer mono">
      <span>RECOVERY // ARTISTIC MULTI-AGENT SYSTEM</span>
      <span>Genealogía HITL: :Experimentacion → :Mutacion → :Challenger → :Victory</span>
    </footer>
  </div>
</Layout>

<script define:vars={{ tracksData }}>
  // State variables
  let currentTrackIdx = 0; // 0: Backup, 1: Splinternet
  let currentMode = 'mutacion'; // 'mutacion' | 'challenger' | 'exp'
  let isPlaying = false;
  let isLoopingSection = false;
  let isPreviewingRange = false;
  let activeSectionIndex = 0;
  let trackSeconds = 0;
  let totalDuration = 75;

  // Smart Selection Tool State
  let selectionStart = 0;
  let selectionEnd = 65;
  let activeDirectives = new Set();
  let activeCrewRoles = new Set(['DM', 'CP', 'SD']);

  // Web Audio Context & Nodes
  let audioCtx = null;
  let analyser = null;
  let masterGain = null;
  let clockInterval = null;
  let soundTicker = null;
  let delayNode = null;
  let feedbackGain = null;

  // DOM Elements
  const trackBtn1 = document.getElementById('track-btn-1');
  const trackBtn2 = document.getElementById('track-btn-2');
  const currentTrackTag = document.getElementById('current-track-tag');
  const activeTrackName = document.getElementById('active-track-name');
  const toolActiveTrackLabel = document.getElementById('tool-active-track-label');

  const tabMutacion = document.getElementById('tab-mutacion');
  const tabChallenger = document.getElementById('tab-challenger');
  const tabExp = document.getElementById('tab-exp');
  const tabMutacionLabel = document.getElementById('tab-mutacion-label');
  const tabChallengerLabel = document.getElementById('tab-challenger-label');
  const tabExpLabel = document.getElementById('tab-exp-label');

  const challengerStrip = document.getElementById('challenger-strip');
  const mutationStrip = document.getElementById('mutation-strip');
  const mutationBadgeTitle = document.getElementById('mutation-badge-title');
  const mutationBadgeName = document.getElementById('mutation-badge-name');
  const mutationBadgeTime = document.getElementById('mutation-badge-time');

  const playBtn = document.getElementById('btn-play');
  const stopBtn = document.getElementById('btn-stop');
  const playIcon = document.getElementById('play-icon');
  const playLabel = document.getElementById('play-label');
  const loopBtn = document.getElementById('btn-loop-sec');
  const loopLabel = document.getElementById('loop-label');
  const timeDisplay = document.getElementById('time-display');
  const activeSecBadge = document.getElementById('active-sec-badge');
  const volSlider = document.getElementById('vol-slider');
  const volVal = document.getElementById('vol-val');
  const waveformTrack = document.getElementById('waveform-track');
  const playhead = document.getElementById('playhead');
  const selectionOverlay = document.getElementById('selection-overlay');
  const canvas = document.getElementById('waveform-canvas');
  const canvasCtx = canvas.getContext('2d');

  // Tool Elements
  const rangeStartSlider = document.getElementById('range-start-slider');
  const rangeEndSlider = document.getElementById('range-end-slider');
  const labelStartTime = document.getElementById('label-start-time');
  const labelEndTime = document.getElementById('label-end-time');
  const labelRangeDur = document.getElementById('label-range-dur');
  const sectionQuickChips = document.getElementById('section-quick-chips');
  const directivePills = document.querySelectorAll('.pill-btn');
  const crewPills = document.querySelectorAll('.pill-crew');
  const producerNoteTextarea = document.getElementById('tool-producer-note');
  const promptPreviewCode = document.getElementById('prompt-preview-code');
  const btnCopySmartPrompt = document.getElementById('btn-copy-smart-prompt');
  const copyPromptBtnText = document.getElementById('copy-prompt-btn-text');
  const btnPreviewRange = document.getElementById('btn-preview-range');

  // Drawer Elements
  const drawerTag = document.getElementById('drawer-tag');
  const drawerName = document.getElementById('drawer-name');
  const drawerTime = document.getElementById('drawer-time');
  const drawerLifecycle = document.getElementById('drawer-lifecycle');
  const drawerTempo = document.getElementById('drawer-tempo');
  const drawerInst = document.getElementById('drawer-inst');
  const drawerDesc = document.getElementById('drawer-desc');
  const drawerCode = document.getElementById('drawer-code');
  const drawerReplLink = document.getElementById('drawer-repl-link');
  const btnCopyRef = document.getElementById('btn-copy-ref');
  const copyRefText = document.getElementById('copy-ref-text');

  function getActiveTrack() {
    return tracksData[currentTrackIdx];
  }

  function getActiveSections() {
    return getActiveTrack().sections || [];
  }

  function getActiveVariations() {
    return getActiveTrack().variations || [];
  }

  function formatTime(sec) {
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function getAudioContext() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window['webkitAudioContext'];
      audioCtx = new AudioContextClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      masterGain = audioCtx.createGain();
      masterGain.gain.setValueAtTime(parseFloat(volSlider.value), audioCtx.currentTime);
      masterGain.connect(analyser);
      analyser.connect(audioCtx.destination);

      delayNode = audioCtx.createDelay();
      delayNode.delayTime.setValueAtTime(0.333, audioCtx.currentTime);
      feedbackGain = audioCtx.createGain();
      feedbackGain.gain.setValueAtTime(0.55, audioCtx.currentTime);
      const delayFilter = audioCtx.createBiquadFilter();
      delayFilter.type = 'lowpass';
      delayFilter.frequency.setValueAtTime(2500, audioCtx.currentTime);

      delayNode.connect(feedbackGain);
      feedbackGain.connect(delayFilter);
      delayFilter.connect(delayNode);
      delayNode.connect(masterGain);
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function makeDistortionCurve(amount = 50) {
    const k = amount;
    const n_samples = 44100;
    const curve = new Float32Array(n_samples);
    const deg = Math.PI / 180;
    for (let i = 0; i < n_samples; ++i) {
      const x = (i * 2) / n_samples - 1;
      curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
    }
    return curve;
  }

  const distortionCurve = makeDistortionCurve(50);
  const heavyDistortionCurve = makeDistortionCurve(120);

  // Notes and Dyads
  const forkDyads = [
    [65.41, 98.00],   // [C2, G2]
    [77.78, 116.54],  // [Eb2, Bb2]
    [87.31, 130.81],  // [F2, C3]
    [92.50, 130.81]   // [F#2, C3]
  ];
  const forkMelodyNotes = [261.63, 311.13, 392.00, 369.99, 466.16, 587.33, 523.25];
  const santanaNotes = [587.33, 440.00, 349.23, 523.25, 392.00, 329.63, 466.16, 349.23, 293.66];
  const daftPunkChords = [
    [130.81, 155.56, 196.00, 233.08], // C minor 7
    [103.83, 130.81, 155.56, 196.00], // Ab major 7
    [87.31, 103.83, 130.81, 155.56],  // F minor 7
    [98.00, 123.47, 146.83, 174.61]   // G dominant 7
  ];

  // Synth Primitives
  function triggerKick(ctx, time, startF, endF, vol) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(startF, time);
    osc.frequency.exponentialRampToValueAtTime(endF, time + 0.15);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.18);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + 0.18);
  }

  function triggerNoise(ctx, time, vol, freq, dur) {
    const bufSize = ctx.sampleRate * dur;
    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const f = ctx.createBiquadFilter();
    f.type = 'highpass';
    f.frequency.value = freq;
    const g = ctx.createGain();
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    src.connect(f);
    f.connect(g);
    g.connect(masterGain);
    src.start(time);
    src.stop(time + dur);
  }

  function triggerSine(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerSquare(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerTriangle(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerSaw(ctx, time, freq, vol, lpf, dur) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(lpf, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerGuitar(ctx, time, freq, vol, dur) {
    const osc = ctx.createOscillator();
    const shaper = ctx.createWaveShaper();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    shaper.curve = distortionCurve;
    f.type = 'lowpass';
    f.frequency.setValueAtTime(2600, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(shaper);
    shaper.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerAcid(ctx, time, freq, fFreq, vol, dur) {
    const osc = ctx.createOscillator();
    const f = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    f.type = 'lowpass';
    f.frequency.setValueAtTime(fFreq, time);
    f.Q.value = 14;
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(f);
    f.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  // Influences Primitives (Zimmer, Linkin Park, Code Orange, Skrillex, Daft Punk)
  function triggerZimmerTick(ctx, time, panVal = 0) {
    const osc = ctx.createOscillator();
    const filter = ctx.createBiquadFilter();
    const panner = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
    const g = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(2400, time);
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(2400, time);
    filter.Q.value = 8;
    g.gain.setValueAtTime(0.25, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.02);
    osc.connect(filter);
    filter.connect(g);
    if (panner) {
      panner.pan.setValueAtTime(panVal, time);
      g.connect(panner);
      panner.connect(masterGain);
    } else {
      g.connect(masterGain);
    }
    osc.start(time);
    osc.stop(time + 0.025);
  }

  function triggerZimmerBraam(ctx, time, baseFreq = 35, vol = 0.85, dur = 2.0) {
    [baseFreq, baseFreq * 1.015, baseFreq * 2].forEach((f, i) => {
      const osc = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const g = ctx.createGain();
      osc.type = i === 2 ? 'sawtooth' : 'triangle';
      osc.frequency.setValueAtTime(f, time);
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(220, time);
      filter.Q.value = 6;
      g.gain.setValueAtTime(0.001, time);
      g.gain.linearRampToValueAtTime(vol * 0.45, time + 0.08);
      g.gain.exponentialRampToValueAtTime(0.001, time + dur);
      osc.connect(filter);
      filter.connect(g);
      g.connect(masterGain);
      osc.start(time);
      osc.stop(time + dur);
    });
  }

  function triggerDropDIndustrial(ctx, time, freq, vol = 0.7, dur = 0.28) {
    const osc = ctx.createOscillator();
    const shaper = ctx.createWaveShaper();
    const filter = ctx.createBiquadFilter();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, time);
    shaper.curve = heavyDistortionCurve;
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(3200, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(shaper);
    shaper.connect(filter);
    filter.connect(g);
    g.connect(masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  function triggerSkrillexFMGrowl(ctx, time, carrierFreq, modFreq, filterFreq, vol = 0.8, dur = 0.3) {
    const carrier = ctx.createOscillator();
    const modulator = ctx.createOscillator();
    const modGain = ctx.createGain();
    const filter = ctx.createBiquadFilter();
    const shaper = ctx.createWaveShaper();
    const g = ctx.createGain();

    carrier.type = 'sawtooth';
    carrier.frequency.setValueAtTime(carrierFreq, time);

    modulator.type = 'sine';
    modulator.frequency.setValueAtTime(modFreq, time);
    modGain.gain.setValueAtTime(carrierFreq * 2.5, time);

    modulator.connect(modGain);
    modGain.connect(carrier.frequency);

    shaper.curve = distortionCurve;
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(filterFreq, time);
    filter.Q.value = 16;

    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + dur);

    carrier.connect(shaper);
    shaper.connect(filter);
    filter.connect(g);
    g.connect(masterGain);

    carrier.start(time);
    modulator.start(time);
    carrier.stop(time + dur);
    modulator.stop(time + dur);
  }

  function triggerForkMelody(ctx, time, freq, vol = 0.38) {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + 0.22);
    osc.connect(g);
    g.connect(masterGain);
    if (delayNode) g.connect(delayNode);
    osc.start(time);
    osc.stop(time + 0.25);
  }

  function triggerForkChord(ctx, time, freq1, freq2, filterFreq, dur) {
    [freq1, freq2].forEach((freq) => {
      const osc = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const g = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(freq, time);
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(filterFreq, time);
      filter.Q.value = 5;
      g.gain.setValueAtTime(0.35, time);
      g.gain.exponentialRampToValueAtTime(0.001, time + dur);
      osc.connect(filter);
      filter.connect(g);
      g.connect(masterGain);
      osc.start(time);
      osc.stop(time + dur);
    });
  }

