---
import type { TrackVariation } from '../data/schema';

interface Props {
  trackTitle: string;
  variations: TrackVariation[];
}

const { trackTitle, variations } = Astro.props;
---

<div class="strudel-container panel" id="strudel-player">
  <div class="player-header">
    <div class="player-title-group">
      <span class="badge badge-success">MOTOR: STRUDEL ALG AUDIO</span>
      <h3 class="track-heading">{trackTitle}</h3>
    </div>
    <div class="player-status-badge" id="player-status">ESTADO: LISTO</div>
  </div>

  <div class="variation-selector" role="tablist" aria-label="Variaciones algorítmicas">
    {variations.map((v, index) => (
      <button
        type="button"
        role="tab"
        class={`variation-btn ${index === 0 ? 'active' : ''}`}
        id={`tab-${v.id}`}
        data-id={v.id}
        data-bpm={v.bpm}
        data-concept={v.concept}
        data-tension={v.tension}
        aria-selected={index === 0 ? 'true' : 'false'}
      >
        <span class="var-name">{v.name}</span>
        <span class="var-meta">{v.bpm} BPM</span>
      </button>
    ))}
  </div>

  <div class="variation-info" id="variation-info-box">
    <div class="info-row">
      <span class="info-label">Concepto:</span>
      <span class="info-val" id="current-concept">{variations[0].concept}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Eje de tensión:</span>
      <span class="info-val" id="current-tension">{variations[0].tension}</span>
    </div>
    <p class="var-desc" id="current-description">{variations[0].description}</p>
  </div>

  <div class="player-controls">
    <button type="button" class="btn btn-primary" id="btn-play">
      <span id="play-icon">▶</span> Reproducir Algoritmo
    </button>
    <button type="button" class="btn" id="btn-stop" disabled>
      ■ Detener
    </button>
    <button type="button" class="btn btn-sm" id="btn-copy-code">
      Copiar Código
    </button>
    <a
      id="btn-strudel-repl"
      href={`https://strudel.cc/#${encodeURIComponent(variations[0].code)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-sm"
    >
      Abrir en Strudel REPL ↗
    </a>
  </div>

  <div class="code-viewer">
    <div class="code-header">
      <span class="code-title">Código Algorítmico Aprobado (Strudel / Web Audio)</span>
      <span class="code-runtime">runtime: strudel 1.3.0</span>
    </div>
    <pre><code id="code-display">{variations[0].code}</code></pre>
  </div>

  <div class="audio-notice">
    <small>
      * La síntesis se ejecuta en tiempo real en tu navegador mediante el motor Web Audio. El primer clic inicializa el contexto de audio.
    </small>
  </div>
</div>

<script define:vars={{ variations }}>
  // Runtime client-side handler for Strudel playback
  let isPlaying = false;
  let strudelEngine = null;
  let activeVariation = variations[0];

  const statusEl = document.getElementById('player-status');
  const playBtn = document.getElementById('btn-play');
  const stopBtn = document.getElementById('btn-stop');
  const codeEl = document.getElementById('code-display');
  const conceptEl = document.getElementById('current-concept');
  const tensionEl = document.getElementById('current-tension');
  const descEl = document.getElementById('current-description');
  const replLink = document.getElementById('btn-strudel-repl');
  const copyBtn = document.getElementById('btn-copy-code');
  const varBtns = document.querySelectorAll('.variation-btn');

  async function loadStrudel() {
    if (strudelEngine) return strudelEngine;
    statusEl.textContent = 'ESTADO: CARGANDO MOTOR AUDIO...';
    try {
      const module = await import('https://unpkg.com/@strudel/web@1.3.0/dist/index.mjs');
      await module.initStrudel();
      strudelEngine = module;
      statusEl.textContent = 'ESTADO: MOTOR LISTO';
      return strudelEngine;
    } catch (err) {
      console.warn('Could not load Strudel from CDN, using Web Audio fallback simulation:', err);
      statusEl.textContent = 'ESTADO: AUDIO EXTERNO REPL DISPONIBLE';
      return null;
    }
  }

  async function startPlayback() {
    statusEl.textContent = 'ESTADO: INICIANDO SÍNTESIS...';
    const engine = await loadStrudel();
    if (engine && engine.evaluate) {
      try {
        engine.evaluate(activeVariation.code);
        isPlaying = true;
        statusEl.textContent = `ESTADO: REPRODUCIENDO (${activeVariation.name})`;
        playBtn.innerHTML = '⏸ Pausar';
        stopBtn.disabled = false;
      } catch (e) {
        console.error('Strudel execution error:', e);
        statusEl.textContent = 'ESTADO: ERROR DE EVALUACIÓN';
      }
    } else {
      // Fallback
      window.open(replLink.href, '_blank');
      statusEl.textContent = 'ESTADO: REPRODUCCIÓN EN STRUDEL REPL';
    }
  }

  function stopPlayback() {
    if (strudelEngine && strudelEngine.hush) {
      try {
        strudelEngine.hush();
      } catch (e) {
        console.warn(e);
      }
    }
    isPlaying = false;
    statusEl.textContent = 'ESTADO: DETENIDO';
    playBtn.innerHTML = '▶ Reproducir Algoritmo';
    stopBtn.disabled = true;
  }

  playBtn.addEventListener('click', async () => {
    if (isPlaying) {
      stopPlayback();
    } else {
      await startPlayback();
    }
  });

  stopBtn.addEventListener('click', () => {
    stopPlayback();
  });

  varBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const found = variations.find((v) => v.id === id);
      if (!found) return;

      varBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      activeVariation = found;
      conceptEl.textContent = found.concept;
      tensionEl.textContent = found.tension;
      descEl.textContent = found.description;
      codeEl.textContent = found.code;
      replLink.href = `https://strudel.cc/#${encodeURIComponent(found.code)}`;

      if (isPlaying) {
        stopPlayback();
        await startPlayback();
      }
    });
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(activeVariation.code);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = '¡Copiado!';
      setTimeout(() => {
        copyBtn.textContent = originalText;
      }, 2000);
    } catch (e) {
      console.warn('Clipboard write failed', e);
    }
  });
</script>

<style>
  .strudel-container {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .player-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .player-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .track-heading {
    font-size: 1.4rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .player-status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .variation-selector {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .variation-btn {
    flex: 1;
    min-width: 140px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    color: var(--text-muted);
    transition: all 0.15s ease;
  }

  .variation-btn:hover {
    background: var(--surface-hover);
    color: var(--text-main);
    border-color: var(--text-muted);
  }

  .variation-btn.active {
    background: var(--surface);
    border-color: var(--accent);
    color: var(--accent);
  }

  .var-name {
    font-weight: 600;
    font-size: 0.88rem;
    font-family: var(--font-mono);
  }

  .var-meta {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .variation-info {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: var(--space-md);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-md);
    font-size: 0.9rem;
  }

  .info-row {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .info-label {
    color: var(--text-muted);
    margin-right: var(--space-xs);
  }

  .info-val {
    color: var(--text-main);
  }

  .var-desc {
    margin-top: var(--space-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .code-viewer {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .code-header {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    padding: var(--space-xs) var(--space-md);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .code-viewer pre {
    margin: 0;
    border: none;
    border-radius: 0;
    max-height: 320px;
    font-size: 0.82rem;
  }

  .audio-notice {
    margin-top: var(--space-sm);
    color: var(--text-dim);
    font-family: var(--font-mono);
  }
</style>
